diff --git a/packages/api-audit-logs/__tests__/contextToken.test.ts b/packages/api-audit-logs/__tests__/contextToken.test.ts
new file mode 100644
index 00000000..a744494a
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/contextToken.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from "vitest";
+import { useHandler } from "./helpers/useHandler";
+import { AuditLogsContext } from "~/abstractions.js";
+import { AUDIT } from "~/config.js";
+import { getAuditConfig } from "~/utils/getAuditConfig.js";
+
+describe("AuditLogsContext token", () => {
+    it("should resolve to the full context, so event handlers can create audit logs", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const resolved = context.container.resolve(AuditLogsContext);
+        expect(resolved.auditLogs).toBeDefined();
+        expect(resolved.container).toBeDefined();
+
+        const log = await getAuditConfig(AUDIT.SECURITY.USER.CREATE)(
+            "User created",
+            { id: "1" },
+            "1",
+            resolved
+        );
+        expect(log).toMatchObject({ entityId: "1" });
+    });
+});
