diff --git a/packages/api-opensearch/__tests__/registryScope.test.ts b/packages/api-opensearch/__tests__/registryScope.test.ts
new file mode 100644
index 00000000..a54b96e8
--- /dev/null
+++ b/packages/api-opensearch/__tests__/registryScope.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it } from "vitest";
+import { Container } from "@webiny/di";
+import { OpenSearchQueryBuilderOperatorFeature } from "~/features/OpenSearchQueryBuilderOperator/feature.js";
+import { OpenSearchQueryBuilderOperatorRegistry } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperatorRegistry.js";
+import { OpenSearchQueryBuilderOperator } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperator.js";
+
+describe("registry scope", () => {
+    it("sees per-request operators only in that request", () => {
+        const root = new Container();
+        OpenSearchQueryBuilderOperatorFeature.register(root);
+        const a = root.createChildContainer();
+        const b = root.createChildContainer();
+        class Custom {
+            getOperator() {
+                return "custom";
+            }
+            apply() {}
+        }
+        const Impl = OpenSearchQueryBuilderOperator.createImplementation({
+            implementation: Custom as any,
+            dependencies: []
+        });
+        a.register(Impl).inSingletonScope();
+        const get = (c: Container) => c.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        expect(get(a).get("custom")).toBeDefined();
+        expect(get(b).get("custom")).toBeUndefined();
+        expect(get(root).get("custom")).toBeUndefined();
+        expect(get(b).get("eq")).toBeDefined();
+    });
+});
