diff --git a/packages/api-opensearch/__tests__/registries.test.ts b/packages/api-opensearch/__tests__/registries.test.ts
new file mode 100644
index 00000000..951b0599
--- /dev/null
+++ b/packages/api-opensearch/__tests__/registries.test.ts
@@ -0,0 +1,54 @@
+import { describe, expect, it } from "vitest";
+import { Container } from "@webiny/di";
+import { OpenSearchQueryBuilderOperatorFeature } from "~/features/OpenSearchQueryBuilderOperator/feature.js";
+import { OpenSearchQueryBuilderOperatorRegistry } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperatorRegistry.js";
+import { OpenSearchQueryBuilderOperator } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperator.js";
+import { OpenSearchIndexFeature } from "~/features/OpenSearchIndex/feature.js";
+import { OpenSearchIndexRegistry } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndexRegistry.js";
+import { OpenSearchIndex } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndex.js";
+
+class CustomOperator implements OpenSearchQueryBuilderOperator.Interface {
+    public getOperator() {
+        return "custom";
+    }
+    public apply() {}
+}
+const CustomOperatorImpl = OpenSearchQueryBuilderOperator.createImplementation({
+    implementation: CustomOperator,
+    dependencies: []
+});
+
+class CustomIndex implements OpenSearchIndex.Interface {
+    public readonly body = {};
+    public canUse() {
+        return true;
+    }
+}
+const CustomIndexImpl = OpenSearchIndex.createImplementation({
+    implementation: CustomIndex,
+    dependencies: []
+});
+
+describe("per-request registries", () => {
+    it("should isolate request-registered operators and indexes", () => {
+        const root = new Container();
+        OpenSearchQueryBuilderOperatorFeature.register(root);
+        OpenSearchIndexFeature.register(root);
+
+        const a = root.createChildContainer();
+        a.register(CustomOperatorImpl);
+        a.register(CustomIndexImpl);
+        const b = root.createChildContainer();
+
+        const opsA = a.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        expect(opsA.get("custom")).toBeDefined();
+        expect(opsA.get("eq")).toBeDefined();
+        expect(b.resolve(OpenSearchQueryBuilderOperatorRegistry).get("custom")).toBeUndefined();
+        expect(b.resolve(OpenSearchQueryBuilderOperatorRegistry).get("eq")).toBeDefined();
+        expect(root.resolve(OpenSearchQueryBuilderOperatorRegistry).get("custom")).toBeUndefined();
+
+        expect(a.resolve(OpenSearchIndexRegistry).getAll()).toHaveLength(1);
+        expect(b.resolve(OpenSearchIndexRegistry).getAll()).toHaveLength(0);
+        expect(root.resolve(OpenSearchIndexRegistry).getAll()).toHaveLength(0);
+    });
+});
