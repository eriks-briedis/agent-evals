diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..0f179aef
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,115 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { RoleAfterUpdateEvent } from "@webiny/api-core/features/security/roles/UpdateRole/events.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import type { CmsEntry, CmsModel } from "@webiny/api-headless-cms/types/index.js";
+import type { File } from "@webiny/api-file-manager/domain/file/types.js";
+import type { Role } from "@webiny/api-core/types/security.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log subscriptions", () => {
+    it("records content, file and role events and exposes them through GraphQL", async () => {
+        const { handler, invoke, identity } = useHandler();
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+
+        const model = { modelId: "article", isPrivate: false } as CmsModel;
+        const original = {
+            entryId: "entry-1",
+            id: "entry-1#0001",
+            values: { title: "Before" }
+        } as CmsEntry;
+        const entry = { ...original, values: { title: "After" } };
+        const file = { id: "file-1", name: "photo.jpg" } as File;
+        const role: Role = {
+            id: "role-1",
+            name: "Editor",
+            slug: "editor",
+            description: "",
+            permissions: [],
+            system: false,
+            createdBy: null,
+            createdOn: null
+        };
+        const updated = { ...role, name: "Senior editor" };
+
+        await publisher.publish(new EntryAfterCreateEvent({ model, entry: original, input: {} }));
+        await publisher.publish(new EntryAfterUpdateEvent({ model, original, entry, input: {} }));
+        await publisher.publish(new FileAfterCreateEvent({ file }));
+        await publisher.publish(new RoleAfterUpdateEvent({ original: role, updated, input: {} }));
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                model: { ...model, isPrivate: true },
+                entry: { ...entry, entryId: "private-entry" },
+                input: {}
+            })
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs(where: {}, sort: DESC) {
+                            data { id app entity entityId action createdBy { id } content }
+                            error { message }
+                        }
+                    }
+                }`
+            }
+        });
+        expect(response.errors).toBeUndefined();
+        expect(response.data.auditLogs.listAuditLogs.error).toBeNull();
+        const logs = response.data.auditLogs.listAuditLogs.data;
+        expect(logs).toHaveLength(4);
+        expect(logs).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY",
+                    entityId: "entry-1",
+                    action: "CREATE"
+                }),
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY_REVISION",
+                    entityId: "entry-1#0001",
+                    action: "UPDATE"
+                }),
+                expect.objectContaining({
+                    app: "FILE_MANAGER",
+                    entity: "FILE",
+                    entityId: "file-1",
+                    action: "CREATE"
+                }),
+                expect.objectContaining({
+                    app: "SECURITY",
+                    entity: "ROLE",
+                    entityId: "role-1",
+                    action: "UPDATE"
+                })
+            ])
+        );
+        expect(
+            logs.every((log: { createdBy: { id: string } }) => log.createdBy.id === identity?.id)
+        ).toBe(true);
+
+        const roleLog = logs.find((log: { entityId: string }) => log.entityId === "role-1");
+        expect(JSON.parse(roleLog.content)).toEqual({ before: role, after: updated });
+
+        const [getResponse] = await invoke({
+            body: {
+                query: `query GetAuditLog($id: ID!) {
+                    auditLogs { getAuditLog(id: $id) { data { id entityId } error { message } } }
+                }`,
+                variables: { id: roleLog.id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toEqual({
+            data: { id: roleLog.id, entityId: "role-1" },
+            error: null
+        });
+    });
+});
