@@ -0,0 +1,131 @@
+import { describe, it, expect, vi } from "vitest";
+import { Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { FolderNotAuthorizedError } from "~/domain/folder/errors.js";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+const operations = [
+    { operation: "create", taskId: CREATE_FLP_TASK_ID },
+    { operation: "update", taskId: UPDATE_FLP_TASK_ID },
+    { operation: "delete", taskId: DELETE_FLP_TASK_ID }
+] as const;
+
+describe("FLP failure logging", () => {
+    const { handler } = useHandler();
+
+    it.each(
+        operations.flatMap(operation => [
+            { ...operation, failure: "throw" as const },
+            { ...operation, failure: "result" as const }
+        ])
+    )(
+        "logs $failure when scheduling $operation without failing the folder change",
+        async ({ operation, taskId, failure }) => {
+            const { container } = await handler();
+            const create = container.resolve(CreateFolderUseCase);
+            const existing = await create.execute({
+                title: "Existing",
+                slug: "existing",
+                type: "test",
+                parentId: null
+            });
+            const error = new FolderNotAuthorizedError();
+            const trigger = vi.spyOn(container.resolve(TaskService), "trigger");
+            if (failure === "throw") {
+                trigger.mockRejectedValue(error);
+            } else {
+                trigger.mockResolvedValue(Result.fail(error));
+            }
+            const logger = container.resolve(Logger);
+            const log = vi.spyOn(logger, "error").mockImplementation(() => {});
+            container.registerInstance(Logger, logger);
+
+            let folderId = existing.value.id;
+            if (operation === "create") {
+                const result = await create.execute({
+                    title: "New",
+                    slug: "new",
+                    type: "test",
+                    parentId: null
+                });
+                expect(result.isOk()).toBe(true);
+                folderId = result.value.id;
+            } else if (operation === "update") {
+                const result = await container
+                    .resolve(UpdateFolderUseCase)
+                    .execute(folderId, { title: "Updated" });
+                expect(result.isOk()).toBe(true);
+            } else {
+                const result = await container.resolve(DeleteFolderUseCase).execute(folderId);
+                expect(result.isOk()).toBe(true);
+            }
+            expect(log).toHaveBeenCalledWith(
+                { err: error, folderId, folderType: "test", taskDefinition: taskId },
+                expect.stringContaining("Failed to schedule FLP")
+            );
+        }
+    );
+
+    it.each(operations)(
+        "logs $operation task failures and returns the original error",
+        async ({ operation, taskId }) => {
+            const { container } = await handler();
+            const created = await container.resolve(CreateFolderUseCase).execute({
+                title: "Folder",
+                slug: "folder",
+                type: "test",
+                parentId: null
+            });
+            const folder = created.value;
+            const error = new Error("storage unavailable");
+            if (operation === "create") {
+                const useCase = container.resolve(CreateFlpUseCase);
+                vi.spyOn(useCase, "execute").mockRejectedValue(error);
+                container.registerInstance(CreateFlpUseCase, useCase);
+            } else if (operation === "update") {
+                const useCase = container.resolve(UpdateFlpUseCase);
+                vi.spyOn(useCase, "execute").mockRejectedValue(error);
+                container.registerInstance(UpdateFlpUseCase, useCase);
+            } else {
+                const useCase = container.resolve(DeleteFlpUseCase);
+                vi.spyOn(useCase, "execute").mockRejectedValue(error);
+                container.registerInstance(DeleteFlpUseCase, useCase);
+            }
+            const logger = container.resolve(Logger);
+            const log = vi.spyOn(logger, "error").mockImplementation(() => {});
+            container.registerInstance(Logger, logger);
+            const definition = container
+                .resolveAll(TaskDefinition)
+                .find(item => item.id === taskId)!;
+            const task = container.resolveImplementation(definition.handler);
+            const result = await task.run({
+                input: { folder },
+                definition,
+                controller: {
+                    runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                    response: { error: (cause: unknown) => ({ status: "error", error: cause }) }
+                }
+            } as never);
+
+            expect(result).toEqual({ status: "error", error });
+            expect(log).toHaveBeenCalledWith(
+                {
+                    err: error,
+                    folderId: folder.id,
+                    folderType: folder.type,
+                    taskDefinition: taskId
+                },
+                expect.stringContaining("task failed")
+            );
+        }
+    );
+});
