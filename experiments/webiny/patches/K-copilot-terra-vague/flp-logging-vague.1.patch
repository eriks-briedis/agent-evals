+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,137 @@
+import { describe, expect, it, vi } from "vitest";
+import { Container } from "@webiny/di";
+import { Result } from "@webiny/feature/api";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/abstractions.js";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { FolderAfterCreateEvent } from "~/features/folder/CreateFolder/events.js";
+import { FolderAfterUpdateEvent } from "~/features/folder/UpdateFolder/events.js";
+import { FolderAfterDeleteEvent } from "~/features/folder/DeleteFolder/events.js";
+import { CreateFlpOnFolderCreatedHandler } from "~/features/flp/CreateFlpOnFolderCreated/CreateFlpOnFolderCreatedHandler.js";
+import { UpdateFlpOnFolderUpdatedHandler } from "~/features/flp/UpdateFlpOnFolderUpdated/UpdateFlpOnFolderUpdatedHandler.js";
+import { DeleteFlpOnFolderDeletedHandler } from "~/features/flp/DeleteFlpOnFolderDeleted/DeleteFlpOnFolderDeletedHandler.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { NotifyFolderChangeUseCase } from "~/features/folder/NotifyFolderChange/index.js";
+import { CreateFlpTask } from "~/flp/tasks/createFlp.task.js";
+import { UpdateFlpTask } from "~/flp/tasks/updateFlp.task.js";
+import { DeleteFlpTask } from "~/flp/tasks/deleteFlp.task.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+import type { Folder } from "~/folder/folder.types.js";
+
+const folder = { id: "folder-1", type: "cms:article" } as Folder;
+const cases = [
+    {
+        id: CREATE_FLP_TASK_ID,
+        handle: (container: Container) =>
+            container
+                .resolveImplementation(CreateFlpOnFolderCreatedHandler)
+                .handle(new FolderAfterCreateEvent({ folder })),
+        taskHandler: (container: Container) => {
+            const task = container.resolveImplementation(CreateFlpTask);
+            return { task, handler: container.resolveImplementation(task.handler) };
+        }
+    },
+    {
+        id: UPDATE_FLP_TASK_ID,
+        handle: (container: Container) =>
+            container
+                .resolveImplementation(UpdateFlpOnFolderUpdatedHandler)
+                .handle(new FolderAfterUpdateEvent({ folder, original: folder, input: {} })),
+        taskHandler: (container: Container) => {
+            const task = container.resolveImplementation(UpdateFlpTask);
+            return { task, handler: container.resolveImplementation(task.handler) };
+        }
+    },
+    {
+        id: DELETE_FLP_TASK_ID,
+        handle: (container: Container) =>
+            container
+                .resolveImplementation(DeleteFlpOnFolderDeletedHandler)
+                .handle(new FolderAfterDeleteEvent({ folder })),
+        taskHandler: (container: Container) => {
+            const task = container.resolveImplementation(DeleteFlpTask);
+            return { task, handler: container.resolveImplementation(task.handler) };
+        }
+    }
+];
+
+const makeContainer = () => {
+    const container = new Container();
+    const logger = {
+        trace: vi.fn(),
+        debug: vi.fn(),
+        info: vi.fn(),
+        warn: vi.fn(),
+        error: vi.fn(),
+        fatal: vi.fn(),
+        log: vi.fn()
+    };
+    container.registerInstance(Logger, logger);
+    container.registerInstance(IdentityContext, { getIdentity: () => ({ id: "user-1" }) } as never);
+    return { container, logger };
+};
+
+describe.each(cases)("FLP logging: $id", ({ id, handle, taskHandler }) => {
+    it.each(["rejected", "failed result"])(
+        "logs a %s trigger with folder context and does not fail the folder event",
+        async failure => {
+            const { container, logger } = makeContainer();
+            const error = new Error("trigger failed");
+            const trigger =
+                failure === "rejected"
+                    ? vi.fn().mockRejectedValue(error)
+                    : vi.fn().mockResolvedValue(Result.fail(error));
+            container.registerInstance(TaskService, { trigger } as never);
+
+            await expect(handle(container)).resolves.toBeUndefined();
+            expect(trigger).toHaveBeenCalledWith(
+                expect.objectContaining({
+                    definition: id,
+                    input: expect.objectContaining({ folder })
+                })
+            );
+            expect(logger.error).toHaveBeenCalledOnce();
+            expect(logger.error).toHaveBeenCalledWith(
+                { err: error, folderId: folder.id, folderType: folder.type, task: id },
+                expect.any(String)
+            );
+        }
+    );
+
+    it("does not log a successful trigger", async () => {
+        const { container, logger } = makeContainer();
+        container.registerInstance(TaskService, {
+            trigger: vi.fn().mockResolvedValue(Result.ok({}))
+        } as never);
+        await handle(container);
+        expect(logger.error).not.toHaveBeenCalled();
+    });
+
+    it("logs task execution failures and returns the original error response", async () => {
+        const { container, logger } = makeContainer();
+        const error = new Error("permission storage failed");
+        const useCase = { execute: vi.fn().mockRejectedValue(error) };
+        container.registerInstance(CreateFlpUseCase, useCase);
+        container.registerInstance(UpdateFlpUseCase, useCase);
+        container.registerInstance(DeleteFlpUseCase, useCase);
+        container.registerInstance(NotifyFolderChangeUseCase, { execute: vi.fn() } as never);
+
+        const { task, handler } = taskHandler(container);
+        const result = await handler.run({
+            input: { folder },
+            definition: task,
+            controller: {
+                runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                response: { error: (error: unknown) => ({ status: "error", error }) }
+            }
+        } as never);
+
+        expect(result).toEqual({ status: "error", error });
+        expect(logger.error).toHaveBeenCalledWith(
+            { err: error, folderId: folder.id, folderType: folder.type, task: id },
+            expect.any(String)
+        );
+    });
+});
