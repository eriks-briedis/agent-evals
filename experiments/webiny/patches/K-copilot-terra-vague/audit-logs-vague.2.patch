diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..89eaafd5
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,98 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { RoleAfterUpdateEvent } from "@webiny/api-core/features/security/roles/UpdateRole/events.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log subscriptions", () => {
+    it("records content, file and role events and exposes them through GraphQL", async () => {
+        const { handler, invoke } = useHandler();
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+
+        const entry = { id: "entry#0001", entryId: "entry", values: { title: "Original" } };
+        const updatedEntry = { ...entry, values: { title: "Updated" } };
+        const model = { modelId: "article", isPrivate: false };
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                entry,
+                model,
+                input: { values: entry.values }
+            } as EntryAfterCreateEvent["payload"])
+        );
+        await publisher.publish(
+            new EntryAfterUpdateEvent({
+                entry: updatedEntry,
+                original: entry,
+                model,
+                input: { values: updatedEntry.values }
+            } as EntryAfterUpdateEvent["payload"])
+        );
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                entry: { ...entry, entryId: "private" },
+                model: { ...model, isPrivate: true },
+                input: { values: entry.values }
+            } as EntryAfterCreateEvent["payload"])
+        );
+        await publisher.publish(
+            new FileAfterCreateEvent({
+                file: { id: "file", name: "photo.jpg" }
+            } as FileAfterCreateEvent["payload"])
+        );
+        await publisher.publish(
+            new RoleAfterUpdateEvent({
+                original: { id: "role", name: "Editor" },
+                updated: { id: "role", name: "Senior editor" },
+                input: { name: "Senior editor" }
+            } as RoleAfterUpdateEvent["payload"])
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs(where: {}) {
+                            data { id message entityId content }
+                            meta { hasMoreItems }
+                            error { message }
+                        }
+                    }
+                }`
+            }
+        });
+        expect(response.errors).toBeUndefined();
+        const list = response.data.auditLogs.listAuditLogs;
+        expect(list.error).toBeNull();
+        expect(list.data).toHaveLength(4);
+        expect(list.data).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({ message: "Entry created", entityId: "entry" }),
+                expect.objectContaining({
+                    message: "Entry revision updated",
+                    entityId: "entry#0001",
+                    content: JSON.stringify({ before: entry, after: updatedEntry })
+                }),
+                expect.objectContaining({ message: "File created", entityId: "file" }),
+                expect.objectContaining({ message: "Role updated", entityId: "role" })
+            ])
+        );
+
+        const id = list.data[0].id;
+        const [getResponse] = await invoke({
+            body: {
+                query: `query GetAuditLog($id: ID!) {
+                    auditLogs { getAuditLog(id: $id) { data { id } error { message } } }
+                }`,
+                variables: { id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toEqual({
+            data: { id },
+            error: null
+        });
+    });
+});
