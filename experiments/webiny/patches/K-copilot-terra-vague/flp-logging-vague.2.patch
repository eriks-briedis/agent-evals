--- /dev/null
+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,141 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { BaseError, Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+class DispatchError extends BaseError {
+    readonly code = "TEST_DISPATCH_ERROR";
+
+    constructor() {
+        super({ message: "Dispatch failed" });
+    }
+}
+
+const operations = [
+    { action: "create", taskId: CREATE_FLP_TASK_ID },
+    { action: "update", taskId: UPDATE_FLP_TASK_ID },
+    { action: "delete", taskId: DELETE_FLP_TASK_ID }
+] as const;
+
+describe("FLP failure logging", () => {
+    const { handler } = useHandler();
+
+    afterEach(() => vi.restoreAllMocks());
+
+    for (const { action, taskId } of operations) {
+        for (const failure of ["result", "throw"] as const) {
+            it(`logs a ${failure} dispatch failure without failing folder ${action}`, async () => {
+                const { container } = await handler();
+                const log = vi.fn();
+                container.registerInstance(Logger, {
+                    trace: vi.fn(),
+                    debug: vi.fn(),
+                    info: vi.fn(),
+                    warn: vi.fn(),
+                    error: log,
+                    fatal: vi.fn(),
+                    log: vi.fn()
+                });
+                const createFolder = container.resolve(CreateFolderUseCase);
+                const existing = await createFolder.execute({
+                    title: "Existing",
+                    slug: "existing",
+                    type: "logging",
+                    parentId: null
+                });
+                const error = new DispatchError();
+                const trigger = vi.spyOn(container.resolve(TaskService), "trigger");
+                if (failure === "result") {
+                    trigger.mockResolvedValue(Result.fail(error));
+                } else {
+                    trigger.mockRejectedValue(error);
+                }
+                let folderId = existing.value.id;
+                if (action === "create") {
+                    const result = await createFolder.execute({
+                        title: "New",
+                        slug: "new",
+                        type: "logging",
+                        parentId: null
+                    });
+                    expect(result.isOk()).toBe(true);
+                    folderId = result.value.id;
+                } else if (action === "update") {
+                    const result = await container.resolve(UpdateFolderUseCase).execute(folderId, {
+                        title: "Changed"
+                    });
+                    expect(result.isOk()).toBe(true);
+                } else {
+                    const result = await container.resolve(DeleteFolderUseCase).execute(folderId);
+                    expect(result.isOk()).toBe(true);
+                }
+                expect(log).toHaveBeenCalledWith(
+                    { err: error, taskDefinitionId: taskId, folderId, folderType: "logging" },
+                    `Failed to queue folder permission ${action === "create" ? "creation" : action === "update" ? "update" : "deletion"}.`
+                );
+            });
+        }
+
+        it(`logs a failed ${action} task and preserves its error response`, async () => {
+            const { container } = await handler();
+            const log = vi.fn();
+            container.registerInstance(Logger, {
+                trace: vi.fn(),
+                debug: vi.fn(),
+                info: vi.fn(),
+                warn: vi.fn(),
+                error: log,
+                fatal: vi.fn(),
+                log: vi.fn()
+            });
+            const created = await container.resolve(CreateFolderUseCase).execute({
+                title: "Task folder",
+                slug: "task-folder",
+                type: "logging",
+                parentId: null
+            });
+            const folder = created.value;
+            const error = new Error("FLP storage failed");
+            const execute = vi.fn().mockRejectedValue(error);
+            if (action === "create") {
+                container.registerInstance(CreateFlpUseCase, { execute });
+            } else if (action === "update") {
+                container.registerInstance(UpdateFlpUseCase, { execute });
+            } else {
+                container.registerInstance(DeleteFlpUseCase, { execute });
+            }
+            const definition = container
+                .resolveAll(TaskDefinition)
+                .find(item => item.id === taskId)!;
+            const task = container.resolveImplementation(definition.handler);
+            const result = await task.run({
+                input: { folder },
+                definition,
+                controller: {
+                    runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                    response: { error: (err: unknown) => ({ status: "error", error: err }) }
+                }
+            } as never);
+
+            expect(result).toEqual({ status: "error", error });
+            expect(log).toHaveBeenCalledWith(
+                {
+                    err: error,
+                    taskDefinitionId: taskId,
+                    folderId: folder.id,
+                    folderType: folder.type
+                },
+                `Folder permission ${action === "create" ? "creation" : action === "update" ? "update" : "deletion"} task failed.`
+            );
+        });
+    }
+});
