diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..43ec181c
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,78 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { RoleAfterCreateEvent } from "@webiny/api-core/features/security/roles/CreateRole/events.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import type { CmsEntry, CmsModel } from "@webiny/api-headless-cms/types/index.js";
+import type { File } from "@webiny/api-file-manager/domain/file/types.js";
+import type { Role } from "@webiny/api-core/features/security/roles/shared/types.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log subscriptions", () => {
+    it("records domain events and exposes them through the GraphQL list and get queries", async () => {
+        const { handler, invoke } = useHandler();
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+        const model = { isPrivate: false } as CmsModel;
+        const entry = { id: "entry#0001", entryId: "entry" } as CmsEntry;
+
+        await publisher.publish(new EntryAfterCreateEvent({ model, entry, input: {} }));
+        await publisher.publish(
+            new EntryAfterUpdateEvent({ model, entry, original: entry, input: {} })
+        );
+        await publisher.publish(
+            new EntryAfterCreateEvent({ model: { ...model, isPrivate: true }, entry, input: {} })
+        );
+        await publisher.publish(new FileAfterCreateEvent({ file: { id: "file" } as File }));
+        await publisher.publish(
+            new RoleAfterCreateEvent({
+                role: { id: "role" } as Role,
+                input: { name: "Editor", slug: "editor", description: "", permissions: [] }
+            })
+        );
+
+        const [list] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs(where: {}) {
+                            data { id message entityId }
+                            meta { hasMoreItems }
+                            error { message }
+                        }
+                    }
+                }`
+            }
+        });
+        expect(list.errors).toBeUndefined();
+        const result = list.data.auditLogs.listAuditLogs;
+        expect(result.error).toBeNull();
+        expect(result.data).toHaveLength(4);
+        expect(result.data).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({ message: "Entry created", entityId: "entry" }),
+                expect.objectContaining({
+                    message: "Entry revision updated",
+                    entityId: "entry#0001"
+                }),
+                expect.objectContaining({ message: "File created", entityId: "file" }),
+                expect.objectContaining({ message: "Role created", entityId: "role" })
+            ])
+        );
+
+        const [get] = await invoke({
+            body: {
+                query: `query GetAuditLog($id: ID!) {
+                    auditLogs { getAuditLog(id: $id) { data { id message } error { message } } }
+                }`,
+                variables: { id: result.data[0].id }
+            }
+        });
+        expect(get.errors).toBeUndefined();
+        expect(get.data.auditLogs.getAuditLog).toEqual({
+            data: { id: result.data[0].id, message: result.data[0].message },
+            error: null
+        });
+    });
+});
