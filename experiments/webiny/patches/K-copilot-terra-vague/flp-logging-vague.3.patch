+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,162 @@
+import { describe, expect, it, vi } from "vitest";
+import { BaseError, Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+class TriggerError extends BaseError {
+    readonly code = "TRIGGER_FAILED";
+    constructor() {
+        super({ message: "Task service unavailable" });
+    }
+}
+
+const controller = (aborted = false) => ({
+    runtime: { isAborted: () => aborted, isCloseToTimeout: () => false },
+    response: {
+        done: (message: string) => ({ status: "done", message }),
+        continue: (input: unknown) => ({ status: "continue", input }),
+        error: (error: unknown) => ({ status: "error", error }),
+        aborted: () => ({ status: "aborted" })
+    }
+});
+
+describe("Folder permission failure logging", () => {
+    const { handler } = useHandler();
+
+    it.each([
+        ["create", CREATE_FLP_TASK_ID],
+        ["update", UPDATE_FLP_TASK_ID],
+        ["delete", DELETE_FLP_TASK_ID]
+    ] as const)(
+        "logs rejected and failed task triggers on folder %s without failing it",
+        async (operation, taskId) => {
+            for (const failure of ["throw", "result"] as const) {
+                const context = await handler();
+                const create = context.container.resolve(CreateFolderUseCase);
+                const existing = await create.execute({
+                    title: "Existing",
+                    slug: `existing-${operation}-${failure}`,
+                    type: "logging",
+                    parentId: null
+                });
+                const logger = context.container.resolve(Logger);
+                const logError = vi.spyOn(logger, "error").mockImplementation(() => {});
+                context.container.registerInstance(Logger, logger);
+                const error = new TriggerError();
+                context.container.registerInstance(TaskService, {
+                    trigger: async () => {
+                        if (failure === "throw") {
+                            throw error;
+                        }
+                        return Result.fail(error);
+                    },
+                    abort: async () => {
+                        throw new Error("Not used");
+                    },
+                    fetchServiceInfo: async () => {
+                        throw new Error("Not used");
+                    }
+                });
+
+                let folderId = existing.value.id;
+                if (operation === "create") {
+                    const result = await context.container.resolve(CreateFolderUseCase).execute({
+                        title: "New",
+                        slug: `new-${failure}`,
+                        type: "logging",
+                        parentId: null
+                    });
+                    expect(result.isOk()).toBe(true);
+                    folderId = result.value.id;
+                } else if (operation === "update") {
+                    const result = await context.container
+                        .resolve(UpdateFolderUseCase)
+                        .execute(folderId, { title: "Changed" });
+                    expect(result.isOk()).toBe(true);
+                } else {
+                    const result = await context.container
+                        .resolve(DeleteFolderUseCase)
+                        .execute(folderId);
+                    expect(result.isOk()).toBe(true);
+                }
+                expect(logError).toHaveBeenCalledWith(
+                    { err: error, folderId, folderType: "logging", taskDefinition: taskId },
+                    expect.stringContaining("Failed to trigger folder permission")
+                );
+                logError.mockRestore();
+            }
+        }
+    );
+
+    it.each([
+        ["create", CREATE_FLP_TASK_ID],
+        ["update", UPDATE_FLP_TASK_ID],
+        ["delete", DELETE_FLP_TASK_ID]
+    ] as const)(
+        "logs %s task failures and preserves the task error response",
+        async (operation, taskId) => {
+            const context = await handler();
+            const folder = (
+                await context.container.resolve(CreateFolderUseCase).execute({
+                    title: "Task folder",
+                    slug: `task-${operation}`,
+                    type: "logging",
+                    parentId: null
+                })
+            ).value;
+            const logger = context.container.resolve(Logger);
+            const logError = vi.spyOn(logger, "error").mockImplementation(() => {});
+            const logWarn = vi.spyOn(logger, "warn").mockImplementation(() => {});
+            context.container.registerInstance(Logger, logger);
+            const error = new Error("Storage unavailable");
+            const execute = async () => {
+                throw error;
+            };
+            context.container.registerInstance(CreateFlpUseCase, { execute });
+            context.container.registerInstance(UpdateFlpUseCase, { execute });
+            context.container.registerInstance(DeleteFlpUseCase, { execute });
+
+            const definition = context.container
+                .resolveAll(TaskDefinition)
+                .find(item => item.id === taskId)!;
+            const task = context.container.resolveImplementation(definition.handler);
+            const result = await task.run({
+                input: { folder },
+                definition,
+                controller: controller()
+            } as never);
+            expect(result).toEqual({ status: "error", error });
+            expect(logError).toHaveBeenCalledWith(
+                {
+                    err: error,
+                    folderId: folder.id,
+                    folderType: folder.type,
+                    taskDefinition: taskId
+                },
+                expect.stringContaining("task failed")
+            );
+
+            const aborted = await task.run({
+                input: { folder },
+                definition,
+                controller: controller(true)
+            } as never);
+            expect(aborted).toEqual({ status: "aborted" });
+            expect(logWarn).toHaveBeenCalledWith(
+                { folderId: folder.id, folderType: folder.type, taskDefinition: taskId },
+                expect.stringContaining("task was aborted")
+            );
+            logError.mockRestore();
+            logWarn.mockRestore();
+        }
+    );
+});
