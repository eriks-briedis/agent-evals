+function isTableAlreadyExistsError(error: unknown): boolean {
+    if (typeof error !== "object" || error === null) {
+        return false;
+    }
+
+    if (!("code" in error)) {
+        return false;
+    }
+
+    if (error.code === "42P07" || error.code === "ER_TABLE_EXISTS_ERROR") {
+        return true;
+    }
+
+    if (
+        error.code === "23505" &&
+        "constraint" in error &&
+        error.constraint === "pg_type_typname_nsp_index"
+    ) {
+        return true;
+    }
+
+    return (
+        error.code === "SQLITE_ERROR" &&
+        "message" in error &&
+        typeof error.message === "string" &&
+        /table .+ already exists/i.test(error.message)
+    );
+}
