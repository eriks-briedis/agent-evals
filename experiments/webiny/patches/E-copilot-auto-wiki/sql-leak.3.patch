+import { afterEach } from "vitest";
+import { beforeEach } from "vitest";
+import { describe } from "vitest";
+import { expect } from "vitest";
+import { it } from "vitest";
+import knexLib from "knex";
+import type { Knex } from "knex";
+import { Container } from "@webiny/feature/api";
+import { ApiCoreStorageOperationsFactory } from "@webiny/api-core";
+import { ApiCoreSqlFeature } from "../src/ApiCoreSqlFeature.js";
+import { TableManager } from "../src/TableManager.js";
+
+describe("SQL storage lifecycle", () => {
+    let knex: Knex;
+    let queries: string[];
+
+    beforeEach(() => {
+        knex = knexLib({
+            client: "better-sqlite3",
+            connection: { filename: ":memory:" },
+            useNullAsDefault: true
+        });
+        queries = [];
+        knex.on("query", query => queries.push(query.sql));
+    });
+
+    afterEach(async () => {
+        await knex.destroy();
+    });
+
+    it("reuses storage operations and table verification across factory calls", async () => {
+        const container = new Container();
+        ApiCoreSqlFeature.register(container, { knex, tableNamePrefix: "first" });
+        const factory = container.resolve(ApiCoreStorageOperationsFactory);
+        const storage = factory.create();
+        const managers = globalThis as typeof globalThis & { __sqlTableManagers: unknown[] };
+        const managerCount = managers.__sqlTableManagers.length;
+
+        await Promise.all(
+            Array.from({ length: 20 }, (_, index) => {
+                const next = factory.create();
+                expect(next).toBe(storage);
+                return next.keyValueStorageOperations.set(`key${index}`, index, "scope");
+            })
+        );
+        expect(managers.__sqlTableManagers).toHaveLength(managerCount);
+        expect(queries.filter(query => query.includes("sqlite_master"))).toHaveLength(1);
+        expect(await storage.keyValueStorageOperations.get("key1", "scope")).toEqual({
+            key: "key1",
+            value: 1
+        });
+
+        const otherContainer = new Container();
+        ApiCoreSqlFeature.register(otherContainer, { knex, tableNamePrefix: "second" });
+        const other = otherContainer.resolve(ApiCoreStorageOperationsFactory).create();
+        expect(other).not.toBe(storage);
+        expect(await other.keyValueStorageOperations.get("key1", "scope")).toBeNull();
+    });
+
+    it("handles two managers racing to create the same table", async () => {
+        const first = new TableManager(knex, "shared");
+        const second = new TableManager(knex, "shared");
+        const creator = (table: Knex.CreateTableBuilder) => {
+            table.text("id").primary();
+        };
+
+        await Promise.all([first.ensure("items", creator), second.ensure("items", creator)]);
+        expect(
+            queries.filter(query => query.toLowerCase().startsWith("create table"))
+        ).toHaveLength(2);
+        expect(await knex.schema.hasTable("shared_items")).toBe(true);
+    });
+
+    it("propagates creation failures and permits a retry", async () => {
+        const manager = new TableManager(knex);
+        const failure = new Error("invalid schema");
+        const badCreator = () => {
+            throw failure;
+        };
+
+        const results = await Promise.allSettled([
+            manager.ensure("items", badCreator),
+            manager.ensure("items", badCreator)
+        ]);
+        expect(results).toEqual([
+            { status: "rejected", reason: failure },
+            { status: "rejected", reason: failure }
+        ]);
+        await manager.ensure("items", table => table.text("id"));
+        expect(await knex.schema.hasTable("items")).toBe(true);
+    });
+
+    it("does not suppress an index creation failure when the table exists", async () => {
+        await knex.schema.createTable("existing", table => {
+            table.text("id");
+            table.index("id", "duplicate_index");
+        });
+        const manager = new TableManager(knex);
+        await expect(
+            manager.ensure("items", table => {
+                table.text("id");
+                table.index("id", "duplicate_index");
+            })
+        ).rejects.toThrow(/index .* already exists/i);
+    });
+
+    it("does not cache an initialization that finishes after reset", async () => {
+        const manager = new TableManager(knex);
+        const creator = (table: Knex.CreateTableBuilder) => {
+            table.text("id");
+        };
+        const pending = manager.ensure("items", creator);
+        manager.reset();
+        await pending;
+        await knex.schema.dropTable("items");
+        await manager.ensure("items", creator);
+        expect(await knex.schema.hasTable("items")).toBe(true);
+    });
+});
