@@ -0,0 +1,177 @@
+import { beforeEach } from "vitest";
+import { describe } from "vitest";
+import { expect } from "vitest";
+import { it } from "vitest";
+import type { Container } from "@webiny/di";
+import { TestPermissions } from "@webiny/api-core-testing";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/index.js";
+import { TenantContext } from "@webiny/api-core/features/tenancy/TenantContext/index.js";
+import type { Tenant } from "@webiny/api-core/types/tenancy.js";
+import { GetModelUseCase } from "~/features/contentModel/GetModel/index.js";
+import { ListModelsUseCase } from "~/features/contentModel/ListModels/index.js";
+import { ModelCache } from "~/features/contentModel/shared/abstractions.js";
+import { ModelFactory } from "~/features/modelBuilder/index.js";
+import { CmsModelPlugin } from "~/plugins/CmsModelPlugin.js";
+import { useHandler } from "~tests/testHelpers/useHandler.js";
+
+class TestModelsImpl implements ModelFactory.Interface {
+    async execute(builder: ModelFactory.Builder) {
+        return [
+            builder
+                .public({ modelId: "allowedModel", name: "Allowed Model", group: "ungrouped" })
+                .fields(fields => ({ title: fields.text().label("Title") })),
+            builder
+                .public({ modelId: "hiddenBuilder", name: "Hidden Builder", group: "ungrouped" })
+                .fields(fields => ({ title: fields.text().label("Title") }))
+        ];
+    }
+}
+
+const TestModels = ModelFactory.createImplementation({
+    implementation: TestModelsImpl,
+    dependencies: []
+});
+
+const legacyModel = new CmsModelPlugin({
+    noValidate: true,
+    modelId: "hiddenLegacy",
+    name: "Hidden Legacy",
+    group: "ungrouped",
+    fields: []
+});
+
+const tenantModel = new CmsModelPlugin({
+    noValidate: true,
+    modelId: "otherTenantModel",
+    name: "Other Tenant Model",
+    group: "ungrouped",
+    tenant: "other",
+    fields: []
+});
+
+const otherTenant: Tenant = {
+    id: "other",
+    name: "Other",
+    description: "",
+    status: "enabled",
+    isInstalled: true,
+    settings: {} as Tenant["settings"],
+    tags: [],
+    parent: "root",
+    createdOn: new Date().toISOString(),
+    savedOn: new Date().toISOString()
+};
+
+describe("model cache authorization", () => {
+    let container: Container;
+
+    beforeEach(async () => {
+        const { handler } = useHandler({
+            permissions: [
+                { name: "cms.contentModelGroup", rwd: "r", _src: "test" },
+                { name: "cms.contentModel", rwd: "r", models: ["allowedModel"], _src: "test" }
+            ],
+            plugins: [(c: Container) => c.register(TestModels), legacyModel, tenantModel]
+        });
+        const context = await handler({ path: "/cms/manage", headers: { "x-tenant": "root" } });
+        container = context.container;
+        container.resolve(ModelCache).clear();
+    });
+
+    it("does not cache a restricted list for later system reads", async () => {
+        const list = container.resolve(ListModelsUseCase);
+        const get = container.resolve(GetModelUseCase);
+        const identity = container.resolve(IdentityContext);
+
+        const restricted = await list.execute();
+        expect(restricted.isOk()).toBe(true);
+        expect(restricted.value.map(model => model.modelId)).toContain("allowedModel");
+        expect(restricted.value.map(model => model.modelId)).not.toContain("hiddenLegacy");
+        expect(restricted.value.map(model => model.modelId)).not.toContain("hiddenBuilder");
+
+        const all = await identity.withoutAuthorization(() => list.execute());
+        expect(all.isOk()).toBe(true);
+        expect(all.value.map(model => model.modelId)).toEqual(
+            expect.arrayContaining(["allowedModel", "hiddenLegacy", "hiddenBuilder"])
+        );
+        expect(all.value.map(model => model.modelId)).not.toContain("otherTenantModel");
+        const hidden = await identity.withoutAuthorization(() => get.execute("hiddenBuilder"));
+        expect(hidden.isOk()).toBe(true);
+    });
+
+    it("does not expose system-cached models to restricted reads", async () => {
+        const list = container.resolve(ListModelsUseCase);
+        const get = container.resolve(GetModelUseCase);
+        const identity = container.resolve(IdentityContext);
+
+        const all = await identity.withoutAuthorization(() => list.execute());
+        expect(all.value.map(model => model.modelId)).toContain("hiddenLegacy");
+        expect(all.value.map(model => model.modelId)).toContain("hiddenBuilder");
+
+        const restricted = await list.execute();
+        expect(restricted.value.map(model => model.modelId)).not.toContain("hiddenLegacy");
+        expect(restricted.value.map(model => model.modelId)).not.toContain("hiddenBuilder");
+        const hidden = await get.execute("hiddenBuilder");
+        expect(hidden.isFail()).toBe(true);
+        expect(hidden.error.code).toBe("Cms/Model/NotFound");
+    });
+
+    it("does not cache a denied get for later system reads", async () => {
+        const get = container.resolve(GetModelUseCase);
+        const list = container.resolve(ListModelsUseCase);
+        const identity = container.resolve(IdentityContext);
+
+        const denied = await get.execute("hiddenLegacy");
+        expect(denied.isFail()).toBe(true);
+        expect(denied.error.code).toBe("Cms/Model/NotFound");
+
+        const all = await identity.withoutAuthorization(() => list.execute());
+        expect(all.isOk()).toBe(true);
+        expect(all.value.map(model => model.modelId)).toEqual(
+            expect.arrayContaining(["hiddenLegacy", "hiddenBuilder"])
+        );
+        const hidden = await identity.withoutAuthorization(() => get.execute("hiddenLegacy"));
+        expect(hidden.isOk()).toBe(true);
+    });
+
+    it("preserves denial for anonymous reads before and after system reads", async () => {
+        const get = container.resolve(GetModelUseCase);
+        const list = container.resolve(ListModelsUseCase);
+        const identity = container.resolve(IdentityContext);
+        container.resolve(TestPermissions).list = [];
+        identity.setIdentity(undefined);
+
+        const deniedGet = await get.execute("hiddenBuilder");
+        expect(deniedGet.isFail()).toBe(true);
+        expect(deniedGet.error.code).toBe("Cms/Model/NotFound");
+
+        const all = await identity.withoutAuthorization(() => list.execute());
+        expect(all.isOk()).toBe(true);
+        expect(all.value.map(model => model.modelId)).toEqual(
+            expect.arrayContaining(["hiddenLegacy", "hiddenBuilder"])
+        );
+
+        const deniedList = await list.execute();
+        expect(deniedList.isFail()).toBe(true);
+        expect(deniedList.error.code).toBe("Cms/Model/NotAuthorized");
+        const deniedAgain = await get.execute("hiddenBuilder");
+        expect(deniedAgain.isFail()).toBe(true);
+        expect(deniedAgain.error.code).toBe("Cms/Model/NotFound");
+    });
+
+    it("keeps code models scoped to the current tenant after a restricted read", async () => {
+        const list = container.resolve(ListModelsUseCase);
+        const identity = container.resolve(IdentityContext);
+        const tenancy = container.resolve(TenantContext);
+
+        await list.execute();
+        const other = await tenancy.withTenant(otherTenant, () => {
+            return identity.withoutAuthorization(() => list.execute());
+        });
+        expect(other.isOk()).toBe(true);
+        expect(other.value.map(model => model.modelId)).toContain("otherTenantModel");
+
+        const root = await identity.withoutAuthorization(() => list.execute());
+        expect(root.value.map(model => model.modelId)).not.toContain("otherTenantModel");
+    });
+});
