@@ -0,0 +1,163 @@
+import { describe, expect, it } from "vitest";
+import type { Container } from "@webiny/di";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/index.js";
+import { TenantContext } from "@webiny/api-core/features/tenancy/TenantContext/index.js";
+import type { Tenant } from "@webiny/api-core/types/tenancy.js";
+import { GetModelUseCase } from "~/features/contentModel/GetModel/index.js";
+import { ListModelsUseCase } from "~/features/contentModel/ListModels/index.js";
+import { ListModelsStorageOperation } from "~/features/shared/storageOperations/model/ListModelsStorageOperation.js";
+import { ModelFactory } from "~/features/modelBuilder/index.js";
+import { ModelCache } from "~/features/contentModel/shared/abstractions.js";
+import { CmsModelPlugin } from "~/plugins/CmsModelPlugin.js";
+import { useHandler } from "~tests/testHelpers/useHandler.js";
+import type { PermissionsArg } from "~tests/testHelpers/helpers.js";
+import { createIsolationModel } from "~tests/storageOperations/tenantIsolation/helpers.js";
+
+class TestModelsImpl implements ModelFactory.Interface {
+    async execute(builder: ModelFactory.Builder) {
+        return [
+            builder
+                .public({ modelId: "builderModel", name: "Builder", group: "group" })
+                .fields(fields => ({ title: fields.text().label("Title") })),
+            builder
+                .private({ modelId: "privateModel", name: "Private" })
+                .fields(fields => ({ title: fields.text().label("Title") }))
+        ];
+    }
+}
+
+const TestModels = ModelFactory.createImplementation({
+    implementation: TestModelsImpl,
+    dependencies: []
+});
+
+const legacyModel = new CmsModelPlugin({
+    modelId: "legacyModel",
+    name: "Legacy",
+    group: "group",
+    tenant: "root",
+    noValidate: true,
+    fields: []
+});
+
+const subTenant: Tenant = {
+    id: "sub-tenant",
+    name: "Sub Tenant",
+    description: "",
+    status: "enabled",
+    isInstalled: true,
+    settings: {} as Tenant["settings"],
+    tags: [],
+    parent: "root",
+    createdOn: new Date().toISOString(),
+    savedOn: new Date().toISOString()
+};
+
+describe("model cache authorization", () => {
+    const setup = async (permissions: PermissionsArg[]) => {
+        const { handler } = useHandler({
+            permissions,
+            plugins: [
+                legacyModel,
+                (container: Container) => {
+                    container.register(TestModels);
+                    container.registerInstance(ListModelsStorageOperation, {
+                        execute: async ({ where }) => [createIsolationModel(where.tenant)]
+                    });
+                }
+            ]
+        });
+        const context = await handler({ path: "/cms/manage", headers: { "x-tenant": "root" } });
+        const container: Container = context.container;
+        container.resolve(ModelCache).clear();
+        return container;
+    };
+
+    it("does not cache anonymous visibility when a private model is read first", async () => {
+        const container = await setup([]);
+        const getModel = container.resolve(GetModelUseCase);
+        const listModels = container.resolve(ListModelsUseCase);
+        const identity = container.resolve(IdentityContext);
+        identity.setIdentity(undefined);
+
+        expect((await getModel.execute("privateModel")).isOk()).toBe(true);
+        const denied = await listModels.execute();
+        expect(denied.error.code).toBe("Cms/Model/NotAuthorized");
+
+        const all = await identity.withoutAuthorization(() => listModels.execute());
+        expect(all.isOk()).toBe(true);
+        expect(all.value.map(model => model.modelId)).toEqual(
+            expect.arrayContaining([
+                "builderModel",
+                "legacyModel",
+                "privateModel",
+                "isolationModel"
+            ])
+        );
+        const legacy = await identity.withoutAuthorization(() => getModel.execute("legacyModel"));
+        expect(legacy.isOk()).toBe(true);
+
+        const deniedModel = await getModel.execute("legacyModel");
+        expect(deniedModel.error.code).toBe("Cms/Model/NotFound");
+        expect((await listModels.execute()).error.code).toBe("Cms/Model/NotAuthorized");
+    });
+
+    it.each(["restricted", "system"])(
+        "preserves restricted reads with %s access first and isolates tenants",
+        async first => {
+            const container = await setup([
+                { name: "cms.contentModelGroup" },
+                { name: "cms.contentModel", rwd: "r", models: ["builderModel"] }
+            ]);
+            const getModel = container.resolve(GetModelUseCase);
+            const listModels = container.resolve(ListModelsUseCase);
+            const identity = container.resolve(IdentityContext);
+            const systemList = () => identity.withoutAuthorization(() => listModels.execute());
+
+            if (first === "restricted") {
+                expect((await listModels.execute()).isOk()).toBe(true);
+            } else {
+                expect((await systemList()).isOk()).toBe(true);
+            }
+
+            const restricted = await listModels.execute();
+            expect(restricted.isOk()).toBe(true);
+            expect(restricted.value.map(model => model.modelId)).toEqual(
+                expect.arrayContaining(["builderModel", "privateModel"])
+            );
+            expect(restricted.value.map(model => model.modelId)).not.toContain("legacyModel");
+            expect(restricted.value.map(model => model.modelId)).not.toContain("isolationModel");
+            expect((await getModel.execute("legacyModel")).error.code).toBe("Cms/Model/NotFound");
+            expect((await getModel.execute("isolationModel")).error.code).toBe(
+                "Cms/Model/NotAuthorized"
+            );
+
+            const all = await systemList();
+            expect(all.value.map(model => model.modelId)).toEqual(
+                expect.arrayContaining([
+                    "builderModel",
+                    "legacyModel",
+                    "privateModel",
+                    "isolationModel"
+                ])
+            );
+            const noPlugins = await identity.withoutAuthorization(() =>
+                listModels.execute({ includePlugins: false })
+            );
+            expect(noPlugins.value.map(model => model.modelId)).toContain("isolationModel");
+            expect(noPlugins.value.map(model => model.modelId)).not.toContain("builderModel");
+            const noPrivate = await identity.withoutAuthorization(() =>
+                listModels.execute({ includePrivate: false })
+            );
+            expect(noPrivate.value.map(model => model.modelId)).not.toContain("privateModel");
+
+            await container.resolve(TenantContext).withTenant(subTenant, async () => {
+                const models = await systemList();
+                expect(models.value.every(model => model.tenant === subTenant.id)).toBe(true);
+                expect(models.value.map(model => model.modelId)).toContain("builderModel");
+                expect(models.value.map(model => model.modelId)).toContain("isolationModel");
+                expect(models.value.map(model => model.modelId)).not.toContain("legacyModel");
+            });
+        }
+    );
+});
