+++ b/packages/api-audit-logs/__tests__/eventSubscriptions.test.ts
@@ -0,0 +1,167 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { RoleAfterCreateEvent } from "@webiny/api-core/features/security/roles/CreateRole/events.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import type { CmsEntry } from "@webiny/api-headless-cms/types/index.js";
+import type { CmsModel } from "@webiny/api-headless-cms/types/index.js";
+import type { File } from "@webiny/api-file-manager/domain/file/types.js";
+import type { Role } from "@webiny/api-core/types/security.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log event subscriptions", () => {
+    it("writes logs for CMS, file manager and security events and exposes them through GraphQL", async () => {
+        const identity = { id: "id-12345678", type: "admin", displayName: "John Doe" };
+        const { handler, invoke } = useHandler({ identity });
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+        const date = "2026-07-15T00:00:00.000Z";
+        const model: CmsModel = {
+            name: "Article",
+            modelId: "article",
+            singularApiName: "Article",
+            pluralApiName: "Articles",
+            tenant: "root",
+            group: "content",
+            icon: null,
+            description: null,
+            fields: [],
+            layout: [],
+            titleFieldId: "title"
+        };
+        const entry: CmsEntry = {
+            tenant: "root",
+            entryId: "entry-1",
+            id: "entry-1#0001",
+            modelId: model.modelId,
+            version: 1,
+            locked: false,
+            status: "draft",
+            values: { title: "Original" },
+            createdOn: date,
+            savedOn: date,
+            modifiedOn: null,
+            deletedOn: null,
+            restoredOn: null,
+            firstPublishedOn: null,
+            lastPublishedOn: null,
+            createdBy: identity,
+            savedBy: identity,
+            modifiedBy: null,
+            deletedBy: null,
+            restoredBy: null,
+            firstPublishedBy: null,
+            lastPublishedBy: null,
+            revisionCreatedOn: date,
+            revisionSavedOn: date,
+            revisionModifiedOn: null,
+            revisionDeletedOn: null,
+            revisionRestoredOn: null,
+            revisionFirstPublishedOn: null,
+            revisionLastPublishedOn: null,
+            revisionCreatedBy: identity,
+            revisionSavedBy: identity,
+            revisionModifiedBy: null,
+            revisionDeletedBy: null,
+            revisionRestoredBy: null,
+            revisionFirstPublishedBy: null,
+            revisionLastPublishedBy: null,
+            live: null,
+            revisionDescription: undefined,
+            expiresAt: null
+        };
+        const updatedEntry: CmsEntry = { ...entry, values: { title: "Updated" } };
+        const file: File = {
+            id: "file-1",
+            key: "file-1",
+            size: 1,
+            type: "text/plain",
+            name: "file.txt",
+            metadata: {},
+            location: { folderId: "root" },
+            tags: [],
+            description: "",
+            createdOn: date,
+            modifiedOn: undefined,
+            savedOn: date,
+            createdBy: identity,
+            modifiedBy: undefined,
+            savedBy: identity
+        };
+        const role: Role = {
+            id: "role-1",
+            name: "Editor",
+            slug: "editor",
+            description: "",
+            system: false,
+            permissions: [],
+            createdOn: date,
+            createdBy: identity
+        };
+
+        await publisher.publish(
+            new EntryAfterCreateEvent({ model, entry, input: { values: entry.values } })
+        );
+        await publisher.publish(
+            new EntryAfterUpdateEvent({
+                model,
+                entry: updatedEntry,
+                original: entry,
+                input: { values: updatedEntry.values }
+            })
+        );
+        await publisher.publish(new FileAfterCreateEvent({ file }));
+        await publisher.publish(new RoleAfterCreateEvent({ role, input: role }));
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                model: { ...model, isPrivate: true },
+                entry,
+                input: { values: entry.values }
+            })
+        );
+
+        const result = await context.auditLogs.listAuditLogs({});
+        expect(result.items).toHaveLength(4);
+        expect(result.items).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({ message: "Entry created", entityId: entry.entryId }),
+                expect.objectContaining({
+                    message: "Entry revision updated",
+                    entityId: entry.id,
+                    content: JSON.stringify({ before: entry, after: updatedEntry })
+                }),
+                expect.objectContaining({ message: "File created", entityId: file.id }),
+                expect.objectContaining({ message: "Role created", entityId: role.id })
+            ])
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs(where: {}) { data { id message entityId } error { message } }
+                    }
+                }`
+            }
+        });
+        expect(response.errors).toBeUndefined();
+        expect(response.data.auditLogs.listAuditLogs.error).toBeNull();
+        expect(response.data.auditLogs.listAuditLogs.data).toHaveLength(4);
+
+        const id = result.items![0].id;
+        const [getResponse] = await invoke({
+            body: {
+                query: `query GetAuditLog($id: ID!) {
+                    auditLogs { getAuditLog(id: $id) { data { id } error { message } } }
+                }`,
+                variables: { id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toEqual({
+            data: { id },
+            error: null
+        });
+    });
+});
