+                rootValue: {
+                    switched: async () => {
+                        if (method === "withRootTenant") {
+                            return tenantContext.withRootTenant(switched);
+                        }
+                        if (method === "withEachTenant") {
+                            const values = await tenantContext.withEachTenant(
+                                [switchedTenant],
+                                switched
+                            );
+                            return values[0];
+                        }
+                        return tenantContext.withTenant(switchedTenant, switched);
+                    },
+                    sibling: async () => {
+                        await callbackEntered;
+                        const tenant = tenantContext.getTenant().id;
+                        release();
+                        return tenant;
+                    }
+                }
+            });
+
+            expect(result.errors).toBeUndefined();
+            expect(result.data).toEqual({
+                switched: method === "withRootTenant" ? "root" : "switched",
+                sibling: "request"
+            });
+            expect(tenantContext.getTenant()).toBe(requestTenant);
+        }
+    );
+
+    it("keeps overlapping and nested switches independent, including after errors", async () => {
+        const a = createTenant("a", "root");
+        const b = createTenant("b", "root");
+        const c = createTenant("c", "root");
+        let release!: () => void;
