+            release = resolve;
+        });
+
+        const first = tenantContext.withTenant(a, async () => {
+            await wait;
+            expect(tenantContext.getTenant()).toBe(a);
+            await expect(
+                tenantContext.withTenant(c, async () => {
+                    await Promise.resolve();
+                    expect(tenantContext.getTenant()).toBe(c);
+                    throw new Error("nested failure");
+                })
+            ).rejects.toThrow("nested failure");
+            expect(tenantContext.getTenant()).toBe(a);
+        });
+        const second = tenantContext.withTenant(b, async () => {
+            expect(tenantContext.getTenant()).toBe(b);
+            release();
+            await Promise.resolve();
+            expect(tenantContext.getTenant()).toBe(b);
+        });
+
+        await Promise.all([first, second]);
+        expect(tenantContext.getTenant().id).toBe("root");
+    });
+
+    it("does not restore a stale request tenant when the request tenant changes concurrently", async () => {
+        const scopedTenant = createTenant("scoped", "root");
+        const newTenant = createTenant("new", "root");
+        let release!: () => void;
+        const wait = new Promise<void>(resolve => {
+            release = resolve;
+        });
+        const operation = tenantContext.withTenant(scopedTenant, async () => {
+            await wait;
+            expect(tenantContext.getTenant()).toBe(scopedTenant);
+        });
+
+        tenantContext.setTenant(newTenant);
+        release();
+        await operation;
+        expect(tenantContext.getTenant()).toBe(newTenant);
+    });
+
+    it("runs each tenant sequentially and preserves the outer scope on failure", async () => {
+        const outer = createTenant("outer", "root");
+        const tenants = [createTenant("a", "root"), createTenant("b", "root")];
+        const visited: string[] = [];
+
+        await tenantContext.withTenant(outer, async () => {
+            await expect(
+                tenantContext.withEachTenant(tenants, async tenant => {
+                    await Promise.resolve();
+                    expect(tenantContext.getTenant()).toBe(tenant);
+                    visited.push(tenant.id);
+                    if (tenant.id === "b") {
+                        throw new Error("iteration failure");
+                    }
+                })
+            ).rejects.toThrow("iteration failure");
+            expect(tenantContext.getTenant()).toBe(outer);
+        });
+        expect(visited).toEqual(["a", "b"]);
+        expect(tenantContext.getTenant().id).toBe("root");
+    });
+
+    it.each(["withTenant", "withRootTenant", "withEachTenant"] as const)(
+        "rejects setTenant inside %s without changing the request tenant",
+        async method => {
+            const tenant = createTenant("sub", "root");
+            const attempt = async () => {
+                await Promise.resolve();
+                expect(() => tenantContext.setTenant(tenant)).toThrow(
+                    "Cannot call setTenant inside a tenant-scoped callback."
+                );
+                return tenantContext.getTenant().id;
+            };
+
+            if (method === "withRootTenant") {
+                expect(await tenantContext.withRootTenant(attempt)).toBe("root");
+            } else if (method === "withEachTenant") {
+                expect(await tenantContext.withEachTenant([tenant], attempt)).toEqual(["sub"]);
+            } else {
+                expect(await tenantContext.withTenant(tenant, attempt)).toBe("sub");
+            }
+            expect(tenantContext.getTenant().id).toBe("root");
+        }
+    );
+
+    it("does not share overrides between tenant context instances", async () => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        const otherContext = container.resolve(TenantContext);
+        const otherTenant = createTenant("other", "root");
+        otherContext.setTenant(otherTenant);
+
+        await tenantContext.withTenant(createTenant("sub", "root"), async () => {
+            expect(otherContext.getTenant()).toBe(otherTenant);
+            otherContext.setTenant(createTenant("changed", "root"));
+            expect(tenantContext.getTenant().id).toBe("sub");
+        });
+        expect(otherContext.getTenant().id).toBe("changed");
+    });
+
+    it("rejects disabled tenants in temporary switches", async () => {
+        const disabled = { ...createTenant("disabled", "root"), status: "disabled" as const };
+        const callback = async () => "called";
+        await expect(tenantContext.withTenant(disabled, callback)).rejects.toThrow(
+            "Tenant is disabled!"
+        );
+        await expect(tenantContext.withEachTenant([disabled], callback)).rejects.toThrow(
+            "Tenant is disabled!"
+        );
+        expect(tenantContext.getTenant().id).toBe("root");
+    });
 });
 
