         expect(tenantContext.getTenant().id).toBe("root");
     });
+
+    it.each(["withTenant", "withRootTenant", "withEachTenant"] as const)(
+        "isolates %s from a sibling GraphQL resolver",
+        async method => {
+            const requestTenant = createTenant("request", "root");
+            const switchedTenant = createTenant("switched", "root");
+            tenantContext.setTenant(requestTenant);
+
+            let entered!: () => void;
+            let release!: () => void;
+            const callbackEntered = new Promise<void>(resolve => {
+                entered = resolve;
+            });
+            const siblingRead = new Promise<void>(resolve => {
+                release = resolve;
+            });
+            const switched = async () => {
+                entered();
+                await siblingRead;
+                return tenantContext.getTenant().id;
+            };
+            const schema = buildSchema("type Query { switched: String! sibling: String! }");
+            const result = await graphql({
