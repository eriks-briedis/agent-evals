+import { describe } from "vitest";
+import { it } from "vitest";
+import { expect } from "vitest";
+import { vi } from "vitest";
+import { Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { FolderPersistenceError } from "~/domain/folder/errors.js";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { GetFolderRepository } from "~/features/folder/GetFolder/abstractions.js";
+import { CREATE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+import { UPDATE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+import { DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+describe("FLP task trigger logging", () => {
+    const { handler } = useHandler();
+
+    it.each([
+        ["create", CREATE_FLP_TASK_ID],
+        ["update", UPDATE_FLP_TASK_ID],
+        ["delete", DELETE_FLP_TASK_ID]
+    ] as const)(
+        "%s logs trigger failures without failing the folder change",
+        async (operation, definition) => {
+            for (const failure of ["result", "throw"] as const) {
+                const context = await handler();
+                const container = context.container;
+                const createFolder = container.resolve(CreateFolderUseCase);
+                let folderId = "";
+
+                if (operation !== "create") {
+                    const seed = await createFolder.execute({
+                        title: "Seed",
+                        slug: `trigger-${operation}-${failure}`,
+                        type: "type",
+                        parentId: null
+                    });
+                    expect(seed.isOk()).toBe(true);
+                    folderId = seed.value.id;
+                }
+
+                const logger = container.resolve(Logger);
+                const logError = vi.spyOn(logger, "error").mockImplementation(() => {});
+                container.registerInstance(Logger, logger);
+                const tasks = container.resolve(TaskService);
+                const trigger = vi.spyOn(tasks, "trigger");
+                const error = new FolderPersistenceError(new Error("Trigger failed"));
+                if (failure === "result") {
+                    trigger.mockResolvedValue(Result.fail(error));
+                } else {
+                    trigger.mockRejectedValue(error);
+                }
+
+                if (operation === "create") {
+                    const result = await createFolder.execute({
+                        title: "Created",
+                        slug: `trigger-create-${failure}`,
+                        type: "type",
+                        parentId: null
+                    });
+                    expect(result.isOk()).toBe(true);
+                    folderId = result.value.id;
+                } else if (operation === "update") {
+                    const result = await container.resolve(UpdateFolderUseCase).execute(folderId, {
+                        title: "Updated"
+                    });
+                    expect(result.isOk()).toBe(true);
+                } else {
+                    const result = await container.resolve(DeleteFolderUseCase).execute(folderId);
+                    expect(result.isOk()).toBe(true);
+                }
+
+                const stored = await container.resolve(GetFolderRepository).execute(folderId);
+                if (operation === "delete") {
+                    expect(stored.isFail()).toBe(true);
+                } else {
+                    expect(stored.isOk()).toBe(true);
+                    expect(stored.value.title).toBe(operation === "create" ? "Created" : "Updated");
+                }
+
+                const input: { folder: { id: string }; notifyIdentityId?: string } = {
+                    folder: expect.objectContaining({ id: folderId })
+                };
+                if (operation !== "delete") {
+                    input.notifyIdentityId = container.resolve(IdentityContext).getIdentity()?.id;
+                }
+                expect(trigger).toHaveBeenCalledOnce();
+                expect(trigger).toHaveBeenCalledWith({ definition, input });
+                expect(logError).toHaveBeenCalledOnce();
+                expect(logError).toHaveBeenCalledWith(
+                    { err: error, folderId },
+                    `Failed to trigger ${operation} FLP task.`
+                );
+            }
+        }
+    );
+
+    it("does not log an error when the task is triggered successfully", async () => {
+        const context = await handler();
+        const logger = context.container.resolve(Logger);
+        const logError = vi.spyOn(logger, "error").mockImplementation(() => {});
+        context.container.registerInstance(Logger, logger);
+
+        const result = await context.container.resolve(CreateFolderUseCase).execute({
+            title: "Success",
+            slug: "trigger-success",
+            type: "type",
+            parentId: null
+        });
+
+        expect(result.isOk()).toBe(true);
+        expect(logError).not.toHaveBeenCalled();
+    });
+});
