 export interface ITenantContext {
+    /** Sets the request tenant. Not allowed inside a withTenant, withRootTenant, or withEachTenant callback. */
     setTenant(tenant: Tenant): void;
     getTenant(): Tenant;
+    /** Runs the callback with a tenant override local to its asynchronous execution. */
     withRootTenant<T>(cb: () => T): Promise<T>;
+    /** Runs callbacks sequentially, each with a tenant override local to its asynchronous execution. */
     withEachTenant<TReturn>(
         tenants: Tenant[],
