diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..676bd50c
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,127 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { CreateRoleUseCase } from "@webiny/api-core/features/security/roles/CreateRole/index.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { HeadlessCms } from "@webiny/api-headless-cms/features/shared/abstractions.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log subscriptions", () => {
+    it("records CMS, file and security actions and exposes them through GraphQL", async () => {
+        const { handler, invoke, identity } = useHandler();
+        const context = await handler();
+        const cms = context.container.resolve(HeadlessCms);
+        const group = await cms.createGroup({
+            name: "Articles",
+            description: "Articles",
+            id: "articles",
+            icon: { type: "icon", name: "icon", value: "icon" }
+        });
+        const model = await cms.createModel({
+            modelId: "article",
+            name: "Article",
+            singularApiName: "Article",
+            pluralApiName: "Articles",
+            group: group.id,
+            fields: [],
+            layout: []
+        });
+        const entry = await cms.createEntry(model, { values: {} });
+        await cms.updateEntry(model, entry.id, { values: {} });
+
+        const roleResult = await context.container.resolve(CreateRoleUseCase).execute({
+            name: "Editor",
+            slug: "editor",
+            description: "",
+            permissions: []
+        });
+        expect(roleResult.isOk()).toBe(true);
+
+        const now = new Date().toISOString();
+        const file = {
+            id: "file-1",
+            key: "file-1",
+            name: "file.txt",
+            size: 12,
+            type: "text/plain",
+            metadata: {},
+            location: { folderId: "root" },
+            tags: [],
+            description: "",
+            createdOn: now,
+            modifiedOn: undefined,
+            savedOn: now,
+            createdBy: identity!,
+            modifiedBy: undefined,
+            savedBy: identity!
+        };
+        await context.container.resolve(EventPublisher).publish(new FileAfterCreateEvent({ file }));
+
+        const result = await context.auditLogs.listAuditLogs({});
+        expect(result.items).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY",
+                    action: "CREATE",
+                    entityId: entry.entryId
+                }),
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY_REVISION",
+                    action: "UPDATE",
+                    entityId: entry.id
+                }),
+                expect.objectContaining({
+                    app: "FILE_MANAGER",
+                    entity: "FILE",
+                    action: "CREATE",
+                    entityId: file.id
+                }),
+                expect.objectContaining({
+                    app: "SECURITY",
+                    entity: "ROLE",
+                    action: "CREATE",
+                    entityId: roleResult.value.id
+                })
+            ])
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs(where: { entityId: "file-1" }) {
+                            data { id entityId }
+                            error { message }
+                        }
+                    }
+                }`
+            }
+        });
+        expect(response.errors).toBeUndefined();
+        expect(response.data.auditLogs.listAuditLogs).toMatchObject({
+            data: [{ id: expect.any(String), entityId: "file-1" }],
+            error: null
+        });
+
+        const id = response.data.auditLogs.listAuditLogs.data[0].id;
+        const [getResponse] = await invoke({
+            body: {
+                query: `query GetAuditLog($id: ID!) {
+                    auditLogs {
+                        getAuditLog(id: $id) {
+                            data { id entityId }
+                            error { message }
+                        }
+                    }
+                }`,
+                variables: { id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toMatchObject({
+            data: { id, entityId: "file-1" },
+            error: null
+        });
+    });
+});
