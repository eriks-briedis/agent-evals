+
+describe("FLP task trigger failures", () => {
+    const { handler } = useHandler();
+
+    it.each(["create", "update", "delete"] as const)(
+        "logs a failed Result and preserves the %s folder change",
+        async operation => {
+            const context = await handler();
+            const logError = vi
+                .spyOn(LoggerImpl.prototype, "error")
+                .mockImplementation(() => undefined);
+            let folderId = "";
+            if (operation !== "create") {
+                const created = await context.container.resolve(CreateFolderUseCase).execute({
+                    type,
+                    title: `trigger-failure-${operation}`,
+                    slug: `trigger-failure-${operation}`,
+                    parentId: null
+                });
+                folderId = created.value.id;
+            }
+
+            const tasks = context.container.resolve(TaskService);
+            const trigger = vi.spyOn(tasks, "trigger");
+            trigger.mockImplementation(async () => Result.fail(new FlpTaskTriggerError()));
+
+            if (operation === "create") {
+                const result = await context.container.resolve(CreateFolderUseCase).execute({
+                    type,
+                    title: "trigger-failure-create",
+                    slug: "trigger-failure-create",
+                    parentId: null
+                });
+                expect(result.isOk()).toBe(true);
+                folderId = result.value.id;
+            } else if (operation === "update") {
+                const result = await context.container
+                    .resolve(UpdateFolderUseCase)
+                    .execute(folderId, { title: "trigger-failure-updated" });
+                expect(result.isOk()).toBe(true);
+            } else {
+                const result = await context.container
+                    .resolve(DeleteFolderUseCase)
+                    .execute(folderId);
+                expect(result.isOk()).toBe(true);
+            }
+
+            expect(trigger).toHaveBeenCalledTimes(1);
+            expect(logError).toHaveBeenCalledWith(
+                {
+                    folderId,
+                    error: expect.any(FlpTaskTriggerError),
+                    errorMessage: "Task trigger Result failed"
+                },
+                "Failed to trigger FLP task"
+            );
+        }
+    );
+
+    it.each(["create", "update", "delete"] as const)(
+        "logs a thrown error and preserves the %s folder change",
+        async operation => {
+            const context = await handler();
+            const logError = vi
+                .spyOn(LoggerImpl.prototype, "error")
+                .mockImplementation(() => undefined);
+            let folderId = "";
+            if (operation !== "create") {
+                const created = await context.container.resolve(CreateFolderUseCase).execute({
+                    type,
+                    title: `trigger-throw-${operation}`,
+                    slug: `trigger-throw-${operation}`,
+                    parentId: null
+                });
+                folderId = created.value.id;
+            }
+
+            const tasks = context.container.resolve(TaskService);
+            const trigger = vi.spyOn(tasks, "trigger");
+            const triggerError = new Error("Task service unavailable");
+            trigger.mockRejectedValue(triggerError);
+
+            if (operation === "create") {
+                const result = await context.container.resolve(CreateFolderUseCase).execute({
+                    type,
+                    title: "trigger-throw-create",
+                    slug: "trigger-throw-create",
+                    parentId: null
+                });
+                expect(result.isOk()).toBe(true);
+                folderId = result.value.id;
+            } else if (operation === "update") {
+                const result = await context.container
+                    .resolve(UpdateFolderUseCase)
+                    .execute(folderId, { title: "trigger-throw-updated" });
+                expect(result.isOk()).toBe(true);
+            } else {
+                const result = await context.container
+                    .resolve(DeleteFolderUseCase)
+                    .execute(folderId);
+                expect(result.isOk()).toBe(true);
+            }
+
+            expect(trigger).toHaveBeenCalledTimes(1);
+            expect(logError).toHaveBeenCalledWith(
+                {
+                    folderId,
+                    error: triggerError,
+                    errorMessage: "Task service unavailable"
+                },
+                "Failed to trigger FLP task"
+            );
+        }
+    );
+});
