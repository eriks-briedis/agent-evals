+/*
+ * GraphQL resolves sibling fields concurrently. A field that switches to the parent tenant (to load
+ * the identity's profile or permissions) must not change the tenant other fields see meanwhile.
+ */
+describe("TenantContext with concurrent work", () => {
+    let tenantContext: TenantContext.Interface;
+    const tick = () => new Promise(resolve => setTimeout(resolve, 5));
+
+    beforeEach(() => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        tenantContext = container.resolve(TenantContext);
+        tenantContext.setTenant(createTenant("sub", "root"));
+    });
+
+    it("withTenant does not leak into work running alongside it", async () => {
+        const seen: string[] = [];
+        const switched = tenantContext.withTenant(createTenant("root", null), async () => {
+            await tick();
+            await tick();
+            return tenantContext.getTenant().id;
+        });
+        const sibling = (async () => {
+            seen.push(tenantContext.getTenant().id);
+            await tick();
+            seen.push(tenantContext.getTenant().id);
+            await tick();
+            seen.push(tenantContext.getTenant().id);
+        })();
+
+        const [switchedTenant] = await Promise.all([switched, sibling]);
+
+        expect(switchedTenant).toBe("root");
+        expect(seen).toEqual(["sub", "sub", "sub"]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("overlapping withTenant calls each see their own tenant and restore correctly", async () => {
+        const a = tenantContext.withTenant(createTenant("a", "root"), async () => {
+            await tick();
+            const first = tenantContext.getTenant().id;
+            await tick();
+            return [first, tenantContext.getTenant().id];
+        });
+        const b = tenantContext.withTenant(createTenant("b", "root"), async () => {
+            await tick();
+            return tenantContext.getTenant().id;
+        });
+
+        expect(await Promise.all([a, b])).toEqual([["a", "a"], "b"]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("nested withTenant restores the outer scope's tenant", async () => {
+        const result = await tenantContext.withTenant(createTenant("a", "root"), async () => {
+            const inner = await tenantContext.withTenant(createTenant("b", "root"), async () => {
+                return tenantContext.getTenant().id;
+            });
+            return [inner, tenantContext.getTenant().id];
+        });
+
+        expect(result).toEqual(["b", "a"]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("rejects switching to a disabled tenant", async () => {
+        const disabled = { ...createTenant("off", "root"), status: "disabled" } as Tenant;
+        await expect(tenantContext.withTenant(disabled, async () => "x")).rejects.toThrow();
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+});
