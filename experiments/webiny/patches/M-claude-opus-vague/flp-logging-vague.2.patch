new file mode 100644
index 00000000..19518697
--- /dev/null
+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,168 @@
+import { describe, it, expect } from "vitest";
+import type { Container } from "@webiny/di";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { AcoFlpCrud } from "~/features/folder/shared/abstractions.js";
+
+interface LogEntry {
+    level: string;
+    data: any;
+    message: string;
+}
+
+/** Records what is logged, so a test can tell whether a lost FLP change would show up. */
+const recordLogs = (container: Container) => {
+    const entries: LogEntry[] = [];
+    const record =
+        (level: string) =>
+        (data: any, message = "") =>
+            entries.push({ level, data, message });
+
+    container.registerInstance(Logger, {
+        trace: record("trace"),
+        debug: record("debug"),
+        info: record("info"),
+        warn: record("warn"),
+        error: record("error"),
+        fatal: record("fatal"),
+        log: record("info")
+    });
+
+    return entries;
+};
+
+const createFolder = async (container: Container, slug: string, parentId: string | null = null) => {
+    const result = await container.resolve(CreateFolderUseCase).execute({
+        type: "type",
+        title: slug,
+        slug,
+        parentId
+    });
+    return result.value;
+};
+
+describe("FLP logging", () => {
+    const { handler } = useHandler();
+
+    it("should log when the FLP task cannot be started after a folder change", async () => {
+        const context = await handler();
+        const logs = recordLogs(context.container);
+        context.container.registerInstance(TaskService, {
+            trigger: async () => {
+                throw new Error("transport is down");
+            }
+        } as never);
+
+        const folder = await createFolder(context.container, "folder");
+
+        // The folder change itself goes through.
+        expect(folder.id).toBeTruthy();
+
+        const errors = logs.filter(entry => entry.level === "error");
+        expect(errors).toHaveLength(1);
+        expect(errors[0].data).toMatchObject({
+            flp: { operation: "create", folderId: folder.id, folderType: "type" }
+        });
+        expect(errors[0].data.err.message).toBe("transport is down");
+    });
+
+    it("should log when creating the FLP record fails", async () => {
+        const context = await handler();
+        const parent = await createFolder(context.container, "parent");
+        // Without the parent's record, the child's cannot be created.
+        await context.container.resolve(AcoFlpCrud).delete(parent.id);
+        const logs = recordLogs(context.container);
+
+        const child = await createFolder(context.container, "child", parent.id);
+
+        expect(await context.container.resolve(AcoFlpCrud).get(child.id)).toBeNull();
+        const errors = logs.filter(entry => entry.level === "error");
+        expect(errors).toHaveLength(1);
+        expect(errors[0].message).toContain("the folder has no FLP record");
+        expect(errors[0].data).toMatchObject({
+            flp: { operation: "create", folderId: child.id, parentId: parent.id }
+        });
+        expect(errors[0].data.err).toBeInstanceOf(Error);
+    });
+
+    it("should log when updating the FLP records fails", async () => {
+        const context = await handler();
+        const folder = await createFolder(context.container, "folder");
+        const logs = recordLogs(context.container);
+        context.container.registerInstance(UpdateFlpUseCase, {
+            execute: async () => {
+                throw new Error("storage write failed");
+            }
+        });
+
+        await context.container.resolve(UpdateFolderUseCase).execute(folder.id, {
+            permissions: [{ target: "admin:user1", level: "viewer" }]
+        });
+
+        const errors = logs.filter(entry => entry.level === "error");
+        expect(errors).toHaveLength(1);
+        expect(errors[0].message).toContain("may keep their old permissions");
+        expect(errors[0].data).toMatchObject({ flp: { operation: "update", folderId: folder.id } });
+        expect(errors[0].data.err.message).toBe("storage write failed");
+    });
+
+    it("should log when an FLP update has to continue in another run", async () => {
+        const context = await handler();
+        const folder = await createFolder(context.container, "folder");
+        const logs = recordLogs(context.container);
+        let runs = 0;
+        context.container.registerInstance(UpdateFlpUseCase, {
+            execute: async params => {
+                // The first run runs out of time; the second finishes.
+                if (runs++ === 0) {
+                    params.handleTimeout?.(["some-subtree"]);
+                }
+            }
+        });
+
+        await context.container.resolve(UpdateFolderUseCase).execute(folder.id, {
+            permissions: [{ target: "admin:user1", level: "viewer" }]
+        });
+
+        expect(runs).toBe(2);
+        const infos = logs.filter(entry => entry.data?.flp?.operation === "update");
+        expect(infos).toHaveLength(1);
+        expect(infos[0]).toMatchObject({
+            level: "info",
+            data: { flp: { folderId: folder.id }, completedSubtrees: 1 }
+        });
+        expect(logs.filter(entry => entry.level === "error")).toHaveLength(0);
+    });
+
+    it("should log when deleting the FLP record fails", async () => {
+        const context = await handler();
+        const folder = await createFolder(context.container, "folder");
+        // Nothing to delete, so the task fails.
+        await context.container.resolve(AcoFlpCrud).delete(folder.id);
+        const logs = recordLogs(context.container);
+
+        await context.container.resolve(DeleteFolderUseCase).execute(folder.id);
+
+        const errors = logs.filter(entry => entry.level === "error");
+        expect(errors).toHaveLength(1);
+        expect(errors[0].data).toMatchObject({ flp: { operation: "delete", folderId: folder.id } });
+    });
+
+    it("should not log errors when folder changes sync normally", async () => {
+        const context = await handler();
+        const logs = recordLogs(context.container);
+
+        const parent = await createFolder(context.container, "parent");
+        await createFolder(context.container, "child", parent.id);
+        await context.container.resolve(UpdateFolderUseCase).execute(parent.id, {
+            permissions: [{ target: "admin:user1", level: "viewer" }]
+        });
+
+        expect(logs.filter(entry => ["warn", "error"].includes(entry.level))).toEqual([]);
+    });
+});
