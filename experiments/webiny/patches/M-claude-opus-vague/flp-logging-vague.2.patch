new file mode 100644
index 00000000..efc65901
--- /dev/null
+++ b/packages/api-aco/src/features/flp/shared/flpLogContext.ts
@@ -0,0 +1,22 @@
+import type { Folder } from "~/folder/folder.types.js";
+
+export type FlpOperation = "create" | "update" | "delete";
+
+/**
+ * The fields that identify a folder in FLP log entries, so a folder left with wrong permissions can
+ * be traced back to the log line that explains it.
+ *
+ * Errors must go under `err`: that is the key pino serializes. Under any other key an `Error` is
+ * written as `{}`, because its message and stack are not enumerable.
+ */
+export const flpLogContext = (operation: FlpOperation, folder: Folder | undefined | null) => {
+    return {
+        flp: {
+            operation,
+            folderId: folder?.id,
+            folderType: folder?.type,
+            parentId: folder?.parentId ?? null,
+            slug: folder?.slug
+        }
+    };
+};
