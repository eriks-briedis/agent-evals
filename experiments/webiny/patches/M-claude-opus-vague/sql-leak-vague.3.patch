diff --git a/packages/api-core-sql/src/tableManagerRegistry.ts b/packages/api-core-sql/src/tableManagerRegistry.ts
new file mode 100644
index 00000000..e4dbe5f5
--- /dev/null
+++ b/packages/api-core-sql/src/tableManagerRegistry.ts
@@ -0,0 +1,54 @@
+/**
+ * Process-wide registry of SQL table managers, used by test suites to reset the managers' cached
+ * "table already verified" state after dropping all tables between tests.
+ *
+ * Managers are created per request container, so the registry must not keep them alive: it holds
+ * only weak references, and entries are removed once their manager has been garbage collected.
+ * Holding strong references here caused memory to grow with every served request.
+ */
+export interface IResettableTableManager {
+    reset(): void;
+}
+
+interface ITableManagerRegistry {
+    refs: Set<WeakRef<IResettableTableManager>>;
+    finalizer: FinalizationRegistry<WeakRef<IResettableTableManager>>;
+}
+
+const REGISTRY_KEY = "__sqlTableManagers";
+
+const getRegistry = (): ITableManagerRegistry => {
+    const g = globalThis as Record<string, unknown>;
+    const existing = g[REGISTRY_KEY] as ITableManagerRegistry | undefined;
+    if (existing && existing.refs instanceof Set) {
+        return existing;
+    }
+    const refs = new Set<WeakRef<IResettableTableManager>>();
+    const registry: ITableManagerRegistry = {
+        refs,
+        finalizer: new FinalizationRegistry(ref => {
+            refs.delete(ref);
+        })
+    };
+    g[REGISTRY_KEY] = registry;
+    return registry;
+};
+
+export const registerTableManager = (manager: IResettableTableManager): void => {
+    const registry = getRegistry();
+    const ref = new WeakRef(manager);
+    registry.refs.add(ref);
+    registry.finalizer.register(manager, ref);
+};
+
+export const resetTableManagers = (): void => {
+    const registry = getRegistry();
+    for (const ref of registry.refs) {
+        const manager = ref.deref();
+        if (manager) {
+            manager.reset();
+        } else {
+            registry.refs.delete(ref);
+        }
+    }
+};
