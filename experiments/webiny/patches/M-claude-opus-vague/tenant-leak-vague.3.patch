diff --git a/packages/api-core/__tests__/tenancy/tenantContext.test.ts b/packages/api-core/__tests__/tenancy/tenantContext.test.ts
index 6891fe89..e0312317 100644
--- a/packages/api-core/__tests__/tenancy/tenantContext.test.ts
+++ b/packages/api-core/__tests__/tenancy/tenantContext.test.ts
@@ -125,3 +125,77 @@ describe("TenantContext with no tenant set", () => {
         expect(tenantContext.getTenant()).toBeNull();
     });
 });
+
+/*
+ * GraphQL resolves the fields of one request concurrently against the same TenantContext. A
+ * `withTenant` in one resolver (e.g. loading the identity profile from the parent tenant) must not
+ * change the tenant seen by the resolvers running alongside it.
+ */
+describe("TenantContext with concurrent work", () => {
+    let tenantContext: TenantContext.Interface;
+    const tick = () => new Promise(resolve => setTimeout(resolve, 5));
+
+    beforeEach(() => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        tenantContext = container.resolve(TenantContext);
+        tenantContext.setTenant(createTenant("sub", "root"));
+    });
+
+    it("withTenant does not leak the tenant into sibling async work", async () => {
+        const seen: string[] = [];
+
+        const profile = tenantContext.withTenant(createTenant("root", null), async () => {
+            await tick();
+            await tick();
+            return tenantContext.getTenant().id;
+        });
+
+        const sibling = (async () => {
+            await tick();
+            seen.push(tenantContext.getTenant().id);
+            await tick();
+            seen.push(tenantContext.getTenant().id);
+        })();
+
+        const [profileTenant] = await Promise.all([profile, sibling]);
+
+        expect(profileTenant).toBe("root");
+        expect(seen).toEqual(["sub", "sub"]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("overlapping withTenant calls each keep their own tenant and restore correctly", async () => {
+        const a = tenantContext.withTenant(createTenant("a", "root"), async () => {
+            await tick();
+            const first = tenantContext.getTenant().id;
+            await tick();
+            return [first, tenantContext.getTenant().id];
+        });
+        const b = tenantContext.withTenant(createTenant("b", "root"), async () => {
+            const first = tenantContext.getTenant().id;
+            await tick();
+            await tick();
+            return [first, tenantContext.getTenant().id];
+        });
+
+        expect(await Promise.all([a, b])).toEqual([
+            ["a", "a"],
+            ["b", "b"]
+        ]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("withRootTenant does not leak into sibling async work", async () => {
+        const root = tenantContext.withRootTenant(async () => {
+            await tick();
+            return tenantContext.getTenant().id;
+        });
+        const sibling = (async () => {
+            await tick();
+            return tenantContext.getTenant().id;
+        })();
+
+        expect(await Promise.all([root, sibling])).toEqual(["root", "sub"]);
+    });
+});
