diff --git a/packages/api-opensearch/__tests__/registries.test.ts b/packages/api-opensearch/__tests__/registries.test.ts
new file mode 100644
index 00000000..4c192f63
--- /dev/null
+++ b/packages/api-opensearch/__tests__/registries.test.ts
@@ -0,0 +1,81 @@
+import { describe, expect, it } from "vitest";
+import { Container } from "@webiny/di";
+import { OpenSearchQueryBuilderOperatorFeature } from "~/features/OpenSearchQueryBuilderOperator/feature.js";
+import { OpenSearchIndexFeature } from "~/features/OpenSearchIndex/feature.js";
+import { OpenSearchQueryBuilderOperator } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperator.js";
+import { OpenSearchQueryBuilderOperatorRegistry } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperatorRegistry.js";
+import { OpenSearchIndex } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndex.js";
+import { OpenSearchIndexRegistry } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndexRegistry.js";
+
+class CustomOperatorImpl implements OpenSearchQueryBuilderOperator.Interface {
+    public getOperator(): string {
+        return "custom";
+    }
+
+    public apply(query: OpenSearchQueryBuilderOperator.Query): void {
+        query.filter.push({ match_all: {} });
+    }
+}
+
+const CustomOperator = OpenSearchQueryBuilderOperator.createImplementation({
+    implementation: CustomOperatorImpl,
+    dependencies: []
+});
+
+class CustomIndexImpl implements OpenSearchIndex.Interface {
+    public readonly body = { settings: { number_of_shards: 1 } } as OpenSearchIndex.Interface["body"];
+
+    public canUse(): boolean {
+        return true;
+    }
+}
+
+const CustomIndex = OpenSearchIndex.createImplementation({
+    implementation: CustomIndexImpl,
+    dependencies: []
+});
+
+/**
+ * The API handlers register the OpenSearch core in the root container, while extensions register
+ * in the per-request child container. The registries must see both.
+ */
+describe("OpenSearch registries with root core and request extensions", () => {
+    const createRoot = () => {
+        const root = new Container();
+        OpenSearchQueryBuilderOperatorFeature.register(root);
+        OpenSearchIndexFeature.register(root);
+        return root;
+    };
+
+    it("operator registry includes operators registered in a child container", () => {
+        const root = createRoot();
+        // Resolve once in the root first, as a previous request / root consumer could.
+        expect(root.resolve(OpenSearchQueryBuilderOperatorRegistry).get("custom")).toBeUndefined();
+
+        const child = root.createChildContainer();
+        child.register(CustomOperator).inSingletonScope();
+
+        const registry = child.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        expect(registry.get("custom")).toBeInstanceOf(CustomOperatorImpl);
+        // Built-ins from the root are still there.
+        expect(registry.get("eq")).toBeDefined();
+
+        // Another request without the extension does not see it.
+        const otherChild = root.createChildContainer();
+        expect(
+            otherChild.resolve(OpenSearchQueryBuilderOperatorRegistry).get("custom")
+        ).toBeUndefined();
+    });
+
+    it("index registry includes indices registered in a child container", () => {
+        const root = createRoot();
+        expect(root.resolve(OpenSearchIndexRegistry).getAll()).toHaveLength(0);
+
+        const child = root.createChildContainer();
+        child.register(CustomIndex).inSingletonScope();
+
+        const registry = child.resolve(OpenSearchIndexRegistry);
+        expect(registry.getAll()).toHaveLength(1);
+        expect(registry.getLastAdded()).toBeInstanceOf(CustomIndexImpl);
+    });
+});
