+/*
+ * Resolvers of one GraphQL query run concurrently. A `withTenant` in one of them (the identity
+ * profile falling back to the parent tenant) must not switch the tenant for the others.
+ */
+describe("TenantContext with concurrent callers", () => {
+    let tenantContext: TenantContext.Interface;
+
+    const tick = () => new Promise(resolve => setTimeout(resolve, 5));
+
+    beforeEach(() => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        tenantContext = container.resolve(TenantContext);
+        tenantContext.setTenant(createTenant("sub", "root"));
+    });
+
+    it("does not leak a withTenant override into concurrent work", async () => {
+        const seen: string[] = [];
+
+        const parentLookup = tenantContext.withTenant(createTenant("root", null), async () => {
+            await tick();
+            await tick();
+            return tenantContext.getTenant().id;
+        });
+
+        const otherResolver = (async () => {
+            await tick();
+            seen.push(tenantContext.getTenant().id);
+            await tick();
+            seen.push(tenantContext.getTenant().id);
+        })();
+
+        // Runs synchronously while `parentLookup` is in progress.
+        seen.push(tenantContext.getTenant().id);
+
+        const [parentTenantId] = await Promise.all([parentLookup, otherResolver]);
+
+        expect(parentTenantId).toBe("root");
+        expect(seen).toEqual(["sub", "sub", "sub"]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("keeps overlapping overrides independent", async () => {
+        const [a, b] = await Promise.all([
+            tenantContext.withTenant(createTenant("a", "root"), async () => {
+                await tick();
+                return tenantContext.getTenant().id;
+            }),
+            tenantContext.withRootTenant(async () => {
+                await tick();
+                await tick();
+                return tenantContext.getTenant().id;
+            })
+        ]);
+
+        expect(a).toBe("a");
+        expect(b).toBe("root");
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("setTenant inside an override only affects that override", async () => {
+        const inner = await tenantContext.withTenant(createTenant("a", "root"), async () => {
+            tenantContext.setTenant(createTenant("b", "root"));
+            await tick();
+            return tenantContext.getTenant().id;
+        });
+
+        expect(inner).toBe("b");
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+});
+
