--- a/packages/api-opensearch/src/features/OpenSearchIndex/feature.ts
+++ b/packages/api-opensearch/src/features/OpenSearchIndex/feature.ts
@@ -4,6 +4,9 @@ import { OpenSearchIndexRegistry } from "./OpenSearchIndexRegistry.js";
 export const OpenSearchIndexFeature = createFeature({
     name: "opensearch.internal.index",
     register(container) {
-        container.register(OpenSearchIndexRegistry).inSingletonScope();
+        // Container scoped, not singleton: the registry is registered once in the root, but extensions
+        // register their indexes in each request's child container. A singleton is built from the
+        // root's view only and would never see them, so custom indexes would be silently ignored.
+        container.register(OpenSearchIndexRegistry).inContainerScope();
     }
 });
