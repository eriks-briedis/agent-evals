new file mode 100644
index 00000000..978e1b56
--- /dev/null
+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,210 @@
+import { describe, it, expect } from "vitest";
+import type { Container } from "@webiny/di";
+import { Result } from "@webiny/feature/api";
+import { WebinyError } from "@webiny/error";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { AcoFlpCrud } from "~/features/folder/shared/abstractions.js";
+import { CREATE_FLP_TASK_ID, DELETE_FLP_TASK_ID, UPDATE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+const type = "type";
+const viewer = { target: "admin:user1", level: "viewer" } as const;
+
+interface LogLine {
+    level: string;
+    data: any;
+    message: string;
+}
+
+/** Records what is logged, so a test can tell whether a failure left a trace. */
+const recordLogs = (container: Container) => {
+    const lines: LogLine[] = [];
+    const record =
+        (level: string) =>
+        (data: any, message = "") => {
+            lines.push({ level, data, message });
+        };
+    container.registerInstance(Logger, {
+        trace: record("trace"),
+        debug: record("debug"),
+        info: record("info"),
+        warn: record("warn"),
+        error: record("error"),
+        fatal: record("fatal"),
+        log: record("info")
+    });
+    return lines;
+};
+
+const errorsFor = (lines: LogLine[], task: string) => {
+    return lines.filter(line => line.level === "error" && line.data?.flp?.task === task);
+};
+
+const createFolder = async (container: Container, slug: string, parentId: string | null = null) => {
+    const result = await container.resolve(CreateFolderUseCase).execute({
+        type,
+        title: slug,
+        slug,
+        parentId
+    });
+    expect(result.isOk()).toBe(true);
+    return result.value;
+};
+
+/** A task service that cannot start tasks, the way a real one fails: in its result. */
+const failingTaskService = (failWith: "result" | "throw"): TaskService.Interface => {
+    const fail = async () => {
+        const error = new WebinyError("Could not start the step function.", "TRIGGER_FAILED");
+        if (failWith === "throw") {
+            throw error;
+        }
+        return Result.fail(error);
+    };
+    return {
+        trigger: fail,
+        abort: fail,
+        fetchServiceInfo: async () => Result.ok({})
+    } as unknown as TaskService.Interface;
+};
+
+describe("FLP failures are logged", () => {
+    const { handler } = useHandler();
+
+    for (const failWith of ["result", "throw"] as const) {
+        it(`should log when the FLP tasks cannot be triggered (trigger fails by ${failWith})`, async () => {
+            const context = await handler();
+            const { container } = context;
+            const lines = recordLogs(container);
+            container.registerInstance(TaskService, failingTaskService(failWith));
+
+            // The folder changes still go through.
+            const folder = await createFolder(container, `trigger-${failWith}`);
+
+            const updated = await container
+                .resolve(UpdateFolderUseCase)
+                .execute(folder.id, { permissions: [viewer] });
+            expect(updated.isOk()).toBe(true);
+
+            const deleted = await container.resolve(DeleteFolderUseCase).execute(folder.id);
+            expect(deleted.isOk()).toBe(true);
+
+            for (const [task, change] of [
+                [CREATE_FLP_TASK_ID, "created"],
+                [UPDATE_FLP_TASK_ID, "updated"],
+                [DELETE_FLP_TASK_ID, "deleted"]
+            ]) {
+                const errors = errorsFor(lines, task);
+                expect(errors).toHaveLength(1);
+                expect(errors[0].message).toContain("could not be triggered");
+                expect(errors[0].data).toMatchObject({
+                    flp: { change, task },
+                    folder: { id: folder.id, type, slug: folder.slug },
+                    error: { code: "TRIGGER_FAILED", message: "Could not start the step function." }
+                });
+                // Logged as data, not as an Error whose properties a log line would drop.
+                expect(errors[0].data.error).not.toBeInstanceOf(Error);
+            }
+        });
+    }
+
+    it("should log why the create task failed, while the folder is still created", async () => {
+        const context = await handler();
+        const { container } = context;
+        const lines = recordLogs(container);
+        container.registerInstance(CreateFlpUseCase, {
+            execute: async () => {
+                throw new WebinyError("Storage is unavailable.", "STORAGE_DOWN", { attempt: 1 });
+            }
+        });
+
+        const folder = await createFolder(container, "create-fails");
+
+        // Exactly the reported symptom: a folder with no FLP record.
+        expect(await container.resolve(AcoFlpCrud).get(folder.id)).toBeNull();
+
+        const errors = errorsFor(lines, CREATE_FLP_TASK_ID);
+        expect(errors).toHaveLength(1);
+        expect(errors[0].message).toContain("The folder has no FLP record");
+        expect(errors[0].data).toMatchObject({
+            flp: { change: "created" },
+            folder: { id: folder.id },
+            error: { code: "STORAGE_DOWN", message: "Storage is unavailable.", data: { attempt: 1 } }
+        });
+    });
+
+    it("should log why the update task failed, while the folder is still updated", async () => {
+        const context = await handler();
+        const { container } = context;
+        const parent = await createFolder(container, "update-parent");
+        await createFolder(container, "update-child", parent.id);
+
+        const lines = recordLogs(container);
+        container.registerInstance(UpdateFlpUseCase, {
+            execute: async () => {
+                throw new WebinyError("Batch write rejected.", "BATCH_UPDATE_FLP_ERROR");
+            }
+        });
+
+        const updated = await container
+            .resolve(UpdateFolderUseCase)
+            .execute(parent.id, { permissions: [viewer] });
+        expect(updated.isOk()).toBe(true);
+
+        const errors = errorsFor(lines, UPDATE_FLP_TASK_ID);
+        expect(errors).toHaveLength(1);
+        expect(errors[0].message).toContain("keep their old permissions");
+        expect(errors[0].data).toMatchObject({
+            flp: { change: "updated", completedBefore: 0 },
+            folder: { id: parent.id },
+            error: { code: "BATCH_UPDATE_FLP_ERROR" }
+        });
+    });
+
+    it("should log nothing at error level when the FLP records are written", async () => {
+        const context = await handler();
+        const { container } = context;
+        const lines = recordLogs(container);
+
+        const folder = await createFolder(container, "all-good");
+        await container.resolve(UpdateFolderUseCase).execute(folder.id, { permissions: [viewer] });
+        await container.resolve(DeleteFolderUseCase).execute(folder.id);
+
+        expect(lines.filter(line => line.data?.flp && line.level === "error")).toEqual([]);
+    });
+
+    it("should log when the update task is stopped at its maximum number of runs", async () => {
+        const context = await handler();
+        const { container } = context;
+        const lines = recordLogs(container);
+        const folder = await createFolder(container, "max-iterations");
+
+        const definition = container
+            .resolveAll(TaskDefinition)
+            .find(candidate => candidate.id === UPDATE_FLP_TASK_ID)!;
+        const taskHandler = container.resolveImplementation(definition.handler);
+
+        await taskHandler.onMaxIterations!({
+            task: {
+                id: "task-1",
+                iterations: 50,
+                input: { folder, completed: ["a", "b"] }
+            },
+            definition
+        } as never);
+
+        const errors = errorsFor(lines, UPDATE_FLP_TASK_ID);
+        expect(errors).toHaveLength(1);
+        expect(errors[0].message).toContain("maximum number of runs");
+        expect(errors[0].data).toMatchObject({
+            flp: { taskId: "task-1", iterations: 50, completedBefore: 2 },
+            folder: { id: folder.id }
+        });
+    });
+});
