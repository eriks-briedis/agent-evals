@@ -0,0 +1,49 @@
+import type { Folder } from "~/folder/folder.types.js";
+
+/*
+ * Keeping the FLP catalog in step with folders happens after the folder change has been saved: the
+ * folder event handlers trigger a task, and the task writes the FLP records. Neither step can fail
+ * the folder change, so when one fails the logs are the only place that says so. These helpers keep
+ * those log lines alike, so one search finds every failure for a folder.
+ */
+
+/** Enough to find the folder, without logging its whole permission list. */
+export const describeFolder = (folder: Partial<Folder> | undefined | null) => {
+    return {
+        id: folder?.id,
+        type: folder?.type,
+        slug: folder?.slug,
+        parentId: folder?.parentId ?? null
+    };
+};
+
+/*
+ * Error properties are not enumerable, so an `Error` logged as is shows up as `{}`. This keeps what
+ * explains the failure. `data` matters most, since the FLP use cases put the affected ids there.
+ */
+export const describeError = (error: unknown) => {
+    if (!error || typeof error !== "object") {
+        return { message: String(error) };
+    }
+    const { message, code, data, stack } = error as {
+        message?: string;
+        code?: string;
+        data?: unknown;
+        stack?: string;
+    };
+    return { message, code, data, stack };
+};
+
+/*
+ * The id ties a log line to the task record. Read defensively: controllers built in tests carry no
+ * task state, and a missing id must never be the reason a failure goes unlogged.
+ */
+export const getTaskId = (controller: {
+    state?: { getTask?: () => { id?: string } | undefined };
+}): string | undefined => {
+    try {
+        return controller.state?.getTask?.()?.id;
+    } catch {
+        return undefined;
+    }
+};
