diff --git a/packages/api-core-sql/src/tableManagerRegistry.ts b/packages/api-core-sql/src/tableManagerRegistry.ts
new file mode 100644
index 00000000..a11b8a3e
--- /dev/null
+++ b/packages/api-core-sql/src/tableManagerRegistry.ts
@@ -0,0 +1,57 @@
+/**
+ * Registry of SQL table/schema managers that cache "table verified" state.
+ *
+ * Test suites drop all tables between tests and need to reset that cached state on every live
+ * manager. Managers are created per request DI container, so the registry must NOT hold strong
+ * references to them - otherwise every request would leak a manager (and everything it
+ * references) for the lifetime of the process.
+ *
+ * Entries are held via WeakRef and removed by a FinalizationRegistry once the manager is
+ * garbage-collected. State lives on globalThis so that multiple copies of this module (e.g.
+ * test setup files vs. built packages) share the same registry.
+ */
+export interface IResettableTableManager {
+    reset(): void;
+}
+
+interface IRegistryState {
+    refs: Set<WeakRef<IResettableTableManager>>;
+    finalizer: FinalizationRegistry<WeakRef<IResettableTableManager>>;
+}
+
+const REGISTRY_KEY = Symbol.for("webiny.sqlTableManagers");
+
+const getState = (): IRegistryState => {
+    const g = globalThis as unknown as Record<symbol, IRegistryState | undefined>;
+    let state = g[REGISTRY_KEY];
+    if (!state) {
+        const refs = new Set<WeakRef<IResettableTableManager>>();
+        state = {
+            refs,
+            finalizer: new FinalizationRegistry(ref => {
+                refs.delete(ref);
+            })
+        };
+        g[REGISTRY_KEY] = state;
+    }
+    return state;
+};
+
+export const registerTableManager = (manager: IResettableTableManager): void => {
+    const state = getState();
+    const ref = new WeakRef(manager);
+    state.refs.add(ref);
+    state.finalizer.register(manager, ref);
+};
+
+export const resetTableManagers = (): void => {
+    const state = getState();
+    for (const ref of state.refs) {
+        const manager = ref.deref();
+        if (manager) {
+            manager.reset();
+        } else {
+            state.refs.delete(ref);
+        }
+    }
+};
