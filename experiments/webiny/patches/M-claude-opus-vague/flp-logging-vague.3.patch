index 00000000..5ccb8a27
--- /dev/null
+++ b/packages/api-aco/src/features/flp/shared/logging.ts
@@ -0,0 +1,42 @@
+import { getObjectProperties } from "@webiny/utils/getObjectProperties.js";
+import type { Folder } from "~/folder/folder.types.js";
+
+/*
+ * A folder change goes through even when its FLP records are not written, since that happens later,
+ * in a background task. These keep the log lines about it searchable by folder.
+ */
+export const getFolderLogData = (folder: Folder | undefined | null) => {
+    return {
+        folderId: folder?.id,
+        folderType: folder?.type,
+        folderSlug: folder?.slug,
+        parentId: folder?.parentId ?? null
+    };
+};
+
+/*
+ * Errors keep `message` and `stack` as non-enumerable properties, so a logger that serializes them
+ * as plain objects drops exactly the part that says what went wrong.
+ */
+export const getErrorLogData = (error: unknown): Record<string, unknown> => {
+    if (error && typeof error === "object") {
+        return getObjectProperties<Record<string, unknown>>(error);
+    }
+    return { message: String(error) };
+};
+
+interface TaskStateReader {
+    state: { getTask(): { id: string; iterations: number } };
+}
+
+/*
+ * Used while reporting a failure, so it must not throw and replace the error being reported.
+ */
+export const getTaskLogData = (controller: TaskStateReader) => {
+    try {
+        const task = controller.state.getTask();
+        return { taskId: task.id, iteration: task.iterations };
+    } catch {
+        return { taskId: undefined, iteration: undefined };
+    }
+};
