+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,164 @@
+import { describe, it, expect } from "vitest";
+import { Result } from "@webiny/feature/api";
+import { WebinyError } from "@webiny/error";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { AcoFlpCrud } from "~/features/folder/shared/abstractions.js";
+import { CREATE_FLP_TASK_ID, DELETE_FLP_TASK_ID, UPDATE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+import type { AcoContext } from "~/types";
+
+interface LoggedCall {
+    level: string;
+    data: Record<string, any>;
+    message: string;
+}
+
+const captureLogs = (context: AcoContext) => {
+    const calls: LoggedCall[] = [];
+    const record =
+        (level: string) =>
+        (data: Record<string, any> | string, message?: string): void => {
+            if (typeof data === "string") {
+                calls.push({ level, data: {}, message: data });
+                return;
+            }
+            calls.push({ level, data, message: message ?? "" });
+        };
+    context.container.registerInstance(Logger, {
+        trace: record("trace"),
+        debug: record("debug"),
+        info: record("info"),
+        warn: record("warn"),
+        error: record("error"),
+        fatal: record("fatal"),
+        log: record("info")
+    });
+    return calls;
+};
+
+const failingTaskService = (fail: () => Promise<any>): TaskService.Interface => ({
+    trigger: fail,
+    abort: fail,
+    fetchServiceInfo: fail
+});
+
+describe("FLP logging", () => {
+    const { handler } = useHandler();
+
+    it("logs when the FLP task cannot be triggered after each folder change", async () => {
+        const context = await handler();
+        const folder = (
+            await context.container.resolve(CreateFolderUseCase).execute({
+                title: "Folder 1",
+                type: "type1",
+                slug: "folder1",
+                parentId: null
+            })
+        ).value;
+
+        const logs = captureLogs(context);
+        // `trigger` can fail either way: by returning a failed result, or by throwing.
+        let call = 0;
+        context.container.registerInstance(
+            TaskService,
+            failingTaskService(async () => {
+                call++;
+                if (call % 2) {
+                    return Result.fail(new WebinyError("Queue is down.", "QUEUE_DOWN") as any);
+                }
+                throw new WebinyError("Step function unavailable.", "SFN_DOWN");
+            })
+        );
+
+        const created = await context.container.resolve(CreateFolderUseCase).execute({
+            title: "Folder 2",
+            type: "type1",
+            slug: "folder2",
+            parentId: null
+        });
+        expect(created.isOk()).toBe(true);
+
+        const updated = await context.container.resolve(UpdateFolderUseCase).execute(folder.id, {
+            permissions: [{ target: "admin:1", level: "viewer" }]
+        });
+        expect(updated.isOk()).toBe(true);
+
+        // Called a third time, so this one returns a failed result again.
+        const deleted = await context.container.resolve(DeleteFolderUseCase).execute(folder.id);
+        expect(deleted.isOk()).toBe(true);
+
+        const errors = logs.filter(log => log.level === "error");
+        expect(errors).toEqual([
+            expect.objectContaining({
+                data: expect.objectContaining({
+                    folderId: created.value.id,
+                    taskDefinitionId: CREATE_FLP_TASK_ID,
+                    error: expect.objectContaining({
+                        code: "QUEUE_DOWN",
+                        message: "Queue is down."
+                    })
+                })
+            }),
+            expect.objectContaining({
+                data: expect.objectContaining({
+                    folderId: folder.id,
+                    taskDefinitionId: UPDATE_FLP_TASK_ID,
+                    error: expect.objectContaining({
+                        code: "SFN_DOWN",
+                        message: "Step function unavailable."
+                    })
+                })
+            }),
+            expect.objectContaining({
+                data: expect.objectContaining({
+                    folderId: folder.id,
+                    taskDefinitionId: DELETE_FLP_TASK_ID
+                })
+            })
+        ]);
+    });
+
+    it("logs which folder the create FLP task failed for, and why", async () => {
+        const context = await handler();
+        const createFolder = context.container.resolve(CreateFolderUseCase);
+        const parent = (
+            await createFolder.execute({
+                title: "Parent",
+                type: "type1",
+                slug: "parent",
+                parentId: null
+            })
+        ).value;
+
+        // Without the parent's record the child's cannot be built.
+        await context.container.resolve(AcoFlpCrud).delete(parent.id);
+
+        const logs = captureLogs(context);
+        const child = await createFolder.execute({
+            title: "Child",
+            type: "type1",
+            slug: "child",
+            parentId: parent.id
+        });
+        expect(child.isOk()).toBe(true);
+
+        expect(logs.filter(log => log.level === "error")).toEqual([
+            expect.objectContaining({
+                message: expect.stringContaining("Failed to create the FLP record"),
+                data: expect.objectContaining({
+                    folderId: child.value.id,
+                    parentId: parent.id,
+                    flpCreated: false,
+                    error: expect.objectContaining({
+                        code: "ERROR_CREATE_FLP_USE_CASE_PARENT_FLP_NOT_FOUND",
+                        stack: expect.any(String)
+                    })
+                })
+            })
+        ]);
+    });
+});
