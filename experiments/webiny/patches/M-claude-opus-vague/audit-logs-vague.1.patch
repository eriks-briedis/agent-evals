diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..c438e1c5
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from "vitest";
+import { useHandler } from "~tests/helpers/useHandler.js";
+import { AuditLogsContext } from "~/abstractions.js";
+import { CreateGroupUseCase } from "@webiny/api-headless-cms/features/contentModelGroup/CreateGroup/index.js";
+import { ActionType } from "@webiny/common-audit-logs";
+
+const isSql = process.env.WEBINY_STORAGE?.includes("sql");
+
+describe.skipIf(isSql)("audit log subscriptions", () => {
+    it("should register the full request context as AuditLogsContext", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const resolved = context.container.resolve(AuditLogsContext);
+        expect(resolved.container).toBeDefined();
+        expect(resolved.auditLogs).toBe(context.auditLogs);
+    });
+
+    it("should create an audit log when a CMS group is created", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const result = await context.container.resolve(CreateGroupUseCase).execute({
+            name: "Audit Group",
+            slug: "audit-group",
+            description: "",
+            icon: { type: "emoji", name: "star", value: "⭐" }
+        } as CreateGroupUseCase.Input);
+        if (result.isFail()) {
+            throw result.error;
+        }
+        const group = result.value;
+
+        const { items } = await context.auditLogs.listAuditLogs({});
+        expect(items).toHaveLength(1);
+        expect(items![0]).toMatchObject({
+            message: "Group created",
+            app: "HEADLESS_CMS",
+            entityId: group.id,
+            action: ActionType.CREATE
+        });
+    });
+});
