diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..580baa5a
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it } from "vitest";
+import { useHandler } from "./helpers/useHandler";
+import { AuditLogsContext } from "~/abstractions.js";
+
+const CREATE_FOLDER = /* GraphQL */ `
+    mutation CreateFolder($data: FolderCreateInput!) {
+        aco {
+            createFolder(data: $data) {
+                data {
+                    id
+                }
+                error {
+                    code
+                    message
+                }
+            }
+        }
+    }
+`;
+
+const LIST_AUDIT_LOGS = /* GraphQL */ `
+    query ListAuditLogs($where: ListAuditLogsWhere) {
+        auditLogs {
+            listAuditLogs(where: $where) {
+                data {
+                    id
+                    app
+                    entity
+                    entityId
+                    action
+                    message
+                }
+                error {
+                    code
+                    message
+                }
+            }
+        }
+    }
+`;
+
+const isSql = process.env.WEBINY_STORAGE?.includes("sql");
+
+describe.skipIf(isSql)("audit log subscriptions", () => {
+    it("should register the full request context as AuditLogsContext", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const registered = context.container.resolve(AuditLogsContext);
+        expect(registered.auditLogs).toBe(context.auditLogs);
+        expect(registered.container).toBeDefined();
+    });
+
+    it("should create an audit log when a domain event fires and list it via GraphQL", async () => {
+        const { invoke } = useHandler();
+
+        const [createResponse] = await invoke({
+            body: {
+                query: CREATE_FOLDER,
+                variables: {
+                    data: { title: "Files", slug: "files", type: "FmFile" }
+                }
+            }
+        });
+        const folder = createResponse.data.aco.createFolder;
+        expect(folder.error).toBeNull();
+
+        const [listResponse] = await invoke({
+            body: {
+                query: LIST_AUDIT_LOGS,
+                variables: { where: { entityId: folder.data.id } }
+            }
+        });
+
+        expect(listResponse.data.auditLogs.listAuditLogs).toMatchObject({
+            error: null,
+            data: [
+                {
+                    entityId: folder.data.id,
+                    app: "FILE_MANAGER",
+                    entity: "FILE_FOLDER",
+                    action: "CREATE",
+                    message: "Folder created"
+                }
+            ]
+        });
+    });
+});
