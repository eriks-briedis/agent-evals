diff --git a/packages/api-opensearch/__tests__/registryScope.test.ts b/packages/api-opensearch/__tests__/registryScope.test.ts
new file mode 100644
index 00000000..23aa901e
--- /dev/null
+++ b/packages/api-opensearch/__tests__/registryScope.test.ts
@@ -0,0 +1,50 @@
+import { describe, it, expect } from "vitest";
+import { Container } from "@webiny/di";
+import { OpenSearchQueryBuilderOperatorFeature } from "~/features/OpenSearchQueryBuilderOperator/feature.js";
+import { OpenSearchQueryBuilderOperatorRegistry } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperatorRegistry.js";
+import { OpenSearchQueryBuilderOperator } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperator.js";
+import { OpenSearchIndexFeature } from "~/features/OpenSearchIndex/feature.js";
+import { OpenSearchIndexRegistry } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndexRegistry.js";
+import { OpenSearchIndex } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndex.js";
+
+class Custom {
+    getOperator() {
+        return "custom";
+    }
+    apply() {}
+}
+const CustomImpl = OpenSearchQueryBuilderOperator.createImplementation({
+    implementation: Custom as any,
+    dependencies: []
+});
+class Idx {
+    canUse() {
+        return true;
+    }
+}
+const IdxImpl = OpenSearchIndex.createImplementation({
+    implementation: Idx as any,
+    dependencies: []
+});
+
+describe("registry scope", () => {
+    it("isolates per request", () => {
+        const root = new Container();
+        OpenSearchQueryBuilderOperatorFeature.register(root);
+        OpenSearchIndexFeature.register(root);
+        const a = root.createChildContainer();
+        const b = root.createChildContainer();
+        a.register(CustomImpl).inSingletonScope();
+        a.register(IdxImpl).inSingletonScope();
+
+        const ops = (c: Container) => c.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        expect(ops(a).get("custom")).toBeDefined();
+        expect(ops(b).get("custom")).toBeUndefined();
+        expect(ops(root).get("custom")).toBeUndefined();
+        expect(ops(b).get("eq")).toBeDefined();
+        const idx = (c: Container) => c.resolve(OpenSearchIndexRegistry).getAll().length;
+        expect(idx(a)).toBe(1);
+        expect(idx(b)).toBe(0);
+        expect(idx(root)).toBe(0);
+    });
+});
