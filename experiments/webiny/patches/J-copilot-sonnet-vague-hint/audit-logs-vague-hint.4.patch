diff --git a/packages/api-audit-logs/__tests__/eventHandlers.test.ts b/packages/api-audit-logs/__tests__/eventHandlers.test.ts
new file mode 100644
index 00000000..bc9da24c
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/eventHandlers.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { useHandler } from "./helpers/useHandler";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { UserAfterUpdateEvent } from "@webiny/api-core/features/users/UpdateUser/events.js";
+import { AuditLogsContext } from "~/abstractions.js";
+
+const isSql = process.env.WEBINY_STORAGE?.includes("sql");
+
+describe.skipIf(isSql)("event handlers", () => {
+    it("should create an audit log when a domain event is published", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        expect(context.container.resolve(AuditLogsContext)).toBe(context);
+
+        const user = { id: "user-1", email: "a@b.c" } as any;
+        await context.container
+            .resolve(EventPublisher)
+            .publish(
+                new UserAfterUpdateEvent({ originalUser: user, updatedUser: user, input: {} } as any)
+            );
+
+        const result = await context.auditLogs.listAuditLogs({ entityId: "user-1" });
+        expect(result.items).toHaveLength(1);
+        expect(result.items![0]).toMatchObject({ app: "SECURITY", action: "UPDATE" });
+    });
+});
