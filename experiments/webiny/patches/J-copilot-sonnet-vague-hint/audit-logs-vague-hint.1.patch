index 00000000..b9e4b6d5
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/eventHandlers.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import { GraphQLEngine } from "@webiny/api-graphql";
+import { CreateGroupUseCase } from "@webiny/api-headless-cms/features/contentModelGroup/CreateGroup/index.js";
+import { useHandler } from "~tests/helpers/useHandler.js";
+
+const LIST = /* GraphQL */ `
+    {
+        auditLogs {
+            listAuditLogs(where: {}) {
+                data {
+                    app
+                    entity
+                    action
+                }
+                error {
+                    message
+                }
+            }
+        }
+    }
+`;
+
+describe("audit logs event handlers", () => {
+    it("should store an audit log when a domain event is published", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+        const engine = context.container.resolve(GraphQLEngine);
+
+        const before = await engine.execute({ query: LIST });
+        expect(before.data.auditLogs.listAuditLogs.data).toEqual([]);
+
+        const result = await context.container.resolve(CreateGroupUseCase).execute({
+            name: "Group",
+            slug: "group",
+            icon: { type: "icon", name: "star", value: "star" }
+        } as any);
+        expect(result.isOk()).toBe(true);
+
+        const after = await engine.execute({ query: LIST });
+        expect(after.data.auditLogs.listAuditLogs.error).toBeNull();
+        expect(after.data.auditLogs.listAuditLogs.data).toEqual([
+            { app: "HEADLESS_CMS", entity: "GROUP", action: "CREATE" }
+        ]);
+    });
+});
