diff --git a/packages/api-audit-logs/__tests__/eventHandlers.test.ts b/packages/api-audit-logs/__tests__/eventHandlers.test.ts
new file mode 100644
index 00000000..7ff57d12
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/eventHandlers.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from "vitest";
+import { CreateFolderUseCase } from "@webiny/api-aco/features/folder/CreateFolder/index.js";
+import { useHandler } from "./helpers/useHandler";
+
+describe("audit logs created by event handlers", () => {
+    it("should create an audit log when a folder is created", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const useCase = context.container.resolve(CreateFolderUseCase);
+        const result = await useCase.execute({
+            title: "Audited folder",
+            slug: "audited-folder",
+            type: "FmFile",
+            parentId: null
+        } as any);
+        expect(result.isOk()).toBe(true);
+
+        const list = await context.auditLogs.listAuditLogs({});
+        expect(list.items).toHaveLength(1);
+        expect(list.items[0]).toMatchObject({ message: "Folder created" });
+    });
+});
