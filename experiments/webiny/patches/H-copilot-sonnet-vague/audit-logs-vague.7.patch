index 00000000..f00c30c6
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from "vitest";
+import { useHandler } from "~tests/helpers/useHandler.js";
+import { CreateRoleUseCase } from "@webiny/api-core/features/security/roles/CreateRole/index.js";
+
+const isSql = process.env.WEBINY_STORAGE?.includes("sql");
+
+describe.skipIf(isSql)("audit log subscriptions", () => {
+    it("should create an audit log when a role is created", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const result = await context.container.resolve(CreateRoleUseCase).execute({
+            name: "Role1",
+            slug: "role1",
+            description: "desc",
+            permissions: []
+        });
+        expect(result.isOk()).toBe(true);
+
+        const logs = await context.auditLogs.listAuditLogs({ sort: "DESC" } as any);
+        expect(logs.items).toHaveLength(1);
+        expect(logs.items[0]).toMatchObject({ entity: "ROLE", message: "Role created" });
+    });
+});
