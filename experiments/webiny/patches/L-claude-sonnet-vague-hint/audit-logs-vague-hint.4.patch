diff --git a/packages/api-audit-logs/__tests__/eventHandlers.test.ts b/packages/api-audit-logs/__tests__/eventHandlers.test.ts
new file mode 100644
index 00000000..6e15d137
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/eventHandlers.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it } from "vitest";
+import { useHandler } from "./helpers/useHandler";
+import { CreateGroupUseCase } from "@webiny/api-headless-cms/features/contentModelGroup/CreateGroup/index.js";
+import { CreateRoleUseCase } from "@webiny/api-core/features/security/roles/CreateRole/index.js";
+
+const isSql = process.env.WEBINY_STORAGE?.includes("sql");
+
+describe.skipIf(isSql)("audit logs created from domain events", () => {
+    it("should create audit logs when roles and groups are created", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+        const { container } = context;
+
+        const group = await container.resolve(CreateGroupUseCase).execute({
+            name: "G1",
+            slug: "g1",
+            icon: { type: "icon", name: "star", value: "fas/star" },
+            description: ""
+        });
+        expect(group.isOk()).toBe(true);
+
+        const role = await container.resolve(CreateRoleUseCase).execute({
+            name: "Role1",
+            slug: "role1",
+            description: "desc",
+            permissions: []
+        });
+        expect(role.isOk()).toBe(true);
+
+        const result = await context.auditLogs.listAuditLogs({ limit: 50, sort: "DESC" });
+        const logs = result.items.map(item => `${item.app}/${item.entity}/${item.action}`);
+        expect(logs).toContain("SECURITY/ROLE/CREATE");
+        expect(logs).toContain("HEADLESS_CMS/GROUP/CREATE");
+    });
+});
