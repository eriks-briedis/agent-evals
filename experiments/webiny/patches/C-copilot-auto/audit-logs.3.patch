@@ -0,0 +1,93 @@
+import { describe, expect, it } from "vitest";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log events", () => {
+    it("records a security action and exposes it through the audit log queries", async () => {
+        const { invoke } = useHandler();
+        const [created] = await invoke({
+            body: {
+                query: /* GraphQL */ `
+                    mutation {
+                        security {
+                            createRole(
+                                data: {
+                                    name: "Audited role"
+                                    slug: "audited-role"
+                                    description: "Test role"
+                                    permissions: []
+                                }
+                            ) {
+                                data {
+                                    id
+                                }
+                                error {
+                                    message
+                                }
+                            }
+                        }
+                    }
+                `
+            }
+        });
+        expect(created.errors).toBeUndefined();
+        expect(created.data.security.createRole.error).toBeNull();
+        const roleId = created.data.security.createRole.data.id;
+
+        const [listed] = await invoke({
+            body: {
+                query: /* GraphQL */ `
+                    query ListAuditLogs($entityId: String!) {
+                        auditLogs {
+                            listAuditLogs(where: { entityId: $entityId }) {
+                                data {
+                                    id
+                                    entityId
+                                    message
+                                }
+                                error {
+                                    message
+                                }
+                            }
+                        }
+                    }
+                `,
+                variables: { entityId: roleId }
+            }
+        });
+        expect(listed.errors).toBeUndefined();
+        expect(listed.data.auditLogs.listAuditLogs.error).toBeNull();
+        expect(listed.data.auditLogs.listAuditLogs.data).toEqual([
+            { id: expect.any(String), entityId: roleId, message: "Role created" }
+        ]);
+        const auditLogId = listed.data.auditLogs.listAuditLogs.data[0].id;
+
+        const [fetched] = await invoke({
+            body: {
+                query: /* GraphQL */ `
+                    query GetAuditLog($id: ID!) {
+                        auditLogs {
+                            getAuditLog(id: $id) {
+                                data {
+                                    id
+                                    entityId
+                                    message
+                                }
+                                error {
+                                    message
+                                }
+                            }
+                        }
+                    }
+                `,
+                variables: { id: auditLogId }
+            }
+        });
+        expect(fetched.errors).toBeUndefined();
+        expect(fetched.data.auditLogs.getAuditLog.error).toBeNull();
+        expect(fetched.data.auditLogs.getAuditLog.data).toEqual({
+            id: auditLogId,
+            entityId: roleId,
+            message: "Role created"
+        });
+    });
+});
