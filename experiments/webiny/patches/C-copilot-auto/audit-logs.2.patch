diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..5ae599f1
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { UserAfterCreateEvent } from "@webiny/api-core/features/users/CreateUser/index.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import type { CmsEntry, CmsModel } from "@webiny/api-headless-cms/types/index.js";
+import type { File } from "@webiny/api-file-manager/domain/file/types.js";
+import type { AdminUser } from "@webiny/api-core/types/users.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log subscriptions", () => {
+    it("records domain events and exposes the logs through GraphQL", async () => {
+        const { handler, invoke } = useHandler();
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+
+        const model = { isPrivate: false } as CmsModel;
+        const identity = { id: "author-1", displayName: "Author", type: "admin" };
+        const original: CmsEntry = {
+            id: "revision-1",
+            entryId: "entry-1",
+            tenant: "root",
+            modelId: "article",
+            version: 1,
+            locked: false,
+            status: "draft",
+            createdOn: "2026-01-01T00:00:00.000Z",
+            savedOn: "2026-01-01T00:00:00.000Z",
+            modifiedOn: null,
+            deletedOn: null,
+            restoredOn: null,
+            firstPublishedOn: null,
+            lastPublishedOn: null,
+            createdBy: identity,
+            savedBy: identity,
+            modifiedBy: null,
+            deletedBy: null,
+            restoredBy: null,
+            firstPublishedBy: null,
+            lastPublishedBy: null,
+            revisionCreatedOn: "2026-01-01T00:00:00.000Z",
+            revisionSavedOn: "2026-01-01T00:00:00.000Z",
+            revisionModifiedOn: null,
+            revisionDeletedOn: null,
+            revisionRestoredOn: null,
+            revisionFirstPublishedOn: null,
+            revisionLastPublishedOn: null,
+            revisionCreatedBy: identity,
+            revisionSavedBy: identity,
+            revisionModifiedBy: null,
+            revisionDeletedBy: null,
+            revisionRestoredBy: null,
+            revisionFirstPublishedBy: null,
+            revisionLastPublishedBy: null,
+            live: null,
+            revisionDescription: undefined,
+            expiresAt: null,
+            values: { title: "Before" }
+        };
+        const entry = { ...original, values: { title: "After" } };
+        const file = { id: "file-1", name: "file.jpg" } as File;
+        const user = { id: "user-1", email: "user@example.com" } as AdminUser;
+
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                model,
+                entry: original,
+                input: { values: original.values }
+            })
+        );
+        await publisher.publish(new EntryAfterUpdateEvent({ model, entry, original, input: {} }));
+        await publisher.publish(new FileAfterCreateEvent({ file }));
+        await publisher.publish(new UserAfterCreateEvent({ user, input: { email: user.email } }));
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                model: { ...model, isPrivate: true },
+                entry,
+                input: { values: entry.values }
+            })
+        );
+
+        const { items } = await context.auditLogs.listAuditLogs({});
+        expect(items).toHaveLength(4);
+        expect(items).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    action: "CREATE",
+                    entityId: "entry-1"
+                }),
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    action: "UPDATE",
+                    entityId: "revision-1"
+                }),
+                expect.objectContaining({
+                    app: "FILE_MANAGER",
+                    action: "CREATE",
+                    entityId: "file-1"
+                }),
+                expect.objectContaining({ app: "SECURITY", action: "CREATE", entityId: "user-1" })
+            ])
+        );
+
+        const id = items!.find(item => item.entityId === "file-1")!.id;
+        const [response] = await invoke({
+            body: {
+                query: `query($id: ID!) {
+                    auditLogs {
+                        listAuditLogs(where: {}) { data { id entityId } error { message } }
+                        getAuditLog(id: $id) { data { id entityId } error { message } }
+                    }
+                }`,
+                variables: { id }
+            }
+        });
+        expect(response.errors).toBeUndefined();
+        expect(response.data.auditLogs.listAuditLogs.error).toBeNull();
+        expect(response.data.auditLogs.listAuditLogs.data).toHaveLength(4);
+        expect(response.data.auditLogs.getAuditLog).toEqual({
+            data: { id, entityId: "file-1" },
+            error: null
+        });
+    });
+});
