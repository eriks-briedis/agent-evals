+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import knexLib from "knex";
+import type { Knex } from "knex";
+import { Container } from "@webiny/feature/api";
+import { ApiCoreStorageOperationsFactory } from "@webiny/api-core";
+import { ApiCoreSqlFeature } from "../src/ApiCoreSqlFeature.js";
+import { TableManager } from "../src/TableManager.js";
+
+describe("SQL core table initialization", () => {
+    let knex: Knex;
+    let queries: string[];
+
+    beforeEach(() => {
+        knex = knexLib({
+            client: "better-sqlite3",
+            connection: { filename: ":memory:" },
+            useNullAsDefault: true
+        });
+        queries = [];
+        knex.on("query", query => queries.push(query.sql));
+    });
+
+    afterEach(async () => {
+        await knex.destroy();
+    });
+
+    it("reuses the registered storage operations across requests", async () => {
+        const container = new Container();
+        ApiCoreSqlFeature.register(container, { knex, tableNamePrefix: "test" });
+        const factory = container.resolve(ApiCoreStorageOperationsFactory);
+        const operations = factory.create();
+
+        await Promise.all(
+            Array.from({ length: 20 }, async () => {
+                const requestOperations = factory.create();
+                expect(requestOperations).toBe(operations);
+                await requestOperations.tenancyStorageOperations.listTenants();
+            })
+        );
+        await factory.create().tenancyStorageOperations.listTenants();
+
+        expect(queries.filter(query => query.includes("sqlite_master"))).toHaveLength(1);
+        expect(queries.filter(query => query.startsWith("create table"))).toHaveLength(1);
+    });
+
+    it("allows two managers to race to create the same table", async () => {
+        const managers = [new TableManager(knex, "test"), new TableManager(knex, "test")];
+        const create = (table: Knex.CreateTableBuilder) => table.text("id");
+
+        await Promise.all(managers.map(manager => manager.ensure("items", create)));
+        expect(await knex.schema.hasTable("test_items")).toBe(true);
+        expect(queries.filter(query => query.startsWith("create table"))).toHaveLength(2);
+    });
+
+    it.each([
+        { code: "42P07", message: 'relation "items" already exists' },
+        {
+            code: "23505",
+            message: "duplicate key value violates unique constraint",
+            constraint: "pg_type_typname_nsp_index"
+        }
+    ])("recognizes PostgreSQL table creation races: $code", async errorInfo => {
+        await knex.schema.createTable("items", table => table.text("id"));
+        const schema = knex.schema;
+        const hasTable = schema.hasTable.bind(schema);
+        vi.spyOn(knex, "schema", "get").mockReturnValue(schema);
+        vi.spyOn(schema, "hasTable")
+            .mockImplementationOnce(() => hasTable("missing"))
+            .mockImplementation(name => hasTable(name));
+        vi.spyOn(schema, "createTable").mockImplementation(() => {
+            throw Object.assign(new Error(errorInfo.message), errorInfo);
+        });
+
+        await expect(
+            new TableManager(knex).ensure("items", table => table.text("id"))
+        ).resolves.toBeUndefined();
+    });
+
+    it("retries after a failed initialization and rechecks after reset", async () => {
+        const manager = new TableManager(knex);
+        const failure = new Error("invalid schema");
+
+        await expect(
+            manager.ensure("items", () => {
+                throw failure;
+            })
+        ).rejects.toBe(failure);
+
+        await manager.ensure("items", table => table.text("id"));
+        await knex.schema.dropTable("items");
+        manager.reset();
+        await manager.ensure("items", table => table.text("id"));
+        expect(await knex.schema.hasTable("items")).toBe(true);
+    });
+
+    it("does not cache an initialization that finishes after reset", async () => {
+        const manager = new TableManager(knex);
+        knex.once("query", () => manager.reset());
+
+        await manager.ensure("items", table => table.text("id"));
+        await manager.ensure("items", table => table.text("id"));
+
+        expect(queries.filter(query => query.includes("sqlite_master"))).toHaveLength(2);
+    });
+
+    it("does not suppress an index creation failure when the table exists", async () => {
+        await knex.schema.createTable("other", table => {
+            table.text("id");
+            table.index("id", "duplicate_index");
+        });
+        const manager = new TableManager(knex);
+
+        await expect(
+            manager.ensure("items", table => {
+                table.text("id");
+                table.index("id", "duplicate_index");
+            })
+        ).rejects.toThrow("index duplicate_index already exists");
+    });
+});
