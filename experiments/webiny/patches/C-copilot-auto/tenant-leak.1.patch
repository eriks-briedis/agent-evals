+                expect(tenantContext.getTenant().id).toBe(expected);
+                return expected;
+            };
+
+            const operation =
+                method === "withTenant"
+                    ? tenantContext.withTenant(otherTenant, callback)
+                    : method === "withRootTenant"
+                      ? tenantContext.withRootTenant(callback)
+                      : tenantContext.withEachTenant([otherTenant], callback);
+
+            try {
+                await started;
+                expect(tenantContext.getTenant()).toBe(requestTenant);
+            } finally {
+                release();
+            }
+            await expect(operation).resolves.toEqual(
+                method === "withEachTenant" ? [expected] : expected
+            );
+            expect(tenantContext.getTenant()).toBe(requestTenant);
+        }
+    );
+
+    it("keeps overlapping and nested scopes independent, including after errors", async () => {
+        const first = createTenant("first", "root");
+        const second = createTenant("second", "root");
+        let release!: () => void;
+        const blocked = new Promise<void>(resolve => (release = resolve));
+
+        const firstOperation = tenantContext.withTenant(first, async () => {
+            await blocked;
+            expect(tenantContext.getTenant()).toBe(first);
+            await expect(
+                tenantContext.withTenant(otherTenant, async () => {
+                    await Promise.resolve();
+                    expect(tenantContext.getTenant()).toBe(otherTenant);
+                    throw new Error("nested failure");
+                })
+            ).rejects.toThrow("nested failure");
+            expect(tenantContext.getTenant()).toBe(first);
+        });
+        const secondOperation = tenantContext.withTenant(second, async () => {
+            await blocked;
+            expect(tenantContext.getTenant()).toBe(second);
+        });
+        expect(tenantContext.getTenant()).toBe(requestTenant);
+        release();
+        await Promise.all([firstOperation, secondOperation]);
+        expect(tenantContext.getTenant()).toBe(requestTenant);
+    });
+
+    it("isolates sibling GraphQL resolvers", async () => {
+        let entered!: () => void;
+        let release!: () => void;
+        const started = new Promise<void>(resolve => (entered = resolve));
+        const blocked = new Promise<void>(resolve => (release = resolve));
+        const result = await graphql({
+            schema: buildSchema("type Query { switched: String! sibling: String! }"),
+            source: "{ switched sibling }",
+            rootValue: {
+                switched: () =>
+                    tenantContext.withRootTenant(async () => {
+                        entered();
+                        await blocked;
+                        return tenantContext.getTenant().id;
+                    }),
+                sibling: async () => {
+                    await started;
+                    const tenant = tenantContext.getTenant().id;
+                    release();
+                    return tenant;
+                }
+            }
+        });
+        expect(result.errors).toBeUndefined();
+        expect(result.data).toEqual({ switched: "root", sibling: "request" });
+        expect(tenantContext.getTenant()).toBe(requestTenant);
+    });
+
+    it("does not restore a stale request tenant when it changes in a sibling", async () => {
+        let release!: () => void;
+        const blocked = new Promise<void>(resolve => (release = resolve));
+        const operation = tenantContext.withTenant(otherTenant, async () => {
+            await blocked;
+            expect(tenantContext.getTenant()).toBe(otherTenant);
+        });
+        const updatedTenant = createTenant("updated", "root");
+        tenantContext.setTenant(updatedTenant);
+        release();
+        await operation;
+        expect(tenantContext.getTenant()).toBe(updatedTenant);
+    });
+
+    it("scopes each tenant sequentially and rejects disabled tenants", async () => {
+        const last = createTenant("last", "root");
+        const seen = await tenantContext.withEachTenant([otherTenant, last], async tenant => {
+            await Promise.resolve();
+            expect(tenantContext.getTenant()).toBe(tenant);
+            return tenant.id;
+        });
+        expect(seen).toEqual(["other", "last"]);
+
+        const disabled = { ...otherTenant, status: "disabled" as const };
+        await expect(tenantContext.withTenant(disabled, async () => {})).rejects.toThrow(
+            "Tenant is disabled"
+        );
+        await expect(tenantContext.withEachTenant([disabled], async () => {})).rejects.toThrow(
+            "Tenant is disabled"
+        );
+        expect(tenantContext.getTenant()).toBe(requestTenant);
+    });
+
+    it("does not apply an override to another context instance", async () => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        const otherContext = container.resolve(TenantContext);
+        otherContext.setTenant(requestTenant);
+
+        await tenantContext.withTenant(otherTenant, async () => {
+            expect(otherContext.getTenant()).toBe(requestTenant);
+            otherContext.setTenant(otherTenant);
+        });
+        expect(tenantContext.getTenant()).toBe(requestTenant);
+        expect(otherContext.getTenant()).toBe(otherTenant);
+    });
+});
