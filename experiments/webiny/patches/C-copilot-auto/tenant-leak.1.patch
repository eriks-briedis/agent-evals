+            const blocked = new Promise<void>(resolve => (release = resolve));
+            const expected = method === "withRootTenant" ? "root" : "other";
+            const callback = async () => {
+                entered();
+                expect(tenantContext.getTenant().id).toBe(expected);
+                await blocked;
+                expect(tenantContext.getTenant().id).toBe(expected);
+                expect(() => tenantContext.setTenant(createTenant("changed", "root"))).toThrow(
+                    /setTenant/
