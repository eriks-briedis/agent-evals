@@ -38,12 +42,66 @@ export class TableManager implements ITableManager {
             return;
         }
 
-        const exists = await this.knex.schema.hasTable(resolved);
-
-        if (!exists) {
-            await this.knex.schema.createTable(resolved, creator);
+        const pending = this.pending.get(resolved);
+        if (pending) {
+            return pending;
         }
 
-        this.verified.add(resolved);
+        const generation = this.generation;
+        const ensureTable = async () => {
+            const exists = await this.knex.schema.hasTable(resolved);
+            if (!exists) {
+                try {
+                    await this.knex.schema.createTable(resolved, creator);
+                } catch (error) {
+                    if (
+                        !isTableAlreadyExistsError(error, resolved) ||
+                        !(await this.knex.schema.hasTable(resolved))
+                    ) {
+                        throw error;
+                    }
+                }
+            }
+
+            if (generation === this.generation) {
+                this.verified.add(resolved);
+            }
+        };
+
+        const operation = ensureTable();
+        this.pending.set(resolved, operation);
+        try {
+            await operation;
+        } finally {
+            if (this.pending.get(resolved) === operation) {
+                this.pending.delete(resolved);
+            }
+        }
     }
 }
+
+const isTableAlreadyExistsError = (error: unknown, tableName: string): boolean => {
+    if (
+        !(error instanceof Error) ||
+        !("code" in error) ||
+        !/^create table\b/i.test(error.message)
+    ) {
+        return false;
+    }
+
+    const escapedName = tableName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+    if (error.code === "SQLITE_ERROR") {
+        return new RegExp(`table ["\`\\[]?${escapedName}["\`\\]]? already exists`, "i").test(
+            error.message
+        );
+    }
+    if (error.code === "42P07") {
+        return error.message.includes(`relation "${tableName}" already exists`);
+    }
+    // PostgreSQL can report a duplicate row type instead when concurrent CREATE TABLEs race.
+    return (
+        error.code === "23505" &&
+        "constraint" in error &&
+        error.constraint === "pg_type_typname_nsp_index"
+    );
+};
