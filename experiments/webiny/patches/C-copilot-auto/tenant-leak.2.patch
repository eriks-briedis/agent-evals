+describe("tenant-scoped callbacks", () => {
+    let tenantContext: TenantContext.Interface;
+    const requestTenant = createTenant("request", "root");
+    const otherTenant = createTenant("other", "root");
+
+    beforeEach(() => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        tenantContext = container.resolve(TenantContext);
+        tenantContext.setTenant(requestTenant);
+    });
+
+    const switches: {
+        name: string;
+        run: (context: TenantContext.Interface, cb: () => Promise<void>) => Promise<unknown>;
+        expected: string[];
+    }[] = [
+        {
+            name: "withTenant",
+            run: (context, cb) => context.withTenant(otherTenant, cb),
+            expected: ["other"]
+        },
+        {
+            name: "withRootTenant",
+            run: (context, cb) => context.withRootTenant(cb),
+            expected: ["root"]
+        },
+        {
+            name: "withEachTenant",
+            run: (context, cb) =>
+                context.withEachTenant([otherTenant, createTenant("another", "root")], cb),
+            expected: ["other", "another"]
+        }
+    ];
+
+    it.each(switches)(
+        "$name isolates a suspended callback from siblings and rejects setTenant",
+        async ({ run, expected }) => {
+            let release!: () => void;
+            const gate = new Promise<void>(resolve => {
+                release = resolve;
+            });
+            let started!: () => void;
+            const entered = new Promise<void>(resolve => {
+                started = resolve;
+            });
+            const seen: string[] = [];
+            const scoped = run(tenantContext, async () => {
+                seen.push(tenantContext.getTenant().id);
+                expect(() => tenantContext.setTenant(createTenant("bad", "root"))).toThrow(
+                    /setTenant/
+                );
+                started();
+                await gate;
+                expect(tenantContext.getTenant().id).toBe(seen[seen.length - 1]);
+            });
+
+            await entered;
+            expect(tenantContext.getTenant()).toBe(requestTenant);
+            const replacement = createTenant("replacement", "root");
+            tenantContext.setTenant(replacement);
+            release();
+            await scoped;
+            expect(seen).toEqual(expected);
+            expect(tenantContext.getTenant()).toBe(replacement);
+        }
+    );
+
+    it("isolates overlapping and nested scopes, including failures", async () => {
+        let release!: () => void;
+        const gate = new Promise<void>(resolve => {
+            release = resolve;
+        });
+        const first = tenantContext.withTenant(otherTenant, async () => {
+            await gate;
+            expect(tenantContext.getTenant()).toBe(otherTenant);
+            await expect(
+                tenantContext.withRootTenant(async () => {
+                    expect(tenantContext.getTenant().id).toBe("root");
+                    await Promise.resolve();
+                    throw new Error("nested failure");
+                })
+            ).rejects.toThrow("nested failure");
+            expect(tenantContext.getTenant()).toBe(otherTenant);
+        });
+        const secondTenant = createTenant("second", "root");
+        const second = tenantContext.withTenant(secondTenant, async () => {
+            await Promise.resolve();
+            expect(tenantContext.getTenant()).toBe(secondTenant);
+            release();
+        });
+
+        await Promise.all([first, second]);
+        expect(tenantContext.getTenant()).toBe(requestTenant);
+    });
+
+    it("keeps overrides local to their TenantContext instance", async () => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        const anotherContext = container.resolve(TenantContext);
+        anotherContext.setTenant(requestTenant);
+
+        await tenantContext.withTenant(otherTenant, async () => {
+            expect(anotherContext.getTenant()).toBe(requestTenant);
+            anotherContext.setTenant(otherTenant);
+        });
+        expect(tenantContext.getTenant()).toBe(requestTenant);
+        expect(anotherContext.getTenant()).toBe(otherTenant);
+    });
+
+    it("rejects disabled installed tenants without running the callback", async () => {
+        const disabled = { ...otherTenant, status: "disabled" as const };
+        let called = false;
+        await expect(
+            tenantContext.withTenant(disabled, async () => {
+                called = true;
+            })
+        ).rejects.toThrow("Tenant is disabled!");
+        await expect(
+            tenantContext.withEachTenant([disabled], async () => {
+                called = true;
+            })
+        ).rejects.toThrow("Tenant is disabled!");
+        expect(called).toBe(false);
+        expect(tenantContext.getTenant()).toBe(requestTenant);
+    });
+});
