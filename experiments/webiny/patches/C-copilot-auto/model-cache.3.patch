@@ -0,0 +1,158 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import type { Container } from "@webiny/di";
+import { IdentityContext } from "@webiny/api-core/exports/api/security.js";
+import { TenantContext } from "@webiny/api-core/exports/api/tenancy.js";
+import type { Tenant } from "@webiny/api-core/types/tenancy.js";
+import { TestPermissions } from "@webiny/api-core-testing";
+import { useHandler } from "~tests/testHelpers/useHandler";
+import { CmsModelPlugin } from "~/plugins/CmsModelPlugin.js";
+import { ModelFactory } from "~/features/modelBuilder/index.js";
+import { ModelCache, ModelsFetcher } from "~/features/contentModel/shared/abstractions.js";
+import { GetModelUseCase } from "~/features/contentModel/GetModel/index.js";
+import { ListModelsUseCase } from "~/features/contentModel/ListModels/index.js";
+
+class TestModelsImpl implements ModelFactory.Interface {
+    async execute(builder: ModelFactory.Builder) {
+        return ["allowedBuilder", "hiddenBuilder"].map(modelId =>
+            builder.public({ modelId, name: modelId, group: "test" })
+        );
+    }
+}
+
+const TestModels = ModelFactory.createImplementation({
+    implementation: TestModelsImpl,
+    dependencies: []
+});
+
+const subTenant: Tenant = {
+    id: "sub-tenant",
+    name: "Sub Tenant",
+    description: "",
+    status: "enabled",
+    isInstalled: true,
+    settings: {} as Tenant["settings"],
+    tags: [],
+    parent: "root",
+    createdOn: new Date().toISOString(),
+    savedOn: new Date().toISOString()
+};
+
+describe("model cache authorization", () => {
+    let container: Container;
+
+    beforeEach(async () => {
+        const { handler } = useHandler({
+            permissions: [
+                { name: "cms.contentModel", _src: "test", rwd: "r", models: ["allowedBuilder"] },
+                { name: "cms.contentModelGroup", _src: "test", rwd: "r", groups: ["test"] }
+            ],
+            plugins: [
+                (c: Container) => c.register(TestModels),
+                new CmsModelPlugin({
+                    noValidate: true,
+                    modelId: "hiddenLegacy",
+                    name: "Hidden Legacy",
+                    group: "test",
+                    tenant: "root",
+                    fields: []
+                })
+            ]
+        });
+        ({ container } = (await handler({
+            path: "/cms/manage",
+            headers: { "x-tenant": "root" }
+        })) as { container: Container });
+        container.resolve(ModelCache).clear();
+    });
+
+    const asSystem = <T>(cb: () => Promise<T>) =>
+        container.resolve(IdentityContext).withoutAuthorization(cb);
+
+    const ids = (models: { modelId: string }[]) => models.map(model => model.modelId);
+
+    it.each(["restricted", "system"])(
+        "keeps plugin models complete and checks access when %s reads first",
+        async first => {
+            const fetcher = container.resolve(ModelsFetcher);
+            const list = container.resolve(ListModelsUseCase);
+            const get = container.resolve(GetModelUseCase);
+
+            const restrictedRead = async () => {
+                const result = await list.execute();
+                expect(result.isOk()).toBe(true);
+                expect(ids(result.value)).toContain("allowedBuilder");
+                expect(ids(result.value)).not.toContain("hiddenBuilder");
+                expect(ids(result.value)).not.toContain("hiddenLegacy");
+                for (const id of ["hiddenBuilder", "hiddenLegacy"]) {
+                    const denied = await get.execute(id);
+                    expect(denied.isFail()).toBe(true);
+                    expect(denied.error.code).toBe("Cms/Model/NotFound");
+                }
+            };
+            const systemRead = async () => {
+                const result = await asSystem(() => fetcher.fetchAll());
+                expect(result.isOk()).toBe(true);
+                expect(ids(result.value)).toEqual(
+                    expect.arrayContaining(["allowedBuilder", "hiddenBuilder", "hiddenLegacy"])
+                );
+                const listed = await asSystem(() => list.execute());
+                expect(ids(listed.value)).toEqual(
+                    expect.arrayContaining(["allowedBuilder", "hiddenBuilder", "hiddenLegacy"])
+                );
+                const withoutPlugins = await asSystem(() =>
+                    list.execute({ includePlugins: false })
+                );
+                expect(ids(withoutPlugins.value)).not.toContain("hiddenBuilder");
+                expect(ids(withoutPlugins.value)).not.toContain("hiddenLegacy");
+                expect((await asSystem(() => get.execute("hiddenBuilder"))).isOk()).toBe(true);
+                expect((await asSystem(() => get.execute("hiddenLegacy"))).isOk()).toBe(true);
+            };
+
+            if (first === "restricted") {
+                await restrictedRead();
+                await systemRead();
+            } else {
+                await systemRead();
+                await restrictedRead();
+            }
+            await restrictedRead();
+            await systemRead();
+        }
+    );
+
+    it("does not cache an anonymous read's filtered plugin models", async () => {
+        container.resolve(TestPermissions).list = [];
+        container.resolve(IdentityContext).setIdentity(undefined);
+        const get = container.resolve(GetModelUseCase);
+        const list = container.resolve(ListModelsUseCase);
+
+        expect((await get.execute("hiddenBuilder")).error.code).toBe("Cms/Model/NotFound");
+        expect((await list.execute()).error.code).toBe("Cms/Model/NotAuthorized");
+
+        const result = await asSystem(() => list.execute());
+        expect(result.isOk()).toBe(true);
+        expect(ids(result.value)).toEqual(
+            expect.arrayContaining(["hiddenBuilder", "hiddenLegacy"])
+        );
+        expect((await get.execute("hiddenBuilder")).error.code).toBe("Cms/Model/NotFound");
+        expect((await list.execute()).error.code).toBe("Cms/Model/NotAuthorized");
+    });
+
+    it("keeps the complete cache tenant-scoped", async () => {
+        const fetcher = container.resolve(ModelsFetcher);
+        await fetcher.fetchAll();
+
+        await container.resolve(TenantContext).withTenant(subTenant, async () => {
+            const result = await asSystem(() => fetcher.fetchAll());
+            expect(result.isOk()).toBe(true);
+            expect(ids(result.value)).toContain("hiddenBuilder");
+            expect(ids(result.value)).not.toContain("hiddenLegacy");
+            expect(result.value.find(model => model.modelId === "hiddenBuilder")?.tenant).toBe(
+                "sub-tenant"
+            );
+        });
+
+        const root = await asSystem(() => fetcher.fetchAll());
+        expect(ids(root.value)).toContain("hiddenLegacy");
+    });
+});
