diff --git a/packages/api-opensearch/__tests__/registries.test.ts b/packages/api-opensearch/__tests__/registries.test.ts
new file mode 100644
index 00000000..6c9eefb3
--- /dev/null
+++ b/packages/api-opensearch/__tests__/registries.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from "vitest";
+import { Container } from "@webiny/di";
+import { OpenSearchIndex } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndex.js";
+import { OpenSearchIndexRegistry } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndexRegistry.js";
+import { OpenSearchIndexFeature } from "~/features/OpenSearchIndex/feature.js";
+import { OpenSearchQueryBuilderOperator } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperator.js";
+import { OpenSearchQueryBuilderOperatorRegistry } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperatorRegistry.js";
+import { OpenSearchQueryBuilderOperatorFeature } from "~/features/OpenSearchQueryBuilderOperator/feature.js";
+
+describe("OpenSearch registries", () => {
+    it("resolves operators registered in each request container without leaking them", () => {
+        const root = new Container();
+        OpenSearchQueryBuilderOperatorFeature.register(root);
+
+        const request = root.createChildContainer();
+        const otherRequest = root.createChildContainer();
+        const customOperator: OpenSearchQueryBuilderOperator.Interface = {
+            getOperator: () => "custom",
+            apply: () => undefined
+        };
+        request.registerInstance(OpenSearchQueryBuilderOperator, customOperator);
+
+        const rootRegistry = root.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        const requestRegistry = request.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        const otherRequestRegistry = otherRequest.resolve(OpenSearchQueryBuilderOperatorRegistry);
+
+        expect(rootRegistry.get("custom")).toBeUndefined();
+        expect(otherRequestRegistry.get("custom")).toBeUndefined();
+        expect(requestRegistry.get("custom")).toBe(customOperator);
+        expect(requestRegistry.get("eq")).toBeDefined();
+        expect(rootRegistry.get("eq")).toBeDefined();
+        expect(otherRequestRegistry.get("eq")).toBeDefined();
+    });
+
+    it("resolves indexes registered in each request container without leaking them", () => {
+        const root = new Container();
+        const builtInIndex: OpenSearchIndex.Interface = {
+            body: {},
+            canUse: () => true
+        };
+        root.registerInstance(OpenSearchIndex, builtInIndex);
+        OpenSearchIndexFeature.register(root);
+
+        const request = root.createChildContainer();
+        const otherRequest = root.createChildContainer();
+        const customIndex: OpenSearchIndex.Interface = {
+            body: {},
+            canUse: () => true
+        };
+        request.registerInstance(OpenSearchIndex, customIndex);
+
+        const rootRegistry = root.resolve(OpenSearchIndexRegistry);
+        const requestRegistry = request.resolve(OpenSearchIndexRegistry);
+        const otherRequestRegistry = otherRequest.resolve(OpenSearchIndexRegistry);
+
+        expect(rootRegistry.getAll()).toEqual([builtInIndex]);
+        expect(otherRequestRegistry.getAll()).toEqual([builtInIndex]);
+        expect(requestRegistry.getAll()).toEqual([builtInIndex, customIndex]);
+        expect(rootRegistry.getLastAdded()).toBe(builtInIndex);
+        expect(requestRegistry.getLastAdded()).toBe(customIndex);
+    });
+});
