+import { describe, expect, it } from "vitest";
+import type { Container } from "@webiny/di";
+import { IdentityContext } from "@webiny/api-core/exports/api/security.js";
+import { TenantContext } from "@webiny/api-core/exports/api/tenancy.js";
+import type { Tenant } from "@webiny/api-core/types/tenancy.js";
+import { GetModelUseCase } from "~/features/contentModel/GetModel/index.js";
+import { ListModelsUseCase } from "~/features/contentModel/ListModels/index.js";
+import { CmsModelPluginInstance, ModelCache } from "~/features/contentModel/shared/abstractions.js";
+import { ModelFactory } from "~/features/modelBuilder/index.js";
+import { CmsModelPlugin } from "~/plugins/CmsModelPlugin.js";
+import { CreateModelStorageOperation } from "~/features/shared/storageOperations/model/CreateModelStorageOperation.js";
+import { DeleteModelStorageOperation } from "~/features/shared/storageOperations/model/DeleteModelStorageOperation.js";
+import { useHandler } from "~tests/testHelpers/useHandler";
+import { createIsolationModel } from "../../storageOperations/tenantIsolation/helpers";
+
+class TestModelsImpl implements ModelFactory.Interface {
+    async execute(builder: ModelFactory.Builder) {
+        return [
+            builder.public({ modelId: "allowedModel", name: "Allowed Model", group: "test" }),
+            builder.public({ modelId: "deniedModel", name: "Denied Model", group: "test" })
+        ];
+    }
+}
+
+const TestModels = ModelFactory.createImplementation({
+    implementation: TestModelsImpl,
+    dependencies: []
+});
+
+const legacyModel = new CmsModelPlugin({
+    modelId: "legacyModel",
+    name: "Legacy Model",
+    group: "test",
+    tenant: "root",
+    fields: [],
+    noValidate: true
+});
+
+const subTenant: Tenant = {
+    id: "sub-tenant",
+    name: "Sub Tenant",
+    description: "",
+    status: "enabled",
+    isInstalled: true,
+    settings: {} as Tenant["settings"],
+    tags: [],
+    parent: "root",
+    createdOn: new Date().toISOString(),
+    savedOn: new Date().toISOString()
+};
+
+const setup = async (permissions: NonNullable<Parameters<typeof useHandler>[0]>["permissions"]) => {
+    const { handler } = useHandler({
+        permissions,
+        plugins: [
+            (container: Container) => {
+                container.register(TestModels);
+                container.registerInstance(CmsModelPluginInstance, legacyModel);
+            }
+        ]
+    });
+    const { container } = (await handler({
+        path: "/cms/manage",
+        headers: { "x-tenant": "root" }
+    })) as { container: Container };
+    container.resolve(ModelCache).clear();
+    return container;
+};
+
+describe("model cache authorization", () => {
+    it.each([false, true])(
+        "filters cached code models for each caller (system first: %s)",
+        async systemFirst => {
+            const container = await setup([
+                { name: "cms.contentModelGroup", rwd: "r", _src: "test" },
+                {
+                    name: "cms.contentModel",
+                    rwd: "r",
+                    models: ["allowedModel"],
+                    _src: "test"
+                }
+            ]);
+            const identity = container.resolve(IdentityContext);
+            const list = () => container.resolve(ListModelsUseCase).execute();
+            const systemList = () => identity.withoutAuthorization(list);
+            const checkedList = async () => {
+                const result = await list();
+                expect(result.isOk()).toBe(true);
+                const ids = result.value.map(model => model.modelId);
+                expect(ids).toContain("allowedModel");
+                expect(ids).not.toContain("deniedModel");
+                expect(ids).not.toContain("legacyModel");
+            };
+            const uncheckedList = async () => {
+                const result = await systemList();
+                expect(result.isOk()).toBe(true);
+                expect(result.value.map(model => model.modelId)).toEqual(
+                    expect.arrayContaining(["allowedModel", "deniedModel", "legacyModel"])
+                );
+            };
+
+            if (systemFirst) {
+                await uncheckedList();
+                await checkedList();
+            } else {
+                await checkedList();
+                await uncheckedList();
+            }
+            await checkedList();
+
+            const get = () => container.resolve(GetModelUseCase).execute("deniedModel");
+            const denied = await get();
+            expect(denied.isFail()).toBe(true);
+            expect(denied.error.code).toBe("Cms/Model/NotFound");
+            expect((await identity.withoutAuthorization(get)).isOk()).toBe(true);
+            expect((await get()).isFail()).toBe(true);
+
+            await container.resolve(TenantContext).withTenant(subTenant, async () => {
+                const result = await systemList();
+                expect(result.isOk()).toBe(true);
+                expect(result.value.map(model => model.modelId)).toContain("deniedModel");
+                expect(result.value.map(model => model.modelId)).not.toContain("legacyModel");
+                expect(result.value.find(model => model.modelId === "deniedModel")?.tenant).toBe(
+                    subTenant.id
+                );
+            });
+        }
+    );
+
+    it("keeps the initial list permission check after a system read", async () => {
+        const container = await setup([]);
+        const identity = container.resolve(IdentityContext);
+        const list = () => container.resolve(ListModelsUseCase).execute();
+        const get = () => container.resolve(GetModelUseCase).execute("legacyModel");
+
+        expect((await get()).isFail()).toBe(true);
+        const systemResult = await identity.withoutAuthorization(list);
+        expect(systemResult.isOk()).toBe(true);
+        expect(systemResult.value.map(model => model.modelId)).toContain("legacyModel");
+        const checkedResult = await list();
+        expect(checkedResult.isFail()).toBe(true);
+        expect(checkedResult.error.code).toBe("Cms/Model/NotAuthorized");
+        expect((await get()).isFail()).toBe(true);
+    });
+
+    it("keeps database models available to system reads and denies restricted callers", async () => {
+        const container = await setup([
+            { name: "cms.contentModelGroup", rwd: "r", _src: "test" },
+            { name: "cms.contentModel", rwd: "r", models: ["allowedModel"], _src: "test" }
+        ]);
+        const model = createIsolationModel("root");
+        await container.resolve(CreateModelStorageOperation).execute({ model });
+        container.resolve(ModelCache).clear();
+        try {
+            const identity = container.resolve(IdentityContext);
+            const list = () => container.resolve(ListModelsUseCase).execute();
+            const get = () => container.resolve(GetModelUseCase).execute(model.modelId);
+
+            const restrictedList = await list();
+            expect(restrictedList.isOk()).toBe(true);
+            expect(restrictedList.value.map(item => item.modelId)).not.toContain(model.modelId);
+            const restrictedGet = await get();
+            expect(restrictedGet.isFail()).toBe(true);
+            expect(restrictedGet.error.code).toBe("Cms/Model/NotAuthorized");
+
+            const systemList = await identity.withoutAuthorization(list);
+            expect(systemList.isOk()).toBe(true);
+            expect(systemList.value.map(item => item.modelId)).toContain(model.modelId);
+            expect((await identity.withoutAuthorization(get)).isOk()).toBe(true);
+            expect((await get()).error.code).toBe("Cms/Model/NotAuthorized");
+        } finally {
+            await container.resolve(DeleteModelStorageOperation).execute({ model });
+            container.resolve(ModelCache).clear();
+        }
+    });
+});
