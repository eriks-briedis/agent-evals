@@ -0,0 +1,76 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { randomUUID } from "node:crypto";
+import { Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+
+const changes = ["created", "updated", "deleted"] as const;
+
+describe("FLP task trigger failures", () => {
+    const { handler } = useHandler();
+
+    beforeEach(() => {
+        vi.clearAllMocks();
+    });
+
+    it.each(["failed result", "thrown error"])(
+        "logs a %s with the folder id without failing any folder change",
+        async failure => {
+            for (const change of changes) {
+                const { container } = await handler();
+                const createFolder = container.resolve(CreateFolderUseCase);
+                const folderInput = {
+                    type: "test",
+                    title: "Test",
+                    slug: `flp-trigger-${randomUUID()}`,
+                    parentId: null
+                };
+
+                let folderId: string;
+                if (change !== "created") {
+                    folderId = (await createFolder.execute(folderInput)).value.id;
+                }
+
+                const error = new Error(`trigger ${failure}`);
+                const trigger = vi.fn(
+                    failure === "failed result"
+                        ? async () => Result.fail(error)
+                        : async () => {
+                              throw error;
+                          }
+                );
+                const logger = { error: vi.fn() };
+
+                container.registerInstance(
+                    TaskService,
+                    { trigger } as unknown as TaskService.Interface
+                );
+                container.registerInstance(Logger, logger as unknown as Logger.Interface);
+
+                if (change === "created") {
+                    const result = await createFolder.execute(folderInput);
+                    expect(result.isOk()).toBe(true);
+                    folderId = result.value.id;
+                } else if (change === "updated") {
+                    const result = await container
+                        .resolve(UpdateFolderUseCase)
+                        .execute(folderId, { title: "Updated" });
+                    expect(result.isOk()).toBe(true);
+                } else {
+                    const result = await container.resolve(DeleteFolderUseCase).execute(folderId);
+                    expect(result.isOk()).toBe(true);
+                }
+
+                expect(logger.error).toHaveBeenCalledWith(
+                    expect.objectContaining({ folderId, error }),
+                    expect.any(String)
+                );
+                expect(trigger).toHaveBeenCalledOnce();
+            }
+        }
+    );
+});
