@@ -0,0 +1,112 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { BaseError, Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { GetFolderRepository } from "~/features/folder/GetFolder/abstractions.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+class TriggerError extends BaseError {
+    readonly code = "Test/TriggerError";
+
+    constructor() {
+        super({ message: "Task trigger failed" });
+    }
+}
+
+describe("FLP task trigger logging", () => {
+    const { handler } = useHandler();
+
+    afterEach(() => {
+        vi.restoreAllMocks();
+    });
+
+    for (const [operation, definition] of [
+        ["create", CREATE_FLP_TASK_ID],
+        ["update", UPDATE_FLP_TASK_ID],
+        ["delete", DELETE_FLP_TASK_ID]
+    ] as const) {
+        for (const outcome of ["failed result", "thrown error", "success"] as const) {
+            it(`${operation}: ${outcome}`, async () => {
+                const { container } = await handler();
+                const logger = {
+                    trace: vi.fn(),
+                    debug: vi.fn(),
+                    info: vi.fn(),
+                    warn: vi.fn(),
+                    error: vi.fn(),
+                    fatal: vi.fn(),
+                    log: vi.fn()
+                };
+                container.registerInstance(Logger, logger);
+                const createFolder = container.resolve(CreateFolderUseCase);
+                const params = {
+                    type: "type",
+                    title: `${operation}-${outcome}`,
+                    slug: `${operation}-${outcome.replace(" ", "-")}`,
+                    parentId: null
+                };
+
+                let folderId: string | undefined;
+                if (operation !== "create") {
+                    const created = await createFolder.execute(params);
+                    expect(created.isOk()).toBe(true);
+                    folderId = created.value.id;
+                }
+                logger.error.mockClear();
+
+                const trigger = vi.spyOn(container.resolve(TaskService), "trigger");
+                const error = new TriggerError();
+                if (outcome === "failed result") {
+                    trigger.mockResolvedValue(Result.fail(error));
+                } else if (outcome === "thrown error") {
+                    trigger.mockRejectedValue(error);
+                }
+
+                if (operation === "create") {
+                    const result = await createFolder.execute(params);
+                    expect(result.isOk()).toBe(true);
+                    folderId = result.value.id;
+                } else if (operation === "update") {
+                    const result = await container.resolve(UpdateFolderUseCase).execute(folderId!, {
+                        title: "Updated"
+                    });
+                    expect(result.isOk()).toBe(true);
+                } else {
+                    const result = await container.resolve(DeleteFolderUseCase).execute(folderId!);
+                    expect(result.isOk()).toBe(true);
+                }
+                expect(trigger).toHaveBeenCalledOnce();
+                expect(trigger).toHaveBeenCalledWith(
+                    expect.objectContaining({
+                        definition,
+                        input: expect.objectContaining({
+                            folder: expect.objectContaining({ id: folderId })
+                        })
+                    })
+                );
+                if (outcome === "success") {
+                    expect(logger.error).not.toHaveBeenCalled();
+                } else {
+                    expect(logger.error).toHaveBeenCalledExactlyOnceWith(
+                        { folderId, error },
+                        `Failed to trigger ${operation} FLP task.`
+                    );
+                }
+
+                const stored = await container.resolve(GetFolderRepository).execute(folderId!);
+                if (operation === "delete") {
+                    expect(stored.isFail()).toBe(true);
+                } else {
+                    expect(stored.isOk()).toBe(true);
+                    expect(stored.value.title).toBe(
+                        operation === "update" ? "Updated" : params.title
+                    );
+                }
+            });
+        }
+    }
+});
