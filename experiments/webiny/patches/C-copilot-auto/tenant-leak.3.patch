+describe("tenant-scoped execution", () => {
+    let tenantContext: TenantContext.Interface;
+    const requestTenant = createTenant("request", "root");
+    const otherTenant = createTenant("other", "root");
+    const switchers = {
+        withTenant: (cb: () => Promise<string>) => tenantContext.withTenant(otherTenant, cb),
+        withRootTenant: (cb: () => Promise<string>) => tenantContext.withRootTenant(cb),
+        withEachTenant: (cb: () => Promise<string>) =>
+            tenantContext.withEachTenant([otherTenant], cb)
+    };
+
+    beforeEach(() => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        tenantContext = container.resolve(TenantContext);
+        tenantContext.setTenant(requestTenant);
+    });
+
+    it.each(["withTenant", "withRootTenant", "withEachTenant"] as const)(
+        "%s isolates an overlapping sibling and rejects setTenant",
+        async method => {
+            let entered!: () => void;
+            let release!: () => void;
+            const started = new Promise<void>(resolve => (entered = resolve));
+            const proceed = new Promise<void>(resolve => (release = resolve));
+            const switched = switchers[method](async () => {
+                entered();
+                await proceed;
+                const before = tenantContext.getTenant().id;
+                expect(() => tenantContext.setTenant(createTenant("changed", "root"))).toThrow(
+                    /setTenant/
+                );
+                return `${before}:${tenantContext.getTenant().id}`;
+            });
+
+            await started;
+            const siblingTenant = tenantContext.getTenant().id;
+            release();
+            const result = await switched;
+            const expected = method === "withRootTenant" ? "root:root" : "other:other";
+            expect(result).toEqual(method === "withEachTenant" ? [expected] : expected);
+            expect(siblingTenant).toBe("request");
+            expect(tenantContext.getTenant().id).toBe("request");
+        }
+    );
+
+    it("isolates overlapping switches and restores nested scopes after errors", async () => {
+        let release!: () => void;
+        const proceed = new Promise<void>(resolve => (release = resolve));
+        const first = tenantContext.withTenant(otherTenant, async () => {
+            await proceed;
+            await expect(
+                tenantContext.withRootTenant(async () => {
+                    expect(tenantContext.getTenant().id).toBe("root");
+                    await tenantContext.withEachTenant(
+                        [createTenant("nested", "root")],
+                        async () => {
+                            expect(tenantContext.getTenant().id).toBe("nested");
+                            throw new Error("nested failure");
+                        }
+                    );
+                })
+            ).rejects.toThrow("nested failure");
+            return tenantContext.getTenant().id;
+        });
+        const second = tenantContext.withTenant(createTenant("second", "root"), async () => {
+            await proceed;
+            return tenantContext.getTenant().id;
+        });
+        const siblingTenant = tenantContext.getTenant().id;
+        release();
+        expect(await Promise.all([first, second])).toEqual(["other", "second"]);
+        expect(siblingTenant).toBe("request");
+        expect(tenantContext.getTenant().id).toBe("request");
+    });
+
+    it("does not undo a sibling's persistent tenant change", async () => {
+        let release!: () => void;
+        const proceed = new Promise<void>(resolve => (release = resolve));
+        const switched = tenantContext.withTenant(otherTenant, async () => {
+            await proceed;
+            return tenantContext.getTenant().id;
+        });
+        tenantContext.setTenant(createTenant("new-request", "root"));
+        release();
+        expect(await switched).toBe("other");
+        expect(tenantContext.getTenant().id).toBe("new-request");
+    });
+
+    it("scopes each iteration and restores the enclosing tenant", async () => {
+        const tenants = [otherTenant, createTenant("second", "root")];
+        const result = await tenantContext.withTenant(createTenant("outer", "root"), async () => {
+            const ids = await tenantContext.withEachTenant(tenants, async () => {
+                await Promise.resolve();
+                return tenantContext.getTenant().id;
+            });
+            expect(tenantContext.getTenant().id).toBe("outer");
+            return ids;
+        });
+        expect(result).toEqual(["other", "second"]);
+        expect(tenantContext.getTenant().id).toBe("request");
+    });
+
+    it("keeps overrides local to their tenant context instance", async () => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        const anotherContext = container.resolve(TenantContext);
+        anotherContext.setTenant(createTenant("another", "root"));
+
+        await tenantContext.withTenant(otherTenant, async () => {
+            expect(anotherContext.getTenant().id).toBe("another");
+            anotherContext.setTenant(createTenant("updated", "root"));
+        });
+        expect(anotherContext.getTenant().id).toBe("updated");
+        expect(tenantContext.getTenant().id).toBe("request");
+    });
+
+    it("rejects disabled tenants without running callbacks or changing the request tenant", async () => {
+        const disabled = { ...otherTenant, status: "disabled" as const };
+        let called = false;
+        const cb = async () => {
+            called = true;
+            return "";
+        };
+        await expect(tenantContext.withTenant(disabled, cb)).rejects.toThrow("Tenant is disabled");
+        await expect(tenantContext.withEachTenant([disabled], cb)).rejects.toThrow(
+            "Tenant is disabled"
+        );
+        expect(called).toBe(false);
+        expect(tenantContext.getTenant().id).toBe("request");
+    });
+});
+
