@@ -0,0 +1,134 @@
+import { describe, it, expect, vi } from "vitest";
+import { Result } from "@webiny/feature/api";
+import { CreateFlpOnFolderCreatedHandler } from "~/features/flp/CreateFlpOnFolderCreated/CreateFlpOnFolderCreatedHandler.js";
+import { UpdateFlpOnFolderUpdatedHandler } from "~/features/flp/UpdateFlpOnFolderUpdated/UpdateFlpOnFolderUpdatedHandler.js";
+import { DeleteFlpOnFolderDeletedHandler } from "~/features/flp/DeleteFlpOnFolderDeleted/DeleteFlpOnFolderDeletedHandler.js";
+import { CreateFlpTask } from "~/flp/tasks/createFlp.task.js";
+import { UpdateFlpTask } from "~/flp/tasks/updateFlp.task.js";
+import { DeleteFlpTask } from "~/flp/tasks/deleteFlp.task.js";
+
+const folder = { id: "f1", type: "type1", slug: "slug1", parentId: null } as any;
+const event = { payload: { folder } } as any;
+const identityContext = { getIdentity: () => ({ id: "admin" }) } as any;
+
+const createLogger = () => ({
+    trace: vi.fn(),
+    debug: vi.fn(),
+    info: vi.fn(),
+    warn: vi.fn(),
+    error: vi.fn(),
+    fatal: vi.fn(),
+    log: vi.fn()
+});
+
+const failure = { message: "boom", code: "TRIGGER_FAILED" } as any;
+
+const handlers = [
+    {
+        name: "create",
+        operation: "create",
+        make: (tasks: any, logger: any) =>
+            new (CreateFlpOnFolderCreatedHandler as any)(identityContext, tasks, logger)
+    },
+    {
+        name: "update",
+        operation: "update",
+        make: (tasks: any, logger: any) =>
+            new (UpdateFlpOnFolderUpdatedHandler as any)(identityContext, tasks, logger)
+    },
+    {
+        name: "delete",
+        operation: "delete",
+        make: (tasks: any, logger: any) =>
+            new (DeleteFlpOnFolderDeletedHandler as any)(tasks, logger)
+    }
+];
+
+describe("FLP failure logging", () => {
+    describe.each(handlers)("$name handler", ({ make, operation }) => {
+        const expectLogged = (logger: ReturnType<typeof createLogger>) => {
+            expect(logger.error).toHaveBeenCalledTimes(1);
+            const logged = JSON.stringify(logger.error.mock.calls[0]);
+            expect(logged).toContain(operation);
+            expect(logged).toContain("f1");
+            expect(logged).toContain("type1");
+            expect(logged).toContain("slug1");
+            expect(logged).toContain("boom");
+            expect(logged).toContain("TRIGGER_FAILED");
+        };
+
+        it("logs a failed trigger result", async () => {
+            const logger = createLogger();
+            const tasks = { trigger: vi.fn().mockResolvedValue(Result.fail(failure)) };
+            await make(tasks, logger).handle(event);
+            expectLogged(logger);
+        });
+
+        it("logs a thrown trigger error and still resolves", async () => {
+            const logger = createLogger();
+            const tasks = { trigger: vi.fn().mockRejectedValue(failure) };
+            await expect(make(tasks, logger).handle(event)).resolves.toBeUndefined();
+            expectLogged(logger);
+        });
+
+        it("does not log on success", async () => {
+            const logger = createLogger();
+            const tasks = { trigger: vi.fn().mockResolvedValue(Result.ok({})) };
+            await make(tasks, logger).handle(event);
+            expect(logger.error).not.toHaveBeenCalled();
+        });
+    });
+
+    const taskCases = [
+        { name: "create", task: CreateFlpTask, operation: "create", deps: [{ execute: fail }, {}] },
+        {
+            name: "update",
+            task: UpdateFlpTask,
+            operation: "update",
+            deps: [{ execute: fail }, {}]
+        },
+        { name: "delete", task: DeleteFlpTask, operation: "delete", deps: [{ execute: fail }] }
+    ];
+
+    function fail() {
+        return Promise.reject(failure);
+    }
+
+    const createController = (logger: any) => ({
+        logger,
+        runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+        response: { error: vi.fn(e => ({ error: e })), done: vi.fn(), continue: vi.fn() }
+    });
+
+    describe.each(taskCases)("$name task", ({ task, operation, deps }) => {
+        it("logs a failed run through the task logger", async () => {
+            const logger = createLogger();
+            const controller = createController(logger);
+            const handler = new (task as any)().handler;
+            const instance = new (handler as any)(...deps);
+            await instance.run({ input: { folder }, controller });
+            expect(controller.response.error).toHaveBeenCalled();
+            expect(logger.error).toHaveBeenCalledTimes(1);
+            const logged = JSON.stringify(logger.error.mock.calls[0]);
+            expect(logged).toContain(operation);
+            expect(logged).toContain("f1");
+            expect(logged).toContain("boom");
+        });
+    });
+
+    it("logs at info when the update task continues after a timeout", async () => {
+        const logger = createLogger();
+        const controller = createController(logger);
+        const handler = new (UpdateFlpTask as any)().handler;
+        const updateFlp = {
+            execute: async (p: any) => p.handleTimeout(["a", "b"])
+        };
+        const instance = new (handler as any)(updateFlp, {});
+        await instance.run({ input: { folder }, controller });
+        expect(controller.response.continue).toHaveBeenCalled();
+        expect(logger.info).toHaveBeenCalledTimes(1);
+        const logged = JSON.stringify(logger.info.mock.calls[0]);
+        expect(logged).toContain("f1");
+        expect(logged).toContain("2");
+    });
+});
