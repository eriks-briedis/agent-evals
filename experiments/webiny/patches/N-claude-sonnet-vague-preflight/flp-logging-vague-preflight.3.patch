+import { describe, it, expect, vi } from "vitest";
+import { Container } from "@webiny/di";
+import { Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/abstractions.js";
+import { FolderAfterCreateEventHandler } from "~/features/folder/CreateFolder/abstractions.js";
+import { FolderAfterCreateEvent } from "~/features/folder/CreateFolder/events.js";
+import { FolderAfterUpdateEvent } from "~/features/folder/UpdateFolder/events.js";
+import { FolderAfterUpdateEventHandler } from "~/features/folder/UpdateFolder/index.js";
+import { FolderAfterDeleteEventHandler } from "~/features/folder/DeleteFolder/abstractions.js";
+import { FolderAfterDeleteEvent } from "~/features/folder/DeleteFolder/events.js";
+import { CreateFlpOnFolderCreatedHandler } from "~/features/flp/CreateFlpOnFolderCreated/CreateFlpOnFolderCreatedHandler.js";
+import { UpdateFlpOnFolderUpdatedHandler } from "~/features/flp/UpdateFlpOnFolderUpdated/UpdateFlpOnFolderUpdatedHandler.js";
+import { DeleteFlpOnFolderDeletedHandler } from "~/features/flp/DeleteFlpOnFolderDeleted/DeleteFlpOnFolderDeletedHandler.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { NotifyFolderChangeUseCase } from "~/features/folder/NotifyFolderChange/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { CreateFlpTask } from "~/flp/tasks/createFlp.task.js";
+import { UpdateFlpTask } from "~/flp/tasks/updateFlp.task.js";
+import { DeleteFlpTask } from "~/flp/tasks/deleteFlp.task.js";
+
+const folder: any = {
+  id: "folder-1",
+  type: "type",
+  slug: "f",
+  parentId: null,
+  permissions: [],
+};
+
+const createLogger = () => ({
+  trace: vi.fn(),
+  debug: vi.fn(),
+  info: vi.fn(),
+  warn: vi.fn(),
+  error: vi.fn(),
+  fatal: vi.fn(),
+  log: vi.fn(),
+});
+
+const logged = (fn: ReturnType<typeof vi.fn>) =>
+  JSON.stringify(fn.mock.calls, (_, v) => (v instanceof Error ? v.message : v));
+
+describe("FLP logging: handlers", () => {
+  const cases = [
+    {
+      name: "create",
+      handler: CreateFlpOnFolderCreatedHandler,
+      abstraction: FolderAfterCreateEventHandler,
+      event: new FolderAfterCreateEvent({ folder } as any),
+    },
+    {
+      name: "update",
+      handler: UpdateFlpOnFolderUpdatedHandler,
+      abstraction: FolderAfterUpdateEventHandler,
+      event: new FolderAfterUpdateEvent({ folder } as any),
+    },
+    {
+      name: "delete",
+      handler: DeleteFlpOnFolderDeletedHandler,
+      abstraction: FolderAfterDeleteEventHandler,
+      event: new FolderAfterDeleteEvent({ folder } as any),
+    },
+  ];
+
+  const failures = {
+    "trigger throws": () => Promise.reject(new Error("boom-throw")),
+    "trigger returns a failed result": () =>
+      Promise.resolve(Result.fail(new Error("boom-fail"))),
+  };
+
+  for (const c of cases) {
+    for (const [label, trigger] of Object.entries(failures)) {
+      it(`${c.name}: should log when ${label}, and not throw`, async () => {
+        const logger = createLogger();
+        const container = new Container();
+        container.registerInstance(Logger, logger as any);
+        container.registerInstance(TaskService, { trigger } as any);
+        container.registerInstance(IdentityContext, {
+          getIdentity: () => ({ id: "x" }),
+        } as any);
+        container.register(c.handler as any);
+
+        const instance: any = container.resolve(c.abstraction as any);
+        await expect(instance.handle(c.event)).resolves.toBeUndefined();
+
+        expect(logger.error).toHaveBeenCalledTimes(1);
+        const out = logged(logger.error);
+        expect(out).toContain("folder-1");
+        expect(out).toContain(c.name);
+        expect(out).toContain("boom-");
+      });
+    }
+  }
+});
+
+describe("FLP logging: tasks", () => {
+  const makeController = (opts: { closeToTimeout?: boolean } = {}) => ({
+    runtime: {
+      isAborted: () => false,
+      isCloseToTimeout: () => !!opts.closeToTimeout,
+    },
+    response: {
+      error: vi.fn((e: any) => ({ status: "error", e })),
+      continue: vi.fn((i: any) => ({ status: "continue", i })),
+      done: vi.fn(() => ({ status: "done" })),
+      aborted: vi.fn(),
+    },
+    logger: { info: vi.fn(), error: vi.fn() },
+  });
+
+  const build = (definition: any, deps: [any, any][]) => {
+    const container = new Container();
+    for (const [abstraction, instance] of deps) {
+      container.registerInstance(abstraction, instance);
+    }
+    const handler = new definition().handler;
+    return container.resolveImplementation(handler);
+  };
+
+  const tasks: any[] = [
+    {
+      name: "create",
+      def: CreateFlpTask,
+      deps: [
+        [
+          CreateFlpUseCase,
+          { execute: () => Promise.reject(new Error("boom-task")) },
+        ],
+        [NotifyFolderChangeUseCase, { execute: vi.fn() }],
+      ],
+    },
+    {
+      name: "update",
+      def: UpdateFlpTask,
+      deps: [
+        [
+          UpdateFlpUseCase,
+          { execute: () => Promise.reject(new Error("boom-task")) },
+        ],
+        [NotifyFolderChangeUseCase, { execute: vi.fn() }],
+      ],
+    },
+    {
+      name: "delete",
+      def: DeleteFlpTask,
+      deps: [
+        [
+          DeleteFlpUseCase,
+          { execute: () => Promise.reject(new Error("boom-task")) },
+        ],
+      ],
+    },
+  ];
+
+  for (const t of tasks) {
+    it(`${t.name}: should log when the task ends in error`, async () => {
+      const controller = makeController();
+      const handler: any = build(t.def, t.deps);
+      await handler.run({ input: { folder }, controller });
+
+      expect(controller.response.error).toHaveBeenCalled();
+      expect(controller.logger.error).toHaveBeenCalledTimes(1);
+      const out = logged(controller.logger.error);
+      expect(out).toContain("folder-1");
+      expect(out).toContain("boom-task");
+    });
+  }
+
+  for (const name of ["create", "delete"]) {
+    it(`${name}: should log when handing over because of a timeout`, async () => {
+      const t = tasks.find((x) => x.name === name);
+      const controller = makeController({ closeToTimeout: true });
+      const handler: any = build(t.def, t.deps);
+      await handler.run({ input: { folder }, controller });
+
+      expect(controller.response.continue).toHaveBeenCalled();
+      expect(controller.logger.info).toHaveBeenCalledTimes(1);
+      expect(logged(controller.logger.info)).toContain("folder-1");
+    });
+  }
+
+  it("update: should log when handing over because of a timeout", async () => {
+    const t = tasks.find((x) => x.name === "update");
+    const controller = makeController();
+    const deps: [any, any][] = [
+      [
+        UpdateFlpUseCase,
+        { execute: async (p: any) => p.handleTimeout(["done-1"]) },
+      ],
+      [NotifyFolderChangeUseCase, { execute: vi.fn() }],
+    ];
+    const handler: any = build(t.def, deps);
+    await handler.run({ input: { folder }, controller });
+
+    expect(controller.response.continue).toHaveBeenCalled();
+    expect(controller.logger.info).toHaveBeenCalledTimes(1);
+    expect(logged(controller.logger.info)).toContain("folder-1");
+  });
+});
