diff --git a/packages/api-aco/src/features/flp/shared/logFlpFailure.ts b/packages/api-aco/src/features/flp/shared/logFlpFailure.ts
new file mode 100644
index 00000000..92b16153
--- /dev/null
+++ b/packages/api-aco/src/features/flp/shared/logFlpFailure.ts
@@ -0,0 +1,37 @@
+import type { Logger } from "@webiny/api-core/features/logger/index.js";
+
+export type FlpOperation = "create" | "update" | "delete";
+
+export interface LogFlpFailureParams {
+    operation: FlpOperation;
+    // Where it went wrong: handing the work to a background task, or the task itself running.
+    stage: "trigger" | "task";
+    folder?: { id: string; type?: string } | null;
+    error: unknown;
+}
+
+/*
+ * A folder change goes through even when its FLP record cannot be written, which leaves the folder
+ * with wrong permissions. Each place that gives up on the record reports it here, in one shape, so
+ * the logs show when it happened, for which folder and why.
+ */
+export const logFlpFailure = (logger: Logger.Interface, params: LogFlpFailureParams): void => {
+    const { operation, stage, folder, error } = params;
+    const err = (error ?? {}) as { message?: string; code?: string; data?: unknown; stack?: string };
+
+    logger.error(
+        {
+            operation,
+            stage,
+            folderId: folder?.id,
+            folderType: folder?.type,
+            error: {
+                message: err.message ?? String(error),
+                code: err.code,
+                data: err.data,
+                stack: err.stack
+            }
+        },
+        `FLP ${operation} failed (${stage}): the folder's permission record may be missing or stale.`
+    );
+};
