@@ -0,0 +1,132 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { Container } from "@webiny/di";
+import { Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/abstractions.js";
+import { FolderAfterCreateEventHandler } from "~/features/folder/CreateFolder/abstractions.js";
+import { FolderAfterUpdateEventHandler } from "~/features/folder/UpdateFolder/index.js";
+import { FolderAfterDeleteEventHandler } from "~/features/folder/DeleteFolder/abstractions.js";
+import { CreateFlpOnFolderCreatedHandler } from "~/features/flp/CreateFlpOnFolderCreated/CreateFlpOnFolderCreatedHandler.js";
+import { UpdateFlpOnFolderUpdatedHandler } from "~/features/flp/UpdateFlpOnFolderUpdated/UpdateFlpOnFolderUpdatedHandler.js";
+import { DeleteFlpOnFolderDeletedHandler } from "~/features/flp/DeleteFlpOnFolderDeleted/DeleteFlpOnFolderDeletedHandler.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { NotifyFolderChangeUseCase } from "~/features/folder/NotifyFolderChange/index.js";
+import { CreateFlpTask } from "~/flp/tasks/createFlp.task.js";
+import { UpdateFlpTask } from "~/flp/tasks/updateFlp.task.js";
+import { DeleteFlpTask } from "~/flp/tasks/deleteFlp.task.js";
+
+const folder: any = { id: "folder-1", type: "type1", slug: "f1", parentId: null, permissions: [] };
+
+const createLogger = () => ({
+    trace: vi.fn(),
+    debug: vi.fn(),
+    info: vi.fn(),
+    warn: vi.fn(),
+    error: vi.fn(),
+    fatal: vi.fn(),
+    log: vi.fn()
+});
+
+const expectLogged = (logger: ReturnType<typeof createLogger>, code: string) => {
+    expect(logger.error).toHaveBeenCalledTimes(1);
+    const [obj, message] = logger.error.mock.calls[0];
+    expect(typeof message).toBe("string");
+    expect(obj.folderId).toBe("folder-1");
+    expect(obj.folderType).toBe("type1");
+    expect(obj.error.code).toBe(code);
+    expect(obj.error.message).toBeTruthy();
+};
+
+describe("FLP failure logging", () => {
+    let logger: ReturnType<typeof createLogger>;
+    let container: Container;
+    const trigger = vi.fn();
+
+    beforeEach(() => {
+        vi.clearAllMocks();
+        logger = createLogger();
+        container = new Container();
+        container.registerInstance(Logger, logger);
+        container.registerInstance(IdentityContext, { getIdentity: () => ({ id: "i1" }) } as any);
+        container.registerInstance(TaskService, { trigger } as any);
+    });
+
+    const failedResult = () => Result.fail(Object.assign(new Error("trigger boom"), { code: "TRIGGER_FAIL" }));
+    const thrown = () => Object.assign(new Error("trigger threw"), { code: "TRIGGER_THROW" });
+
+    const handlers = [
+        ["create", CreateFlpOnFolderCreatedHandler, FolderAfterCreateEventHandler],
+        ["update", UpdateFlpOnFolderUpdatedHandler, FolderAfterUpdateEventHandler],
+        ["delete", DeleteFlpOnFolderDeletedHandler, FolderAfterDeleteEventHandler]
+    ] as const;
+
+    describe.each(handlers)("%s handler", (_name, impl, abstraction) => {
+        it("logs a failed trigger Result and does not throw", async () => {
+            trigger.mockResolvedValue(failedResult());
+            container.register(impl);
+            const handler: any = container.resolve(abstraction as any);
+            await expect(handler.handle({ payload: { folder } })).resolves.toBeUndefined();
+            expectLogged(logger, "TRIGGER_FAIL");
+        });
+
+        it("logs a thrown trigger error and does not throw", async () => {
+            trigger.mockRejectedValue(thrown());
+            container.register(impl);
+            const handler: any = container.resolve(abstraction as any);
+            await expect(handler.handle({ payload: { folder } })).resolves.toBeUndefined();
+            expectLogged(logger, "TRIGGER_THROW");
+        });
+
+        it("logs nothing on success", async () => {
+            trigger.mockResolvedValue(Result.ok({}));
+            container.register(impl);
+            const handler: any = container.resolve(abstraction as any);
+            await handler.handle({ payload: { folder } });
+            expect(logger.error).not.toHaveBeenCalled();
+        });
+    });
+
+    const runTask = async (task: any, input: any, failWith: Error | null) => {
+        const failing = { execute: vi.fn(async () => { if (failWith) { throw failWith; } }) };
+        container.registerInstance(CreateFlpUseCase, failing as any);
+        container.registerInstance(UpdateFlpUseCase, failing as any);
+        container.registerInstance(DeleteFlpUseCase, failing as any);
+        container.registerInstance(NotifyFolderChangeUseCase, { execute: vi.fn() } as any);
+        container.register(task);
+        const definition = container.resolve(TaskDefinition);
+        const handler: any = container.resolveImplementation(definition.handler);
+        const controller = {
+            runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+            response: {
+                done: (message: string) => ({ status: "done", message }),
+                continue: (i: unknown) => ({ status: "continue", input: i }),
+                error: (error: unknown) => ({ status: "error", error }),
+                aborted: () => ({ status: "aborted" })
+            }
+        };
+        return handler.run({ input, definition, controller });
+    };
+
+    describe.each([
+        ["create", CreateFlpTask],
+        ["update", UpdateFlpTask],
+        ["delete", DeleteFlpTask]
+    ] as const)("%s task", (_name, task) => {
+        it("logs the failure and still returns an error response", async () => {
+            const error = Object.assign(new Error("use case boom"), { code: "USE_CASE_FAIL" });
+            const result = await runTask(task, { folder }, error);
+            expect(result.status).toBe("error");
+            expectLogged(logger, "USE_CASE_FAIL");
+        });
+
+        it("logs nothing on success", async () => {
+            const result = await runTask(task, { folder }, null);
+            expect(result.status).toBe("done");
+            expect(logger.error).not.toHaveBeenCalled();
+        });
+    });
+});
