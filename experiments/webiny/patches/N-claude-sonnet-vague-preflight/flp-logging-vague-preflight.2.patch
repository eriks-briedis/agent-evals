diff --git a/packages/api-aco/src/utils/describeError.ts b/packages/api-aco/src/utils/describeError.ts
new file mode 100644
index 00000000..0bdb0415
--- /dev/null
+++ b/packages/api-aco/src/utils/describeError.ts
@@ -0,0 +1,11 @@
+/**
+ * Error instances serialize to `{}` in structured logs, so the reason would be lost. This returns
+ * a plain object with the parts worth reading.
+ */
+export const describeError = (error: unknown) => {
+    if (error instanceof Error) {
+        const { code, data } = error as Error & { code?: string; data?: unknown };
+        return { message: error.message, code, data, stack: error.stack };
+    }
+    return { message: String(error) };
+};
