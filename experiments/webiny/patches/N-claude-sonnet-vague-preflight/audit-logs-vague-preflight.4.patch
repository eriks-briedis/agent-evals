--- /dev/null
+++ b/packages/api-audit-logs/__tests__/eventSubscriptions.test.ts
@@ -0,0 +1,52 @@
+import { describe, expect, it } from "vitest";
+import { useHandler } from "~tests/helpers/useHandler.js";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { UserAfterUpdateEvent } from "@webiny/api-core/features/users/UpdateUser/index.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+
+const isSql = process.env.WEBINY_STORAGE?.includes("sql");
+
+describe.skipIf(isSql)("audit logs created from domain events", () => {
+    const publish = async (event: any) => {
+        const { handler } = useHandler();
+        const context = await handler();
+        await context.container.resolve(EventPublisher).publish(event);
+        return context;
+    };
+
+    const list = async (context: any) => {
+        const result = await context.auditLogs.listAuditLogs({ limit: 50, sort: "DESC" });
+        return result.items;
+    };
+
+    it("user update is logged", async () => {
+        const context = await publish(
+            new UserAfterUpdateEvent({
+                originalUser: { id: "u1", email: "a@a.com" },
+                updatedUser: { id: "u1", email: "b@a.com" }
+            } as any)
+        );
+        const items = await list(context);
+        expect(items.map((i: any) => i.entityId)).toContain("u1");
+    });
+
+    it("file create is logged", async () => {
+        const context = await publish(
+            new FileAfterCreateEvent({ file: { id: "f1", name: "x.png" } } as any)
+        );
+        const items = await list(context);
+        expect(items.map((i: any) => i.entityId)).toContain("f1");
+    });
+
+    it("cms entry create is logged", async () => {
+        const context = await publish(
+            new EntryAfterCreateEvent({
+                model: { isPrivate: false, modelId: "m" },
+                entry: { id: "e1#0001", entryId: "e1" }
+            } as any)
+        );
+        const items = await list(context);
+        expect(items.map((i: any) => i.entityId)).toContain("e1");
+    });
+});
