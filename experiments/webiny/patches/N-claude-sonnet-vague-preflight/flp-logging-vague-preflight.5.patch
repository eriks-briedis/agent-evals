+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,164 @@
+import { describe, it, expect, beforeEach, vi } from "vitest";
+import { Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import {
+    CREATE_FLP_TASK_ID,
+    DELETE_FLP_TASK_ID,
+    UPDATE_FLP_TASK_ID,
+    SYNC_FLP_TASK_ID
+} from "~/flp/tasks/index.js";
+import type { Folder } from "~/folder/folder.types";
+
+const createLogger = () => ({
+    trace: vi.fn(),
+    debug: vi.fn(),
+    info: vi.fn(),
+    warn: vi.fn(),
+    error: vi.fn(),
+    fatal: vi.fn(),
+    log: vi.fn()
+});
+
+const folderInput = { title: "F", type: "type1", slug: "f", parentId: null };
+
+const errorCalls = (logger: ReturnType<typeof createLogger>) => logger.error.mock.calls;
+
+describe("FLP logging", () => {
+    beforeEach(() => {
+        vi.clearAllMocks();
+    });
+
+    describe.each(["throws", "fails"] as const)("when triggering the FLP task %s", mode => {
+        const setup = async () => {
+            const { handler } = useHandler();
+            const context = await handler();
+            const create = context.container.resolve(CreateFolderUseCase);
+            // Create the folder with the working task service first.
+            const created = await create.execute(folderInput);
+            const folder = created.value as Folder;
+
+            const logger = createLogger();
+            context.container.registerInstance(Logger, logger as any);
+            context.container.registerInstance(TaskService, {
+                trigger: async () => {
+                    if (mode === "throws") {
+                        throw new Error("boom");
+                    }
+                    return Result.fail(new Error("boom") as any);
+                }
+            } as any);
+            return { context, logger, folder };
+        };
+
+        it("logs for a created folder", async () => {
+            const { context, logger } = await setup();
+            const result = await context.container
+                .resolve(CreateFolderUseCase)
+                .execute({ ...folderInput, slug: "g" });
+            expect(result.isOk()).toBe(true);
+
+            expect(errorCalls(logger)).toHaveLength(1);
+            expect(JSON.stringify(errorCalls(logger)[0])).toContain("boom");
+            expect(JSON.stringify(errorCalls(logger)[0])).toContain(CREATE_FLP_TASK_ID);
+        });
+
+        it("logs for an updated folder", async () => {
+            const { context, logger, folder } = await setup();
+            const result = await context.container
+                .resolve(UpdateFolderUseCase)
+                .execute(folder.id, { title: "New" });
+            expect(result.isOk()).toBe(true);
+
+            expect(errorCalls(logger)).toHaveLength(1);
+            const logged = JSON.stringify(errorCalls(logger)[0]);
+            expect(logged).toContain("boom");
+            expect(logged).toContain(UPDATE_FLP_TASK_ID);
+            expect(logged).toContain(folder.id);
+        });
+
+        it("logs for a deleted folder", async () => {
+            const { context, logger, folder } = await setup();
+            const result = await context.container.resolve(DeleteFolderUseCase).execute(folder.id);
+            expect(result.isOk()).toBe(true);
+
+            expect(errorCalls(logger)).toHaveLength(1);
+            const logged = JSON.stringify(errorCalls(logger)[0]);
+            expect(logged).toContain("boom");
+            expect(logged).toContain(DELETE_FLP_TASK_ID);
+            expect(logged).toContain(folder.id);
+        });
+    });
+
+    describe("when the FLP task itself fails", () => {
+        const missingParent = {
+            id: "folder-1",
+            title: "Orphan",
+            slug: "orphan",
+            type: "type1",
+            parentId: "does-not-exist",
+            permissions: []
+        } as unknown as Folder;
+
+        const run = async (taskId: string, input: Record<string, any>) => {
+            const { handler } = useHandler();
+            const context = await handler();
+            const logger = createLogger();
+            context.container.registerInstance(Logger, logger as any);
+
+            const definition = context.container
+                .resolveAll(TaskDefinition)
+                .find(candidate => candidate.id === taskId)!;
+            const taskHandler = context.container.resolveImplementation(definition.handler);
+            const error = vi.fn((e: unknown) => ({ status: "error", error: e }));
+            const controller = {
+                runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                response: { error, done: vi.fn(), continue: vi.fn(), aborted: vi.fn() },
+                logger: createLogger(),
+                task: { trigger: vi.fn() }
+            };
+            await taskHandler.run({ input, definition, controller } as never);
+            return { logger, error };
+        };
+
+        it("logs a failed create task", async () => {
+            const { logger, error } = await run(CREATE_FLP_TASK_ID, {
+                folder: missingParent
+            });
+            expect(error).toHaveBeenCalled();
+            expect(errorCalls(logger)).toHaveLength(1);
+            const logged = JSON.stringify(errorCalls(logger)[0]);
+            expect(logged).toContain("folder-1");
+            expect(logged).toContain("PARENT_FLP_NOT_FOUND");
+        });
+
+        it("logs a failed update task", async () => {
+            const { logger, error } = await run(UPDATE_FLP_TASK_ID, {
+                folder: missingParent
+            });
+            expect(error).toHaveBeenCalled();
+            expect(errorCalls(logger)).toHaveLength(1);
+            expect(JSON.stringify(errorCalls(logger)[0])).toContain("folder-1");
+        });
+
+        it("logs a failed delete task", async () => {
+            const { logger, error } = await run(DELETE_FLP_TASK_ID, {
+                folder: undefined
+            });
+            expect(error).toHaveBeenCalled();
+            expect(errorCalls(logger)).toHaveLength(1);
+            expect(JSON.stringify(errorCalls(logger)[0])).toContain("ERROR_DELETE_FLP_USE_CASE");
+        });
+
+        it("logs a failed sync task", async () => {
+            const { logger, error } = await run(SYNC_FLP_TASK_ID, {});
+            expect(error).toHaveBeenCalled();
+            expect(errorCalls(logger)).toHaveLength(1);
+        });
+    });
+});
