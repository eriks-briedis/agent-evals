+const cache = new WeakMap<Knex, Map<string, ApiCoreStorageOperations>>();
+
 export const createApiCoreSql = ({
     knex,
     tableNamePrefix
 }: CreateApiCoreSqlParams): ApiCoreStorageOperations => {
+    let byPrefix = cache.get(knex);
+    if (!byPrefix) {
+        byPrefix = new Map();
+        cache.set(knex, byPrefix);
+    }
+    const key = tableNamePrefix ?? "";
+    let operations = byPrefix.get(key);
+    if (!operations) {
+        operations = build({ knex, tableNamePrefix });
+        byPrefix.set(key, operations);
+    }
+    return operations;
+};
