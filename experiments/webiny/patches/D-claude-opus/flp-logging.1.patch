@@ -0,0 +1,104 @@
+import { describe, it, expect } from "vitest";
+import type { Container } from "@webiny/di";
+import { BaseError, Result } from "@webiny/feature/api";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CREATE_FLP_TASK_ID, DELETE_FLP_TASK_ID, UPDATE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+class TriggerFailedError extends BaseError {
+    public readonly code = "TRIGGER_FAILED";
+
+    constructor() {
+        super({ message: "Could not trigger the task." });
+    }
+}
+
+interface LoggedError {
+    obj: any;
+    msg: unknown;
+}
+
+const noop = () => {};
+
+const recordingLogger = (errors: LoggedError[]): Logger.Interface => ({
+    trace: noop,
+    debug: noop,
+    info: noop,
+    warn: noop,
+    log: noop,
+    fatal: noop,
+    error: (obj: any, msg?: unknown) => {
+        errors.push({ obj, msg });
+    }
+});
+
+const failingTasks = (mode: "result" | "throw"): TaskService.Interface => ({
+    trigger: async () => {
+        if (mode === "throw") {
+            throw new Error("Task service is down.");
+        }
+        return Result.fail(new TriggerFailedError());
+    },
+    abort: async () => Result.fail(new TriggerFailedError()),
+    fetchServiceInfo: async () => Result.fail(new TriggerFailedError())
+});
+
+/*
+ * A folder's FLP records are written by a background task. When the task cannot be triggered the
+ * folder change still goes through, but the failure must be logged, or the folder is left with
+ * missing or stale permissions and nobody knows why.
+ */
+describe.each(["result", "throw"] as const)(
+    "FLP task trigger failure (%s) is logged",
+    mode => {
+        const { handler } = useHandler();
+
+        const setup = async () => {
+            const context = await handler();
+            const container: Container = context.container;
+            const errors: LoggedError[] = [];
+            container.registerInstance(TaskService, failingTasks(mode));
+            container.registerInstance(Logger, recordingLogger(errors));
+            return { container, errors };
+        };
+
+        it("should create, update and delete the folder and log each failure", async () => {
+            const { container, errors } = await setup();
+
+            const created = await container.resolve(CreateFolderUseCase).execute({
+                type: "type",
+                title: `trigger-failure-${mode}`,
+                slug: `trigger-failure-${mode}`,
+                parentId: null
+            });
+            expect(created.isOk()).toBe(true);
+            const folder = created.value;
+
+            const updated = await container
+                .resolve(UpdateFolderUseCase)
+                .execute(folder.id, { title: `trigger-failure-${mode}-renamed` });
+            expect(updated.isOk()).toBe(true);
+
+            const deleted = await container.resolve(DeleteFolderUseCase).execute(folder.id);
+            expect(deleted.isOk()).toBe(true);
+
+            const expectedErr =
+                mode === "throw" ? "Task service is down." : "Could not trigger the task.";
+            expect(errors.map(({ obj }) => obj.taskDefinition)).toEqual([
+                CREATE_FLP_TASK_ID,
+                UPDATE_FLP_TASK_ID,
+                DELETE_FLP_TASK_ID
+            ]);
+            for (const { obj, msg } of errors) {
+                expect(obj.folderId).toBe(folder.id);
+                expect(obj.err).toBeInstanceOf(Error);
+                expect(obj.err.message).toBe(expectedErr);
+                expect(typeof msg).toBe("string");
+            }
+        });
+    }
+);
