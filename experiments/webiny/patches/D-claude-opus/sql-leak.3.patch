+        // Share the in-flight check/create between concurrent callers of this manager, so they
+        // don't race each other into "table already exists". Cleared on settle; on failure a
+        // later call retries.
+        let promise = this.pending.get(resolved);
+        if (!promise) {
+            promise = this.doEnsure(resolved, creator).finally(() => {
+                if (this.pending.get(resolved) === promise) {
+                    this.pending.delete(resolved);
+                }
+            });
+            this.pending.set(resolved, promise);
+        }
+        return promise;
+    }
+
+    private async doEnsure(
+        resolved: string,
+        creator: (table: Knex.CreateTableBuilder) => void
+    ): Promise<void> {
