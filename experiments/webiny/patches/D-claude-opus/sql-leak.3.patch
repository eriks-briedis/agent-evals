--- a/packages/api-core-sql/src/ApiCoreSqlFeature.ts
+++ b/packages/api-core-sql/src/ApiCoreSqlFeature.ts
@@ -1,5 +1,6 @@
 import { createFeature } from "@webiny/feature/api";
 import type { Knex } from "knex";
+import type { ApiCoreStorageOperations } from "@webiny/api-core/types/core.js";
 import { ApiCoreStorageOperationsFactory } from "@webiny/api-core";
 import { createApiCoreSql } from "./createApiCoreSql.js";
 
@@ -11,12 +12,23 @@ export interface ApiCoreSqlConfig {
 /**
  * Registers the SQL implementation of ApiCoreStorageOperationsFactory. ApiCoreFeature.register
  * resolves + builds it. Mirrors ApiCoreDdbFeature.
+ *
+ * The factory is registered once (root container) but `create()` is called on every request, so
+ * the storage operations are built lazily once and reused. Building them per request would create
+ * a new TableManager each time — leaking memory and re-checking table existence on every request.
  */
 export const ApiCoreSqlFeature = createFeature<ApiCoreSqlConfig>({
     name: "ApiCoreSql",
     register(container, { knex, tableNamePrefix }) {
+        let storageOperations: ApiCoreStorageOperations | undefined;
+
         container.registerInstance(ApiCoreStorageOperationsFactory, {
-            create: () => createApiCoreSql({ knex, tableNamePrefix })
+            create: () => {
+                if (!storageOperations) {
+                    storageOperations = createApiCoreSql({ knex, tableNamePrefix });
+                }
+                return storageOperations;
+            }
         });
     }
 });
