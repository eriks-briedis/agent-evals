+++ b/packages/api-core-sql/__tests__/storageOperationsSingleton.test.ts
@@ -0,0 +1,70 @@
+import { describe, it, expect } from "vitest";
+import knexLib from "knex";
+import { ApiCoreStorageOperationsFactory } from "@webiny/api-core";
+import { ApiCoreSqlFeature } from "~/ApiCoreSqlFeature.js";
+import { TableManager } from "~/TableManager.js";
+
+const createKnex = () =>
+    knexLib({
+        client: "better-sqlite3",
+        connection: { filename: ":memory:" },
+        useNullAsDefault: true,
+        pool: { min: 1, max: 1 }
+    });
+
+const managerCount = () =>
+    ((globalThis as Record<string, unknown>).__sqlTableManagers as unknown[] | undefined)
+        ?.length ?? 0;
+
+describe("api-core-sql storage operations", () => {
+    it("factory returns the same storage operations and creates no extra TableManagers", () => {
+        const knex = createKnex();
+        // Minimal container: captures the instance the feature registers for the factory.
+        const instances = new Map<unknown, unknown>();
+        const container = {
+            registerInstance: (abstraction: unknown, instance: unknown) =>
+                instances.set(abstraction, instance)
+        };
+        ApiCoreSqlFeature.register(container as any, { knex, tableNamePrefix: "singleton" });
+        const factory = instances.get(
+            ApiCoreStorageOperationsFactory
+        ) as ApiCoreStorageOperationsFactory.Interface;
+
+        const first = factory.create();
+        const before = managerCount();
+        for (let i = 0; i < 100; i++) {
+            expect(factory.create()).toBe(first);
+        }
+        expect(managerCount()).toBe(before);
+        return knex.destroy();
+    });
+
+    it("concurrent ensure() on one manager creates the table once", async () => {
+        const knex = createKnex();
+        const manager = new TableManager(knex, "conc");
+        let creates = 0;
+        await Promise.all(
+            Array.from({ length: 20 }, () =>
+                manager.ensure("items", table => {
+                    creates++;
+                    table.text("id").primary();
+                })
+            )
+        );
+        expect(creates).toBe(1);
+        expect(await knex.schema.hasTable("conc_items")).toBe(true);
+        await knex.destroy();
+    });
+
+    it("two managers racing to create the same table both succeed", async () => {
+        const knex = createKnex();
+        const a = new TableManager(knex, "race");
+        const b = new TableManager(knex, "race");
+        const creator = (table: any) => table.text("id").primary();
+        await expect(
+            Promise.all([a.ensure("items", creator), b.ensure("items", creator)])
+        ).resolves.toBeDefined();
+        expect(await knex.schema.hasTable("race_items")).toBe(true);
+        await knex.destroy();
+    });
+});
diff --git a/packages/api-core-sql/src/ApiCoreSqlFeature.ts b/packages/api-core-sql/src/ApiCoreSqlFeature.ts
