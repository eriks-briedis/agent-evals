+
+export class TenantSwitchInScopeError extends BaseError {
+    override readonly code = "Tenancy/TenantSwitchInScope" as const;
+
+    constructor() {
+        super({
+            message:
+                "Cannot call setTenant() inside withTenant(), withRootTenant() or withEachTenant(). " +
+                "Use a nested withTenant() call to run code in another tenant."
+        });
+    }
