diff --git a/packages/api-core/__tests__/tenancy/tenantContext.test.ts b/packages/api-core/__tests__/tenancy/tenantContext.test.ts
index 6891fe89..3c9f5b08 100644
--- a/packages/api-core/__tests__/tenancy/tenantContext.test.ts
