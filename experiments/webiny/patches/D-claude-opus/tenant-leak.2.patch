@@ -125,3 +125,131 @@ describe("TenantContext with no tenant set", () => {
         expect(tenantContext.getTenant()).toBeNull();
     });
 });
+
+/*
+ * A temporary tenant switch must be visible only to the code running inside its callback. Sibling
+ * work in the same request (e.g. other fields of the same GraphQL query) keeps seeing the request's
+ * own tenant.
+ */
+describe("TenantContext temporary switches are scoped to their callback", () => {
+    let tenantContext: TenantContext.Interface;
+
+    const tick = (ms = 5) => new Promise(resolve => setTimeout(resolve, ms));
+
+    beforeEach(() => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        tenantContext = container.resolve(TenantContext);
+        tenantContext.setTenant(createTenant("sub", "root"));
+    });
+
+    it("withTenant does not leak into concurrently running work", async () => {
+        const seen: string[] = [];
+        const switched = tenantContext.withTenant(createTenant("other", "root"), async () => {
+            await tick(20);
+            return tenantContext.getTenant().id;
+        });
+        const sibling = (async () => {
+            for (let i = 0; i < 3; i++) {
+                seen.push(tenantContext.getTenant().id);
+                await tick();
+            }
+        })();
+
+        const [inside] = await Promise.all([switched, sibling]);
+        expect(inside).toBe("other");
+        expect(seen).toEqual(["sub", "sub", "sub"]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("withRootTenant does not leak into concurrently running work", async () => {
+        const seen: string[] = [];
+        const switched = tenantContext.withRootTenant(async () => {
+            await tick(20);
+            return tenantContext.getTenant().id;
+        });
+        const sibling = (async () => {
+            for (let i = 0; i < 3; i++) {
+                await tick();
+                seen.push(tenantContext.getTenant().id);
+            }
+        })();
+
+        const [inside] = await Promise.all([switched, sibling]);
+        expect(inside).toBe("root");
+        expect(seen).toEqual(["sub", "sub", "sub"]);
+    });
+
+    it("withEachTenant does not leak into concurrently running work", async () => {
+        const seen: string[] = [];
+        const switched = tenantContext.withEachTenant(
+            [createTenant("a", "root"), createTenant("b", "root")],
+            async () => {
+                await tick(10);
+                return tenantContext.getTenant().id;
+            }
+        );
+        const sibling = (async () => {
+            for (let i = 0; i < 4; i++) {
+                await tick();
+                seen.push(tenantContext.getTenant().id);
+            }
+        })();
+
+        const [inside] = await Promise.all([switched, sibling]);
+        expect(inside).toEqual(["a", "b"]);
+        expect(seen).toEqual(["sub", "sub", "sub", "sub"]);
+    });
+
+    it("concurrent switches each see their own tenant, and nesting works", async () => {
+        const [a, b] = await Promise.all([
+            tenantContext.withTenant(createTenant("a", "root"), async () => {
+                await tick(10);
+                const nested = await tenantContext.withTenant(
+                    createTenant("a1", "a"),
+                    async () => {
+                        await tick();
+                        return tenantContext.getTenant().id;
+                    }
+                );
+                return [tenantContext.getTenant().id, nested];
+            }),
+            tenantContext.withTenant(createTenant("b", "root"), async () => {
+                await tick();
+                return [tenantContext.getTenant().id];
+            })
+        ]);
+
+        expect(a).toEqual(["a", "a1"]);
+        expect(b).toEqual(["b"]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("rejects setTenant inside a callback and leaves the request's tenant unchanged", async () => {
+        await expect(
+            tenantContext.withTenant(createTenant("other", "root"), async () => {
+                tenantContext.setTenant(createTenant("evil", "root"));
+            })
+        ).rejects.toMatchObject({ code: "Tenancy/TenantSwitchInScope" });
+
+        await expect(
+            tenantContext.withRootTenant(async () => {
+                tenantContext.setTenant(createTenant("evil", "root"));
+            })
+        ).rejects.toMatchObject({ code: "Tenancy/TenantSwitchInScope" });
+
+        await expect(
+            tenantContext.withEachTenant([createTenant("a", "root")], async () => {
+                tenantContext.setTenant(createTenant("evil", "root"));
+            })
+        ).rejects.toMatchObject({ code: "Tenancy/TenantSwitchInScope" });
+
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("still allows setTenant outside of any callback", async () => {
+        await tenantContext.withTenant(createTenant("other", "root"), async () => undefined);
+        tenantContext.setTenant(createTenant("next", "root"));
+        expect(tenantContext.getTenant().id).toBe("next");
+    });
+});
