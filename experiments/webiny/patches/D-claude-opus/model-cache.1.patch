@@ -0,0 +1,111 @@
+import { describe, expect, it } from "vitest";
+import type { Container } from "@webiny/di";
+import { useHandler } from "~tests/testHelpers/useHandler";
+import type { PermissionsArg } from "~tests/testHelpers/helpers";
+import { GetModelUseCase } from "~/features/contentModel/GetModel/index.js";
+import { ListModelsUseCase } from "~/features/contentModel/ListModels/index.js";
+import { ModelFactory } from "~/features/modelBuilder/index.js";
+import { IdentityContext } from "@webiny/api-core/exports/api/security.js";
+
+const PUBLIC_MODEL_ID = "modelCacheIdentityPublic";
+
+class TestModelImpl implements ModelFactory.Interface {
+    public async execute(builder: ModelFactory.Builder) {
+        return [
+            builder
+                .public({
+                    modelId: PUBLIC_MODEL_ID,
+                    name: "Model Cache Identity Public",
+                    singularApiName: "ModelCacheIdentityPublic",
+                    pluralApiName: "ModelCacheIdentityPublics",
+                    group: "test"
+                })
+                .fields(fields => ({
+                    title: fields.text().label("Title")
+                }))
+        ];
+    }
+}
+
+const TestModel = ModelFactory.createImplementation({
+    implementation: TestModelImpl,
+    dependencies: []
+});
+
+const createContainer = async (permissions: PermissionsArg[]) => {
+    const { handler } = useHandler({
+        permissions,
+        plugins: [(c: Container) => c.register(TestModel)]
+    });
+    const { container } = (await handler({
+        path: "/cms/manage",
+        headers: { "x-tenant": "root" }
+    })) as { container: Container };
+    return container;
+};
+
+/*
+ * The model list is cached per tenant for the whole request. It must not depend on which identity
+ * triggered the first fetch: a denied, permission-checked read must not hide code-defined models
+ * from code that later runs under `withoutAuthorization` in the same request.
+ */
+describe("content model cache and identity", () => {
+    it("a denied read does not hide code-defined models from withoutAuthorization reads", async () => {
+        const container = await createContainer([]);
+        const identityContext = container.resolve(IdentityContext);
+        const getModel = container.resolve(GetModelUseCase);
+        const listModels = container.resolve(ListModelsUseCase);
+
+        // 1. A permission-checked read by an identity without CMS permissions runs first.
+        const denied = await getModel.execute(PUBLIC_MODEL_ID);
+        expect(denied.isFail()).toBe(true);
+
+        // 2. Reads under `withoutAuthorization` must see every model of the tenant.
+        const systemGet = await identityContext.withoutAuthorization(() =>
+            getModel.execute(PUBLIC_MODEL_ID)
+        );
+        expect(systemGet.isOk()).toBe(true);
+        expect(systemGet.value.modelId).toBe(PUBLIC_MODEL_ID);
+
+        const systemList = await identityContext.withoutAuthorization(() =>
+            listModels.execute()
+        );
+        expect(systemList.isOk()).toBe(true);
+        expect(systemList.value.map(m => m.modelId)).toContain(PUBLIC_MODEL_ID);
+
+        // 3. Permission-checked reads keep denying access afterwards.
+        const deniedAgain = await getModel.execute(PUBLIC_MODEL_ID);
+        expect(deniedAgain.isFail()).toBe(true);
+
+        const deniedList = await listModels.execute();
+        expect(deniedList.isFail()).toBe(true);
+    });
+
+    it("an identity restricted to other models does not see code-defined models it cannot access", async () => {
+        const container = await createContainer([
+            { name: "cms.endpoint.manage" },
+            { name: "cms.contentModelGroup", rwd: "r", groups: { root: ["someOtherGroup"] } },
+            { name: "cms.contentModel", rwd: "r", models: { root: ["someOtherModel"] } }
+        ] as PermissionsArg[]);
+        const identityContext = container.resolve(IdentityContext);
+        const getModel = container.resolve(GetModelUseCase);
+        const listModels = container.resolve(ListModelsUseCase);
+
+        const list = await listModels.execute();
+        expect(list.isOk()).toBe(true);
+        expect(list.value.map(m => m.modelId)).not.toContain(PUBLIC_MODEL_ID);
+
+        expect((await getModel.execute(PUBLIC_MODEL_ID)).isFail()).toBe(true);
+
+        const systemList = await identityContext.withoutAuthorization(() =>
+            listModels.execute()
+        );
+        expect(systemList.isOk()).toBe(true);
+        expect(systemList.value.map(m => m.modelId)).toContain(PUBLIC_MODEL_ID);
+
+        // Still filtered for the identity after the system read populated nothing new.
+        const listAgain = await listModels.execute();
+        expect(listAgain.isOk()).toBe(true);
+        expect(listAgain.value.map(m => m.modelId)).not.toContain(PUBLIC_MODEL_ID);
+    });
+});
