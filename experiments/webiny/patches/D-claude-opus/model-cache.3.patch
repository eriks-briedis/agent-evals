+import { beforeEach, describe, expect, it } from "vitest";
+import type { Container } from "@webiny/di";
+import { useHandler } from "~tests/testHelpers/useHandler";
+import { GetModelUseCase } from "~/features/contentModel/GetModel/index.js";
+import { ListModelsUseCase } from "~/features/contentModel/ListModels/index.js";
+import { ModelCache } from "~/features/contentModel/shared/abstractions.js";
+import { ModelFactory } from "~/features/modelBuilder/index.js";
+import { CmsModelPlugin } from "~/plugins/CmsModelPlugin.js";
+import { createModelField } from "~/utils/createModelField.js";
+import { IdentityContext } from "@webiny/api-core/exports/api/security.js";
+
+const BUILDER_MODEL_ID = "modelCacheBuilderModel";
+const LEGACY_MODEL_ID = "modelCacheLegacyModel";
+
+class BuilderModelImpl implements ModelFactory.Interface {
+    public async execute(builder: ModelFactory.Builder) {
+        return [
+            builder
+                .public({
+                    modelId: BUILDER_MODEL_ID,
+                    name: "Model Cache Builder Model",
+                    group: "group",
+                    singularApiName: "ModelCacheBuilderModel",
+                    pluralApiName: "ModelCacheBuilderModels"
+                })
+                .fields(fields => ({
+                    title: fields.text().label("Title")
+                }))
+        ];
+    }
+}
+
+const BuilderModel = ModelFactory.createImplementation({
+    implementation: BuilderModelImpl,
+    dependencies: []
+});
+
+const legacyModelPlugin = new CmsModelPlugin({
+    name: "Model Cache Legacy Model",
+    modelId: LEGACY_MODEL_ID,
+    singularApiName: "ModelCacheLegacyModel",
+    pluralApiName: "ModelCacheLegacyModels",
+    group: "group",
+    fields: [
+        createModelField({
+            id: "title",
+            fieldId: "title",
+            type: "text",
+            label: "Title"
+        })
+    ],
+    layout: [["title"]],
+    titleFieldId: "title",
+    description: ""
+});
+
+/*
+ * The model list is cached per tenant. If access control were applied while building that list,
+ * whichever identity made the first call in a request would decide which models everyone else
+ * (including code running under `withoutAuthorization`) gets to see.
+ */
+describe("content model cache vs. identity", () => {
+    let container: Container;
+
+    beforeEach(async () => {
+        const { handler } = useHandler({
+            // An identity without any CMS permissions.
+            permissions: [],
+            plugins: [(c: Container) => c.register(BuilderModel), legacyModelPlugin]
+        });
+        ({ container } = (await handler({
+            path: "/cms/manage",
+            headers: { "x-tenant": "root" }
+        })) as { container: Container });
+
+        // Make sure nothing from handler bootstrapping has primed the cache.
+        container.resolve(ModelCache).clear();
+    });
+
+    const asSystem = <T>(cb: () => Promise<T>) =>
+        container.resolve(IdentityContext).withoutAuthorization(cb);
+
+    it("returns all code-defined models under withoutAuthorization after a denied read", async () => {
+        // 1. A permission-checked read by a low-privilege identity happens first.
+        const deniedList = await container.resolve(ListModelsUseCase).execute();
+        expect(deniedList.isFail()).toBe(true);
+        expect(deniedList.error.code).toBe("Cms/Model/NotAuthorized");
+
+        const deniedGet = await container.resolve(GetModelUseCase).execute(BUILDER_MODEL_ID);
+        expect(deniedGet.isFail()).toBe(true);
+        expect(deniedGet.error.code).toBe("Cms/Model/NotAuthorized");
+
+        // 2. Code running under `withoutAuthorization` must still see every model.
+        const list = await asSystem(() => container.resolve(ListModelsUseCase).execute());
+        expect(list.isOk()).toBe(true);
+        const modelIds = list.value.map(model => model.modelId);
+        expect(modelIds).toContain(BUILDER_MODEL_ID);
+        expect(modelIds).toContain(LEGACY_MODEL_ID);
+
+        for (const modelId of [BUILDER_MODEL_ID, LEGACY_MODEL_ID]) {
+            const result = await asSystem(() => container.resolve(GetModelUseCase).execute(modelId));
+            expect(result.isOk()).toBe(true);
+            expect(result.value.modelId).toBe(modelId);
+        }
+    });
+
+    it("keeps denying permission-checked reads after a withoutAuthorization read", async () => {
+        // 1. A system read fills the cache with every model.
+        const list = await asSystem(() => container.resolve(ListModelsUseCase).execute());
+        expect(list.isOk()).toBe(true);
+
+        // 2. The low-privilege identity still gets denied.
+        const deniedList = await container.resolve(ListModelsUseCase).execute();
+        expect(deniedList.isFail()).toBe(true);
+        expect(deniedList.error.code).toBe("Cms/Model/NotAuthorized");
+
+        for (const modelId of [BUILDER_MODEL_ID, LEGACY_MODEL_ID]) {
+            const result = await container.resolve(GetModelUseCase).execute(modelId);
+            expect(result.isFail()).toBe(true);
+            expect(result.error.code).toBe("Cms/Model/NotAuthorized");
+        }
+    });
+});
