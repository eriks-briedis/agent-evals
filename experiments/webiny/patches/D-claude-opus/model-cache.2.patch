+import { beforeEach, describe, expect, it } from "vitest";
+import type { Container } from "@webiny/di";
+import { useHandler } from "~tests/testHelpers/useHandler";
+import { GetModelUseCase } from "~/features/contentModel/GetModel/index.js";
+import { ListModelsUseCase } from "~/features/contentModel/ListModels/index.js";
+import { ModelFactory } from "~/features/modelBuilder/index.js";
+import { IdentityContext } from "@webiny/api-core/exports/api/security.js";
+
+const TEST_MODEL_ID = "modelCacheIdentityTest";
+
+class TestModelImpl implements ModelFactory.Interface {
+    public async execute(builder: ModelFactory.Builder) {
+        return [
+            builder
+                // A public model: unlike private models, it is subject to model permissions.
+                .public({
+                    modelId: TEST_MODEL_ID,
+                    name: "Model Cache Identity Test",
+                    group: "test",
+                    singularApiName: "ModelCacheIdentityTest",
+                    pluralApiName: "ModelCacheIdentityTests"
+                })
+                .fields(fields => ({
+                    title: fields.text().label("Title")
+                }))
+        ];
+    }
+}
+
+const TestModel = ModelFactory.createImplementation({
+    implementation: TestModelImpl,
+    dependencies: []
+});
+
+/*
+ * Models are cached per tenant for the duration of a request. The cached list must not depend on
+ * the identity that happened to trigger the first fetch: a low-privilege read must not hide
+ * code-defined models from later `withoutAuthorization` code, and a system read must not expose
+ * models to the low-privilege identity.
+ */
+describe("model cache and identity", () => {
+    let container: Container;
+
+    beforeEach(async () => {
+        const { handler } = useHandler({
+            // Low-privilege identity: no CMS permissions at all.
+            permissions: [],
+            plugins: [(c: Container) => c.register(TestModel)]
+        });
+        ({ container } = (await handler({
+            path: "/cms/manage",
+            headers: { "x-tenant": "root" }
+        })) as { container: Container });
+    });
+
+    const asSystem = <T>(cb: () => Promise<T>) =>
+        container.resolve(IdentityContext).withoutAuthorization(cb);
+
+    it("returns code-defined models under withoutAuthorization after a denied read", async () => {
+        // Permission-checked read first: populates the model cache under the low-privilege identity.
+        const denied = await container.resolve(GetModelUseCase).execute(TEST_MODEL_ID);
+        expect(denied.isFail()).toBe(true);
+        expect(denied.error.code).toBe("Cms/Model/NotAuthorized");
+
+        const deniedList = await container.resolve(ListModelsUseCase).execute();
+        expect(deniedList.isFail()).toBe(true);
+
+        // System reads must still see every model of the tenant.
+        const model = await asSystem(() =>
+            container.resolve(GetModelUseCase).execute(TEST_MODEL_ID)
+        );
+        expect(model.isOk()).toBe(true);
+        expect(model.value.modelId).toBe(TEST_MODEL_ID);
+
+        const list = await asSystem(() => container.resolve(ListModelsUseCase).execute());
+        expect(list.isOk()).toBe(true);
+        expect(list.value.map(m => m.modelId)).toContain(TEST_MODEL_ID);
+    });
+
+    it("keeps denying the low-privilege identity after a system read", async () => {
+        const model = await asSystem(() =>
+            container.resolve(GetModelUseCase).execute(TEST_MODEL_ID)
+        );
+        expect(model.isOk()).toBe(true);
+
+        const denied = await container.resolve(GetModelUseCase).execute(TEST_MODEL_ID);
+        expect(denied.isFail()).toBe(true);
+        expect(denied.error.code).toBe("Cms/Model/NotAuthorized");
+
+        const deniedList = await container.resolve(ListModelsUseCase).execute();
+        expect(deniedList.isFail()).toBe(true);
+    });
+});
