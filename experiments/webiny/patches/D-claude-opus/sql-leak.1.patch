@@ -0,0 +1,74 @@
+import { describe, expect, it } from "vitest";
+import knexLib, { type Knex } from "knex";
+import { Container } from "@webiny/feature/api";
+import { ApiCoreStorageOperationsFactory } from "@webiny/api-core";
+import { ApiCoreSqlFeature } from "~/ApiCoreSqlFeature.js";
+import { TableManager } from "~/TableManager.js";
+
+const createKnex = (): Knex => {
+    return knexLib({
+        client: "better-sqlite3",
+        connection: { filename: ":memory:" },
+        useNullAsDefault: true
+    });
+};
+
+const managerCount = () => {
+    return ((globalThis as Record<string, unknown>).__sqlTableManagers as unknown[] | undefined)
+        ?.length ?? 0;
+};
+
+const creator = (table: Knex.CreateTableBuilder) => {
+    table.text("id").primary().notNullable();
+};
+
+describe("SQL core storage operations caching", () => {
+    it("factory returns the same storage operations without creating new TableManagers", async () => {
+        const knex = createKnex();
+        try {
+            const container = new Container();
+            ApiCoreSqlFeature.register(container, { knex, tableNamePrefix: "cache_test" });
+            const factory = container.resolve(ApiCoreStorageOperationsFactory);
+
+            const first = factory.create();
+            const before = managerCount();
+
+            for (let i = 0; i < 100; i++) {
+                expect(factory.create()).toBe(first);
+            }
+            expect(managerCount()).toBe(before);
+        } finally {
+            await knex.destroy();
+        }
+    });
+
+    it("concurrent first use of the same table via one manager succeeds", async () => {
+        const knex = createKnex();
+        try {
+            const manager = new TableManager(knex, "concurrent_one");
+            await Promise.all(
+                Array.from({ length: 20 }, () => manager.ensure("things", creator))
+            );
+            expect(await knex.schema.hasTable(manager.resolve("things"))).toBe(true);
+        } finally {
+            await knex.destroy();
+        }
+    });
+
+    it("two managers racing to create the same table both succeed", async () => {
+        const knex = createKnex();
+        try {
+            const a = new TableManager(knex, "concurrent_two");
+            const b = new TableManager(knex, "concurrent_two");
+            await Promise.all([
+                a.ensure("things", creator),
+                b.ensure("things", creator),
+                a.ensure("things", creator),
+                b.ensure("things", creator)
+            ]);
+            expect(await knex.schema.hasTable(a.resolve("things"))).toBe(true);
+        } finally {
+            await knex.destroy();
+        }
+    });
+});
