+/**
+ * Lazily creates tables and remembers which ones are known to exist.
+ *
+ * Instances are meant to be long-lived (one per Knex client + table prefix, see `createApiCoreSql`)
+ * so the existence check runs once per table per process, not once per request.
+ */
 export class TableManager implements ITableManager {
     private readonly knex: Knex;
     private readonly prefix: string;
     private readonly verified = new Set<string>();
+    private readonly pending = new Map<string, Promise<void>>();
+    /**
+     * Bumped on reset() so an ensure() that was in flight during a reset does not mark its table
+     * as verified afterwards (the table may have been dropped in the meantime).
+     */
+    private generation = 0;
 
     constructor(knex: Knex, prefix: string = "") {
         this.knex = knex;
         this.prefix = prefix ? `${prefix}_` : "";
 
+        // Test hook: test setups drop all tables between tests and call reset() on every registered
+        // manager. Managers are cached per Knex client + prefix, so this list does not grow per request.
         const g = globalThis as Record<string, unknown>;
         const managers = (g.__sqlTableManagers ??= []) as ITableManager[];
         managers.push(this);
     }
 
     public reset(): void {
+        this.generation++;
         this.verified.clear();
+        this.pending.clear();
     }
 
     public resolve(tableName: string): string {
@@ -38,12 +54,46 @@ export class TableManager implements ITableManager {
             return;
         }
 
-        const exists = await this.knex.schema.hasTable(resolved);
+        // Share a single in-flight check/create between concurrent callers of this manager.
+        const inFlight = this.pending.get(resolved);
+        if (inFlight) {
+            return inFlight;
+        }
 
-        if (!exists) {
-            await this.knex.schema.createTable(resolved, creator);
+        const generation = this.generation;
+        const promise = this.createIfMissing(resolved, creator)
+            .then(() => {
+                if (this.generation === generation) {
+                    this.verified.add(resolved);
+                }
+            })
+            .finally(() => {
+                if (this.pending.get(resolved) === promise) {
+                    this.pending.delete(resolved);
+                }
+            });
+
+        this.pending.set(resolved, promise);
+        return promise;
+    }
+
+    private async createIfMissing(
+        resolved: string,
+        creator: (table: Knex.CreateTableBuilder) => void
+    ): Promise<void> {
+        if (await this.knex.schema.hasTable(resolved)) {
+            return;
         }
 
-        this.verified.add(resolved);
+        try {
+            await this.knex.schema.createTable(resolved, creator);
+        } catch (ex) {
+            // Another manager / process may have created the table between our check and create.
+            // That is a success for us; anything else is a real failure.
+            if (await this.knex.schema.hasTable(resolved)) {
+                return;
+            }
+            throw ex;
+        }
     }
 }
diff --git a/packages/api-core-sql/src/createApiCoreSql.ts b/packages/api-core-sql/src/createApiCoreSql.ts
