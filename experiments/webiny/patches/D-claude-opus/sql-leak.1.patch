+++ b/packages/api-core-sql/src/createApiCoreSql.ts
@@ -13,30 +13,64 @@ interface CreateApiCoreSqlParams {
     tableNamePrefix?: string;
 }
 
+interface CachedApiCoreSql {
+    storageOperations: ApiCoreStorageOperations;
+    manifestLoader: SqlServiceManifestLoader;
+}
+
+/**
+ * Storage operations are stateless apart from the TableManager's "known tables" cache, so they are
+ * built once per Knex client + table prefix and reused. Building them per call (the factory is
+ * invoked on every request) leaked a TableManager per request and re-ran every table existence check.
+ * Keyed weakly on the Knex client so a destroyed/discarded client does not stay pinned.
+ */
+const cache = new WeakMap<Knex, Map<string, CachedApiCoreSql>>();
+
+const build = (knex: Knex, tableNamePrefix: string | undefined): CachedApiCoreSql => {
+    const tableManager = new TableManager(knex, tableNamePrefix);
+
+    return {
+        manifestLoader: new SqlServiceManifestLoader(knex, tableManager),
+        storageOperations: {
+            usersStorageOperations: createUsersStorageOperations({
+                knex,
+                tableManager
+            }),
+            tenancyStorageOperations: createTenancyStorageOperations({
+                knex,
+                tableManager
+            }),
+            securityStorageOperations: createSecurityStorageOperations({
+                knex,
+                tableManager
+            }),
+            keyValueStorageOperations: createKeyValueStorageOperations({
+                knex,
+                tableManager
+            })
+        }
+    };
+};
+
 export const createApiCoreSql = ({
     knex,
     tableNamePrefix
 }: CreateApiCoreSqlParams): ApiCoreStorageOperations => {
-    const tableManager = new TableManager(knex, tableNamePrefix);
+    let byPrefix = cache.get(knex);
+    if (!byPrefix) {
+        byPrefix = new Map();
+        cache.set(knex, byPrefix);
+    }
 
-    ServiceDiscovery.setLoader(new SqlServiceManifestLoader(knex, tableManager));
+    const key = tableNamePrefix ?? "";
+    let entry = byPrefix.get(key);
+    if (!entry) {
+        entry = build(knex, tableNamePrefix);
+        byPrefix.set(key, entry);
+    }
 
-    return {
-        usersStorageOperations: createUsersStorageOperations({
-            knex,
-            tableManager
-        }),
-        tenancyStorageOperations: createTenancyStorageOperations({
-            knex,
-            tableManager
-        }),
-        securityStorageOperations: createSecurityStorageOperations({
-            knex,
-            tableManager
-        }),
-        keyValueStorageOperations: createKeyValueStorageOperations({
-            knex,
-            tableManager
-        })
-    };
+    // Keep previous behaviour: the most recently created storage operations own service discovery.
+    ServiceDiscovery.setLoader(entry.manifestLoader);
+
+    return entry.storageOperations;
 };
