         const g = globalThis as Record<string, unknown>;
         const managers = (g.__sqlTableManagers ??= []) as ITableManager[];
         managers.push(this);
@@ -22,6 +30,7 @@ export class TableManager implements ITableManager {
 
     public reset(): void {
         this.verified.clear();
+        this.pending.clear();
     }
 
     public resolve(tableName: string): string {
@@ -38,12 +47,45 @@ export class TableManager implements ITableManager {
             return;
         }
 
-        const exists = await this.knex.schema.hasTable(resolved);
+        let promise = this.pending.get(resolved);
+        if (!promise) {
+            promise = this.doEnsure(resolved, creator).then(
+                () => {
+                    if (this.pending.get(resolved) === promise) {
+                        this.verified.add(resolved);
+                        this.pending.delete(resolved);
+                    }
+                },
+                err => {
+                    // Clear on failure so a later call can retry.
+                    if (this.pending.get(resolved) === promise) {
+                        this.pending.delete(resolved);
+                    }
+                    throw err;
+                }
+            );
+            this.pending.set(resolved, promise);
+        }
+        return promise;
+    }
 
-        if (!exists) {
-            await this.knex.schema.createTable(resolved, creator);
+    private async doEnsure(
+        resolved: string,
+        creator: (table: Knex.CreateTableBuilder) => void
+    ): Promise<void> {
+        if (await this.knex.schema.hasTable(resolved)) {
+            return;
         }
 
-        this.verified.add(resolved);
+        try {
+            await this.knex.schema.createTable(resolved, creator);
+        } catch (err) {
+            // Another manager / process / connection may have created the table between our
+            // hasTable check and createTable. If it exists now, that's success.
+            if (await this.knex.schema.hasTable(resolved)) {
+                return;
+            }
+            throw err;
+        }
     }
 }
