@@ -0,0 +1,116 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import knexLib, { type Knex } from "knex";
+import { Container } from "@webiny/feature/api";
+import { ApiCoreStorageOperationsFactory } from "@webiny/api-core";
+import { TableManager } from "~/TableManager.js";
+import { ApiCoreSqlFeature } from "~/ApiCoreSqlFeature.js";
+
+const getManagers = () => {
+    const g = globalThis as Record<string, unknown>;
+    return (g.__sqlTableManagers ?? []) as unknown[];
+};
+
+const creator = (table: Knex.CreateTableBuilder) => {
+    table.text("id").primary();
+};
+
+describe("SQL core storage: TableManager lifecycle", () => {
+    let knex: Knex;
+
+    beforeEach(() => {
+        knex = knexLib({
+            client: "better-sqlite3",
+            connection: { filename: ":memory:" },
+            useNullAsDefault: true
+        });
+    });
+
+    afterEach(async () => {
+        await knex.destroy();
+    });
+
+    it("storage operations factory returns the same instance and creates no new TableManagers", () => {
+        const container = new Container();
+        ApiCoreSqlFeature.register(container, { knex, tableNamePrefix: "t1" });
+        const factory = container.resolve(ApiCoreStorageOperationsFactory);
+
+        const first = factory.create();
+        const managersAfterFirst = getManagers().length;
+
+        for (let i = 0; i < 100; i++) {
+            expect(factory.create()).toBe(first);
+        }
+        expect(getManagers().length).toBe(managersAfterFirst);
+
+        // Re-registering (e.g. a new container) with the same knex + prefix reuses it as well.
+        const container2 = new Container();
+        ApiCoreSqlFeature.register(container2, { knex, tableNamePrefix: "t1" });
+        expect(container2.resolve(ApiCoreStorageOperationsFactory).create()).toBe(first);
+        expect(getManagers().length).toBe(managersAfterFirst);
+    });
+
+    it("checks table existence only once across many calls", async () => {
+        const manager = new TableManager(knex, "p");
+        let schemaQueries = 0;
+        knex.on("query", (query: { sql: string }) => {
+            if (/sqlite_master|create table/i.test(query.sql)) {
+                schemaQueries++;
+            }
+        });
+
+        await Promise.all(Array.from({ length: 20 }, () => manager.ensure("items", creator)));
+        for (let i = 0; i < 20; i++) {
+            await manager.ensure("items", creator);
+        }
+
+        // One hasTable + one createTable, no matter how many callers.
+        expect(schemaQueries).toBe(2);
+        expect(await knex.schema.hasTable("p_items")).toBe(true);
+    });
+
+    it("concurrent first use of the same table by one manager succeeds", async () => {
+        const manager = new TableManager(knex, "c");
+        await expect(
+            Promise.all(Array.from({ length: 10 }, () => manager.ensure("things", creator)))
+        ).resolves.toBeDefined();
+        expect(await knex.schema.hasTable("c_things")).toBe(true);
+    });
+
+    it("two managers racing to create the same table both succeed", async () => {
+        const a = new TableManager(knex, "r");
+        const b = new TableManager(knex, "r");
+        await expect(
+            Promise.all([
+                a.ensure("shared", creator),
+                b.ensure("shared", creator),
+                a.ensure("shared", creator),
+                b.ensure("shared", creator)
+            ])
+        ).resolves.toBeDefined();
+        expect(await knex.schema.hasTable("r_shared")).toBe(true);
+    });
+
+    it("re-checks after reset()", async () => {
+        const manager = new TableManager(knex, "x");
+        await manager.ensure("items", creator);
+        await knex.schema.dropTable("x_items");
+        manager.reset();
+        await manager.ensure("items", creator);
+        expect(await knex.schema.hasTable("x_items")).toBe(true);
+    });
+
+    it("a failed creation can be retried", async () => {
+        const manager = new TableManager(knex, "f");
+        let fail = true;
+        const flaky = (table: Knex.CreateTableBuilder) => {
+            if (fail) {
+                throw new Error("boom");
+            }
+            creator(table);
+        };
+        await expect(manager.ensure("items", flaky)).rejects.toThrow("boom");
+        fail = false;
+        await manager.ensure("items", flaky);
+        expect(await knex.schema.hasTable("f_items")).toBe(true);
+    });
+});
diff --git a/packages/api-core-sql/src/ApiCoreSqlFeature.ts b/packages/api-core-sql/src/ApiCoreSqlFeature.ts
