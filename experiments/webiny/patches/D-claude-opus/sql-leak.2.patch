--- a/packages/api-core-sql/src/ApiCoreSqlFeature.ts
+++ b/packages/api-core-sql/src/ApiCoreSqlFeature.ts
@@ -1,6 +1,7 @@
 import { createFeature } from "@webiny/feature/api";
 import type { Knex } from "knex";
 import { ApiCoreStorageOperationsFactory } from "@webiny/api-core";
+import type { ApiCoreStorageOperations } from "@webiny/api-core/types/core.js";
 import { createApiCoreSql } from "./createApiCoreSql.js";
 
 export interface ApiCoreSqlConfig {
@@ -8,6 +9,29 @@ export interface ApiCoreSqlConfig {
     tableNamePrefix?: string;
 }
 
+/**
+ * Storage operations (and their TableManager) are stateless apart from the "table verified"
+ * cache, so one instance per knex + table prefix is shared for the lifetime of the process.
+ * Creating them per request would leak a TableManager per request and re-check table existence
+ * on every request.
+ */
+const cache = new WeakMap<Knex, Map<string, ApiCoreStorageOperations>>();
+
+const getStorageOperations = (knex: Knex, tableNamePrefix?: string): ApiCoreStorageOperations => {
+    let byPrefix = cache.get(knex);
+    if (!byPrefix) {
+        byPrefix = new Map();
+        cache.set(knex, byPrefix);
+    }
+    const key = tableNamePrefix ?? "";
+    let storageOperations = byPrefix.get(key);
+    if (!storageOperations) {
+        storageOperations = createApiCoreSql({ knex, tableNamePrefix });
+        byPrefix.set(key, storageOperations);
+    }
+    return storageOperations;
+};
+
 /**
  * Registers the SQL implementation of ApiCoreStorageOperationsFactory. ApiCoreFeature.register
  * resolves + builds it. Mirrors ApiCoreDdbFeature.
@@ -16,7 +40,7 @@ export const ApiCoreSqlFeature = createFeature<ApiCoreSqlConfig>({
     name: "ApiCoreSql",
     register(container, { knex, tableNamePrefix }) {
         container.registerInstance(ApiCoreStorageOperationsFactory, {
-            create: () => createApiCoreSql({ knex, tableNamePrefix })
+            create: () => getStorageOperations(knex, tableNamePrefix)
         });
     }
 });
