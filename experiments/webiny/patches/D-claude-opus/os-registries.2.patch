diff --git a/packages/api-opensearch/__tests__/registries.test.ts b/packages/api-opensearch/__tests__/registries.test.ts
new file mode 100644
index 00000000..acda7c5e
--- /dev/null
+++ b/packages/api-opensearch/__tests__/registries.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from "vitest";
+import { Container } from "@webiny/di";
+import { OpenSearchQueryBuilderOperatorFeature } from "~/features/OpenSearchQueryBuilderOperator/feature.js";
+import { OpenSearchQueryBuilderOperatorRegistry } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperatorRegistry.js";
+import { OpenSearchQueryBuilderOperator } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperator.js";
+import { OpenSearchIndexFeature } from "~/features/OpenSearchIndex/feature.js";
+import { OpenSearchIndexRegistry } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndexRegistry.js";
+import { OpenSearchIndex } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndex.js";
+import type { OpenSearchIndexRequestBody } from "~/types.js";
+
+class CustomOperatorImpl implements OpenSearchQueryBuilderOperator.Interface {
+    public getOperator(): string {
+        return "custom";
+    }
+    public apply(): void {
+        // noop
+    }
+}
+
+const CustomOperator = OpenSearchQueryBuilderOperator.createImplementation({
+    implementation: CustomOperatorImpl,
+    dependencies: []
+});
+
+const createIndex = (name: string) => {
+    class IndexImpl implements OpenSearchIndex.Interface {
+        public readonly body = { name } as unknown as OpenSearchIndexRequestBody;
+        public canUse(): boolean {
+            return true;
+        }
+    }
+    return OpenSearchIndex.createImplementation({
+        implementation: IndexImpl,
+        dependencies: []
+    });
+};
+
+const BuiltInIndex = createIndex("builtIn");
+const CustomIndex = createIndex("custom");
+
+describe("OpenSearch registries across child containers", () => {
+    it("should include operators registered in the resolving container only", () => {
+        const root = new Container();
+        OpenSearchQueryBuilderOperatorFeature.register(root);
+
+        const request1 = root.createChildContainer();
+        request1.register(CustomOperator);
+        const request2 = root.createChildContainer();
+
+        // Resolve the root first, so a cached root instance would leak into the children.
+        const rootRegistry = root.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        const registry1 = request1.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        const registry2 = request2.resolve(OpenSearchQueryBuilderOperatorRegistry);
+
+        expect(registry1.get("custom")).toBeInstanceOf(CustomOperatorImpl);
+        expect(registry2.get("custom")).toBeUndefined();
+        expect(rootRegistry.get("custom")).toBeUndefined();
+
+        for (const registry of [rootRegistry, registry1, registry2]) {
+            expect(registry.get("eq")).toBeDefined();
+            expect(registry.get("not")).toBeDefined();
+            expect(registry.get("in")).toBeDefined();
+        }
+        expect(registry1.getAll()).toHaveLength(rootRegistry.getAll().length + 1);
+        expect(registry2.getAll()).toHaveLength(rootRegistry.getAll().length);
+    });
+
+    it("should include indexes registered in the resolving container only", () => {
+        const root = new Container();
+        root.register(BuiltInIndex);
+        OpenSearchIndexFeature.register(root);
+
+        const request1 = root.createChildContainer();
+        request1.register(CustomIndex);
+        const request2 = root.createChildContainer();
+
+        const rootRegistry = root.resolve(OpenSearchIndexRegistry);
+        const registry1 = request1.resolve(OpenSearchIndexRegistry);
+        const registry2 = request2.resolve(OpenSearchIndexRegistry);
+
+        const names = (registry: OpenSearchIndexRegistry.Interface) =>
+            registry.getAll().map(index => (index.body as unknown as { name: string }).name);
+
+        expect(names(registry1)).toEqual(["builtIn", "custom"]);
+        expect(names(registry2)).toEqual(["builtIn"]);
+        expect(names(rootRegistry)).toEqual(["builtIn"]);
+        expect((registry1.getLastAdded().body as unknown as { name: string }).name).toBe("custom");
+    });
+});
