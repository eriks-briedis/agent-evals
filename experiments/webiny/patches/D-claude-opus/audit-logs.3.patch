diff --git a/packages/api-audit-logs/__tests__/eventHandlers.test.ts b/packages/api-audit-logs/__tests__/eventHandlers.test.ts
new file mode 100644
index 00000000..c8e76254
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/eventHandlers.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from "vitest";
+import { CreateGroupUseCase } from "@webiny/api-headless-cms/features/contentModelGroup/CreateGroup/index.js";
+import { ActionType } from "@webiny/common-audit-logs";
+import { AuditLogsContext } from "~/abstractions.js";
+import { useHandler } from "./helpers/useHandler";
+
+/**
+ * Covers the real write path: a domain event fires, an audit-log event handler (which gets its
+ * context via the `AuditLogsContext` DI token) runs, and a log is stored. Calling getAuditConfig
+ * directly with the request context — as the other tests do — bypasses the DI wiring.
+ */
+describe("audit log event handlers", () => {
+    it("should register the full request context under the AuditLogsContext token", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const resolved = context.container.resolve(AuditLogsContext);
+        expect(resolved.auditLogs).toBe(context.auditLogs);
+        expect(resolved.container).toBeDefined();
+    });
+
+    it("should write an audit log when a CMS group is created", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const result = await context.container.resolve(CreateGroupUseCase).execute({
+            name: "Audited Group",
+            slug: "audited-group",
+            description: "",
+            icon: { type: "fa/fas", name: "fa/fas", value: "fa/fas" }
+        });
+        if (result.isFail()) {
+            throw result.error;
+        }
+        const group = result.value;
+
+        const { items, error } = await context.auditLogs.listAuditLogs({});
+        expect(error).toBeFalsy();
+        expect(items).toHaveLength(1);
+        expect(items![0]).toMatchObject({
+            message: "Group created",
+            app: "HEADLESS_CMS",
+            entity: "GROUP",
+            entityId: group.id,
+            action: ActionType.CREATE
+        });
+    });
+});
