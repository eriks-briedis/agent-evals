diff --git a/packages/api-audit-logs/__tests__/subscriptionHandlers.test.ts b/packages/api-audit-logs/__tests__/subscriptionHandlers.test.ts
new file mode 100644
index 00000000..6e0f2f7f
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptionHandlers.test.ts
@@ -0,0 +1,53 @@
+import { describe, expect, it } from "vitest";
+import { EntryAfterCreateEventHandler } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/index.js";
+import { useHandler } from "./helpers/useHandler";
+import { AuditLogsContext } from "~/abstractions.js";
+
+const isSql = process.env.WEBINY_STORAGE?.includes("sql");
+
+/**
+ * Subscription handlers do not receive the request context directly: they inject the
+ * `AuditLogsContext` token and pass it to `getAuditConfig`, which reads `context.auditLogs`.
+ * If the token resolves to anything other than the full context, every handler logs
+ * "No AuditLogs defined." and nothing is ever written.
+ */
+describe.skipIf(isSql)("audit log subscription handlers", () => {
+    it("should resolve the AuditLogsContext token to the full context", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const resolved = context.container.resolve(AuditLogsContext);
+
+        expect(resolved.auditLogs).toBeDefined();
+        expect(resolved.auditLogs).toBe(context.auditLogs);
+    });
+
+    it("should write an audit log when a CMS entry is created", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const handlers = context.container.resolveAll(EntryAfterCreateEventHandler);
+        expect(handlers.length).toBeGreaterThan(0);
+
+        const entryId = "auditLogSubscriptionTestEntry";
+        const event = {
+            payload: {
+                model: { modelId: "article", isPrivate: false },
+                entry: { id: `${entryId}#0001`, entryId, values: { title: "Hello" } }
+            }
+        } as unknown as EntryAfterCreateEventHandler.Event;
+
+        for (const h of handlers) {
+            await h.handle(event);
+        }
+
+        const result = await context.auditLogs.listAuditLogs({ entityId: entryId });
+        expect(result.error).toBeUndefined();
+        expect(result.items).toHaveLength(1);
+        expect(result.items[0]).toMatchObject({
+            entityId: entryId,
+            message: "Entry created",
+            app: "HEADLESS_CMS"
+        });
+    });
+});
