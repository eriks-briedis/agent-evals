index 00000000..8934a888
--- /dev/null
+++ b/packages/api-opensearch/__tests__/registriesContainerScope.test.ts
@@ -0,0 +1,107 @@
+import { describe, expect, it } from "vitest";
+import { Container } from "@webiny/di";
+import { OpenSearchQueryBuilderOperatorFeature } from "~/features/OpenSearchQueryBuilderOperator/feature.js";
+import { OpenSearchQueryBuilderOperatorRegistry } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperatorRegistry.js";
+import { OpenSearchQueryBuilderOperator } from "~/features/OpenSearchQueryBuilderOperator/abstractions/OpenSearchQueryBuilderOperator.js";
+import { OpenSearchIndexFeature } from "~/features/OpenSearchIndex/feature.js";
+import { OpenSearchIndexRegistry } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndexRegistry.js";
+import { OpenSearchIndex } from "~/features/OpenSearchIndex/abstractions/OpenSearchIndex.js";
+
+class CustomOperatorImpl implements OpenSearchQueryBuilderOperator.Interface {
+    public getOperator(): string {
+        return "customOp";
+    }
+
+    public apply(): void {
+        // noop
+    }
+}
+
+const CustomOperator = OpenSearchQueryBuilderOperator.createImplementation({
+    implementation: CustomOperatorImpl,
+    dependencies: []
+});
+
+class BuiltInIndexImpl implements OpenSearchIndex.Interface {
+    public readonly body = { settings: { builtIn: true } } as any;
+    public canUse(): boolean {
+        return true;
+    }
+}
+
+const BuiltInIndex = OpenSearchIndex.createImplementation({
+    implementation: BuiltInIndexImpl,
+    dependencies: []
+});
+
+class CustomIndexImpl implements OpenSearchIndex.Interface {
+    public readonly body = { settings: { custom: true } } as any;
+    public canUse(): boolean {
+        return true;
+    }
+}
+
+const CustomIndex = OpenSearchIndex.createImplementation({
+    implementation: CustomIndexImpl,
+    dependencies: []
+});
+
+describe("OpenSearch registries in child containers", () => {
+    it("should include operators registered in the request container only in that request", () => {
+        const root = new Container();
+        OpenSearchQueryBuilderOperatorFeature.register(root);
+
+        // Resolve in root first, to make sure nothing is cached and shared with children.
+        const rootRegistry = root.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        expect(rootRegistry.get("customOp")).toBeUndefined();
+        expect(rootRegistry.get("eq")).toBeDefined();
+
+        const requestA = root.createChildContainer();
+        requestA.register(CustomOperator);
+        const requestB = root.createChildContainer();
+
+        const registryA = requestA.resolve(OpenSearchQueryBuilderOperatorRegistry);
+        const registryB = requestB.resolve(OpenSearchQueryBuilderOperatorRegistry);
+
+        expect(registryA.get("customOp")).toBeInstanceOf(CustomOperatorImpl);
+        expect(registryB.get("customOp")).toBeUndefined();
+        expect(root.resolve(OpenSearchQueryBuilderOperatorRegistry).get("customOp")).toBeUndefined();
+
+        const builtIn = rootRegistry.getAll().map(op => op.getOperator());
+        for (const registry of [registryA, registryB]) {
+            for (const name of builtIn) {
+                expect(registry.get(name)).toBeDefined();
+            }
+        }
+        expect(registryA.getAll()).toHaveLength(builtIn.length + 1);
+        expect(registryB.getAll()).toHaveLength(builtIn.length);
+    });
+
+    it("should include indexes registered in the request container only in that request", () => {
+        const root = new Container();
+        OpenSearchIndexFeature.register(root);
+        root.register(BuiltInIndex);
+
+        const rootRegistry = root.resolve(OpenSearchIndexRegistry);
+        expect(rootRegistry.getAll()).toHaveLength(1);
+
+        const requestA = root.createChildContainer();
+        requestA.register(CustomIndex);
+        const requestB = root.createChildContainer();
+
+        const registryA = requestA.resolve(OpenSearchIndexRegistry);
+        const registryB = requestB.resolve(OpenSearchIndexRegistry);
+
+        expect(registryA.getAll()).toHaveLength(2);
+        expect(registryA.getAll()[0]).toBeInstanceOf(BuiltInIndexImpl);
+        expect(registryA.getLastAdded()).toBeInstanceOf(CustomIndexImpl);
+
+        expect(registryB.getAll()).toHaveLength(1);
+        expect(registryB.getLastAdded()).toBeInstanceOf(BuiltInIndexImpl);
+
+        expect(root.resolve(OpenSearchIndexRegistry).getAll()).toHaveLength(1);
+        expect(root.resolve(OpenSearchIndexRegistry).getLastAdded()).toBeInstanceOf(
+            BuiltInIndexImpl
+        );
+    });
+});
