+/*
+ * A temporary switch must be visible only inside its own callback. Sibling work on the same request
+ * (e.g. other fields of the same GraphQL query) runs concurrently and must keep seeing the
+ * request's tenant.
+ */
+describe("TenantContext scoped switches and concurrent work", () => {
+    let tenantContext: TenantContext.Interface;
+
+    const tick = () => new Promise(resolve => setTimeout(resolve, 5));
+
+    beforeEach(() => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        tenantContext = container.resolve(TenantContext);
+        tenantContext.setTenant(createTenant("sub", "root"));
+    });
+
+    const observeSibling = async () => {
+        const seen: string[] = [];
+        for (let i = 0; i < 4; i++) {
+            seen.push(tenantContext.getTenant().id);
+            await tick();
+        }
+        return seen;
+    };
+
+    it("withTenant does not leak into a concurrently running sibling", async () => {
+        const [inside, sibling] = await Promise.all([
+            tenantContext.withTenant(createTenant("other", "root"), async () => {
+                await tick();
+                await tick();
+                return tenantContext.getTenant().id;
+            }),
+            observeSibling()
+        ]);
+
+        expect(inside).toBe("other");
+        expect(sibling).toEqual(["sub", "sub", "sub", "sub"]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("withRootTenant does not leak into a concurrently running sibling", async () => {
+        const [inside, sibling] = await Promise.all([
+            tenantContext.withRootTenant(async () => {
+                await tick();
+                await tick();
+                return tenantContext.getTenant().id;
+            }),
+            observeSibling()
+        ]);
+
+        expect(inside).toBe("root");
+        expect(sibling).toEqual(["sub", "sub", "sub", "sub"]);
+    });
+
+    it("withEachTenant does not leak into a concurrently running sibling", async () => {
+        const [inside, sibling] = await Promise.all([
+            tenantContext.withEachTenant(
+                [createTenant("a", "root"), createTenant("b", "root")],
+                async () => {
+                    await tick();
+                    return tenantContext.getTenant().id;
+                }
+            ),
+            observeSibling()
+        ]);
+
+        expect(inside).toEqual(["a", "b"]);
+        expect(sibling).toEqual(["sub", "sub", "sub", "sub"]);
+    });
+
+    it("concurrent switches each see their own tenant", async () => {
+        const results = await Promise.all(
+            ["a", "b", "c"].map(id =>
+                tenantContext.withTenant(createTenant(id, "root"), async () => {
+                    await tick();
+                    return tenantContext.getTenant().id;
+                })
+            )
+        );
+        expect(results).toEqual(["a", "b", "c"]);
+    });
+
+    it("nested switches restore the outer switch", async () => {
+        const seen = await tenantContext.withTenant(createTenant("a", "root"), async () => {
+            const inner = await tenantContext.withTenant(createTenant("b", "root"), async () => {
+                return tenantContext.getTenant().id;
+            });
+            return [inner, tenantContext.getTenant().id];
+        });
+        expect(seen).toEqual(["b", "a"]);
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("rejects setTenant inside a scoped callback and keeps the request's tenant", async () => {
+        await expect(
+            tenantContext.withTenant(createTenant("a", "root"), async () => {
+                tenantContext.setTenant(createTenant("b", "root"));
+            })
+        ).rejects.toThrow(/setTenant/);
+
+        await expect(
+            tenantContext.withRootTenant(async () => {
+                tenantContext.setTenant(createTenant("b", "root"));
+            })
+        ).rejects.toThrow(/setTenant/);
+
+        await expect(
+            tenantContext.withEachTenant([createTenant("a", "root")], async () => {
+                await tick();
+                tenantContext.setTenant(createTenant("b", "root"));
+            })
+        ).rejects.toThrow(/setTenant/);
+
+        expect(tenantContext.getTenant().id).toBe("sub");
+    });
+
+    it("still allows setTenant outside of scoped callbacks", () => {
+        tenantContext.setTenant(createTenant("x", "root"));
+        expect(tenantContext.getTenant().id).toBe("x");
+    });
+});
+
