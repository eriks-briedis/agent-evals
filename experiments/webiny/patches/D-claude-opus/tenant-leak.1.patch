+
+export class TenantSwitchInScopeError extends BaseError {
+    override readonly code = "Tenancy/TenantSwitchInScope" as const;
+
+    constructor() {
+        super({
+            message:
+                "Cannot call setTenant() inside withTenant(), withRootTenant() or withEachTenant(): the tenant is fixed for the duration of the callback. Use a nested withTenant() instead."
+        });
+    }
