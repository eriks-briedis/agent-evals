diff --git a/packages/api-core/__tests__/tenancy/tenantContext.test.ts b/packages/api-core/__tests__/tenancy/tenantContext.test.ts
index 6891fe89..52d0aa75 100644
--- a/packages/api-core/__tests__/tenancy/tenantContext.test.ts
+++ b/packages/api-core/__tests__/tenancy/tenantContext.test.ts
@@ -125,3 +125,135 @@ describe("TenantContext with no tenant set", () => {
         expect(tenantContext.getTenant()).toBeNull();
     });
 });
+
+/*
+ * One field of a GraphQL query may temporarily switch tenant (e.g. to load inherited data from the
+ * parent tenant) while sibling fields of the same query are still resolving. The switch must only
+ * be visible inside its own callback.
+ */
+describe("TenantContext temporary switches are scoped to their callback", () => {
+    let tenantContext: TenantContext.Interface;
+
+    const tick = () => new Promise(resolve => setTimeout(resolve, 5));
+
+    beforeEach(() => {
+        const container = new Container();
+        TenancyFeature.register(container, new MockTenancyStorageOperations());
+        tenantContext = container.resolve(TenantContext);
+        tenantContext.setTenant(createTenant("request", "root"));
+    });
+
+    it("a concurrent sibling keeps seeing the request's tenant during withTenant", async () => {
+        const seenBySibling: string[] = [];
+        const switched = tenantContext.withTenant(createTenant("parent", "root"), async () => {
+            await tick();
+            await tick();
+            return tenantContext.getTenant().id;
+        });
+        const sibling = (async () => {
+            seenBySibling.push(tenantContext.getTenant().id);
+            await tick();
+            seenBySibling.push(tenantContext.getTenant().id);
+            await tick();
+            seenBySibling.push(tenantContext.getTenant().id);
+        })();
+
+        const [inside] = await Promise.all([switched, sibling]);
+        expect(inside).toBe("parent");
+        expect(seenBySibling).toEqual(["request", "request", "request"]);
+        expect(tenantContext.getTenant().id).toBe("request");
+    });
+
+    it("a concurrent sibling keeps seeing the request's tenant during withRootTenant", async () => {
+        let seenBySibling: string | undefined;
+        const switched = tenantContext.withRootTenant(async () => {
+            await tick();
+            return tenantContext.getTenant().id;
+        });
+        const sibling = (async () => {
+            await tick();
+            seenBySibling = tenantContext.getTenant().id;
+        })();
+
+        const [inside] = await Promise.all([switched, sibling]);
+        expect(inside).toBe("root");
+        expect(seenBySibling).toBe("request");
+    });
+
+    it("a concurrent sibling keeps seeing the request's tenant during withEachTenant", async () => {
+        const seenBySibling: string[] = [];
+        const switched = tenantContext.withEachTenant(
+            [createTenant("a", "root"), createTenant("b", "root")],
+            async () => {
+                await tick();
+                return tenantContext.getTenant().id;
+            }
+        );
+        const sibling = (async () => {
+            for (let i = 0; i < 4; i++) {
+                await tick();
+                seenBySibling.push(tenantContext.getTenant().id);
+            }
+        })();
+
+        const [inside] = await Promise.all([switched, sibling]);
+        expect(inside).toEqual(["a", "b"]);
+        expect(seenBySibling).toEqual(["request", "request", "request", "request"]);
+    });
+
+    it("overlapping switches do not see each other", async () => {
+        const [a, b] = await Promise.all([
+            tenantContext.withTenant(createTenant("a", "root"), async () => {
+                await tick();
+                return tenantContext.getTenant().id;
+            }),
+            tenantContext.withTenant(createTenant("b", "root"), async () => {
+                await tick();
+                return tenantContext.getTenant().id;
+            })
+        ]);
+        expect([a, b]).toEqual(["a", "b"]);
+        expect(tenantContext.getTenant().id).toBe("request");
+    });
+
+    it("nested switches see the innermost tenant and restore the outer one", async () => {
+        const seen = await tenantContext.withTenant(createTenant("outer", "root"), async () => {
+            const inner = await tenantContext.withTenant(createTenant("inner", "root"), async () =>
+                tenantContext.getTenant().id
+            );
+            return [inner, tenantContext.getTenant().id];
+        });
+        expect(seen).toEqual(["inner", "outer"]);
+    });
+
+    it("rejects setTenant inside a callback and leaves the request's tenant unchanged", async () => {
+        for (const run of [
+            (cb: () => Promise<void>) => tenantContext.withTenant(createTenant("sub", "root"), cb),
+            (cb: () => Promise<void>) => tenantContext.withRootTenant(cb),
+            (cb: () => Promise<void>) =>
+                tenantContext.withEachTenant([createTenant("sub", "root")], cb)
+        ]) {
+            let tenantAfterRejectedSet: string | undefined;
+            await expect(
+                run(async () => {
+                    const before = tenantContext.getTenant().id;
+                    try {
+                        tenantContext.setTenant(createTenant("hijack", "root"));
+                    } finally {
+                        tenantAfterRejectedSet = tenantContext.getTenant().id;
+                        expect(tenantAfterRejectedSet).toBe(before);
+                    }
+                })
+            ).rejects.toMatchObject({ code: "Tenancy/TenantSwitchInScope" });
+            expect(tenantContext.getTenant().id).toBe("request");
+        }
+    });
+
+    it("rejects switching to a disabled tenant", async () => {
+        const disabled = { ...createTenant("off", "root"), status: "disabled" as const };
+        await expect(tenantContext.withTenant(disabled, async () => "x")).rejects.toMatchObject({
+            code: "Tenancy/TenantDisabled"
+        });
+        expect(tenantContext.getTenant().id).toBe("request");
+    });
+});
