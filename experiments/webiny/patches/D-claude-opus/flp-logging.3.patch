@@ -0,0 +1,130 @@
+import { describe, it, expect } from "vitest";
+import type { Container } from "@webiny/di";
+import { BaseError, Result } from "@webiny/feature/api";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CREATE_FLP_TASK_ID, DELETE_FLP_TASK_ID, UPDATE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+class TriggerFailedError extends BaseError {
+    override readonly code = "TEST_TRIGGER_FAILED" as const;
+}
+
+interface LoggedError {
+    data: any;
+    message: string;
+}
+
+/*
+ * Replaces the task service with one that cannot start tasks, and the logger with one that records
+ * errors. `mode` picks how the trigger fails: a failed Result, or a thrown error.
+ */
+const breakTasks = (container: Container, mode: "result" | "throw") => {
+    const errors: LoggedError[] = [];
+    const triggered: string[] = [];
+    const noop = () => {};
+    container.registerInstance(Logger, {
+        trace: noop,
+        debug: noop,
+        info: noop,
+        warn: noop,
+        log: noop,
+        fatal: noop,
+        error: (data: any, message: string) => {
+            errors.push({ data, message });
+        }
+    });
+    container.registerInstance(TaskService, {
+        trigger: async (params: { definition: string }) => {
+            triggered.push(params.definition);
+            if (mode === "throw") {
+                throw new Error("Step function unreachable.");
+            }
+            return Result.fail(new TriggerFailedError({ message: "Could not start the task." }));
+        },
+        abort: async () => Result.fail(new TriggerFailedError({ message: "n/a" })),
+        fetchServiceInfo: async () => Result.ok({})
+    } as unknown as TaskService.Interface);
+    return { errors, triggered };
+};
+
+const createFolder = async (container: Container, slug: string) => {
+    const result = await container.resolve(CreateFolderUseCase).execute({
+        type: "type",
+        title: slug,
+        slug,
+        parentId: null
+    });
+    expect(result.isOk()).toBe(true);
+    return result.value;
+};
+
+describe.each(["result", "throw"] as const)(
+    "FLP task trigger failure (%s) is logged and the folder change still succeeds",
+    mode => {
+        const { handler } = useHandler();
+
+        it("on folder create", async () => {
+            const { container } = await handler();
+            const { errors, triggered } = breakTasks(container, mode);
+
+            const folder = await createFolder(container, `flp-fail-create-${mode}`);
+
+            expect(triggered).toContain(CREATE_FLP_TASK_ID);
+            expect(errors).toEqual([
+                {
+                    data: expect.objectContaining({
+                        folderId: folder.id,
+                        error: expect.any(Error)
+                    }),
+                    message: expect.stringContaining(folder.id)
+                }
+            ]);
+        });
+
+        it("on folder update", async () => {
+            const { container } = await handler();
+            const folder = await createFolder(container, `flp-fail-update-${mode}`);
+            const { errors, triggered } = breakTasks(container, mode);
+
+            const updated = await container
+                .resolve(UpdateFolderUseCase)
+                .execute(folder.id, { title: "Renamed" });
+
+            expect(updated.isOk()).toBe(true);
+            expect(triggered).toContain(UPDATE_FLP_TASK_ID);
+            expect(errors).toEqual([
+                {
+                    data: expect.objectContaining({
+                        folderId: folder.id,
+                        error: expect.any(Error)
+                    }),
+                    message: expect.stringContaining(folder.id)
+                }
+            ]);
+        });
+
+        it("on folder delete", async () => {
+            const { container } = await handler();
+            const folder = await createFolder(container, `flp-fail-delete-${mode}`);
+            const { errors, triggered } = breakTasks(container, mode);
+
+            const deleted = await container.resolve(DeleteFolderUseCase).execute(folder.id);
+
+            expect(deleted.isOk()).toBe(true);
+            expect(triggered).toContain(DELETE_FLP_TASK_ID);
+            expect(errors).toEqual([
+                {
+                    data: expect.objectContaining({
+                        folderId: folder.id,
+                        error: expect.any(Error)
+                    }),
+                    message: expect.stringContaining(folder.id)
+                }
+            ]);
+        });
+    }
+);
