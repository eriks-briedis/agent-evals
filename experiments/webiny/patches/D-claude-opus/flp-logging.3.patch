                 // Nobody to tell when there is no identity, as in some system calls.
                 input: { folder, notifyIdentityId: this.identityContext.getIdentity()?.id }
             });
-        } catch {
-            // Ignore errors
+            if (result.isFail()) {
+                this.logger.error(
+                    { folderId: folder.id, error: result.error },
+                    `Failed to trigger the task that creates folder level permissions for folder "${folder.id}".`
+                );
+            }
+        } catch (error) {
+            // The folder change has already succeeded; do not fail it because of the FLP task.
+            this.logger.error(
+                { folderId: folder.id, error },
+                `Failed to trigger the task that creates folder level permissions for folder "${folder.id}".`
+            );
         }
     }
 }
 
 export const CreateFlpOnFolderCreatedHandler = FolderAfterCreateEventHandler.createImplementation({
     implementation: CreateFlpOnFolderCreatedHandlerImpl,
