diff --git a/packages/api-audit-logs/__tests__/subscriptionHandlers.test.ts b/packages/api-audit-logs/__tests__/subscriptionHandlers.test.ts
new file mode 100644
index 00000000..056e6184
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptionHandlers.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it } from "vitest";
+import { EntryAfterCreateEventHandler } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/index.js";
+import { useHandler } from "./helpers/useHandler";
+import { AuditLogsContext } from "~/abstractions.js";
+
+const isSql = process.env.WEBINY_STORAGE?.includes("sql");
+
+describe.skipIf(isSql)("audit log subscription handlers", () => {
+    it("should register the full context under the AuditLogsContext token", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const resolved = context.container.resolve(AuditLogsContext);
+
+        // Handlers pass this to getAuditConfig, which needs `.auditLogs` and `.container`.
+        expect(resolved.auditLogs).toBe(context.auditLogs);
+        expect(resolved.container).toBe(context.container);
+    });
+
+    it("should write an audit log when a CMS entry is created", async () => {
+        const { handler } = useHandler();
+        const context = await handler();
+
+        const auditHandler = context.container
+            .resolveAll(EntryAfterCreateEventHandler)
+            .find(h => h.constructor.name === "AuditLogEntryAfterCreateHandlerImpl");
+        expect(auditHandler).toBeDefined();
+
+        await auditHandler!.handle({
+            payload: {
+                model: { modelId: "article", isPrivate: false },
+                entry: { id: "entry-1#0001", entryId: "entry-1", values: {} }
+            }
+        } as unknown as EntryAfterCreateEventHandler.Event);
+
+        const { items } = await context.auditLogs.listAuditLogs({});
+        expect(items).toHaveLength(1);
+        expect(items![0]).toMatchObject({
+            message: "Entry created",
+            entityId: "entry-1",
+            app: "HEADLESS_CMS"
+        });
+    });
+});
