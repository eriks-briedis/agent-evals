@@ -0,0 +1,94 @@
+import { describe, it, expect, vi } from "vitest";
+import { Container } from "@webiny/di";
+import { BaseError, Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/abstractions.js";
+import { FolderAfterCreateEventHandler } from "~/features/folder/CreateFolder/abstractions.js";
+import { FolderAfterUpdateEventHandler } from "~/features/folder/UpdateFolder/index.js";
+import { FolderAfterDeleteEventHandler } from "~/features/folder/DeleteFolder/abstractions.js";
+import { CreateFlpOnFolderCreatedHandler } from "~/features/flp/CreateFlpOnFolderCreated/CreateFlpOnFolderCreatedHandler.js";
+import { UpdateFlpOnFolderUpdatedHandler } from "~/features/flp/UpdateFlpOnFolderUpdated/UpdateFlpOnFolderUpdatedHandler.js";
+import { DeleteFlpOnFolderDeletedHandler } from "~/features/flp/DeleteFlpOnFolderDeleted/DeleteFlpOnFolderDeletedHandler.js";
+
+class TriggerFailedError extends BaseError {
+    override readonly code = "TRIGGER_FAILED" as const;
+
+    constructor() {
+        super({ message: "Could not start the task." });
+    }
+}
+
+type Trigger = "fail" | "throw";
+
+const folder = { id: "folder-123", title: "Folder", slug: "folder", type: "type1" };
+
+const setup = (trigger: Trigger) => {
+    const container = new Container();
+    const logger = {
+        trace: vi.fn(),
+        debug: vi.fn(),
+        info: vi.fn(),
+        warn: vi.fn(),
+        error: vi.fn(),
+        fatal: vi.fn(),
+        log: vi.fn()
+    };
+    const thrown = new Error("Trigger exploded.");
+    const failure = new TriggerFailedError();
+
+    container.registerInstance(Logger, logger as Logger.Interface);
+    container.registerInstance(TaskService, {
+        trigger: vi.fn(async () => {
+            if (trigger === "throw") {
+                throw thrown;
+            }
+            return Result.fail(failure);
+        })
+    } as unknown as TaskService.Interface);
+    container.registerInstance(IdentityContext, {
+        getIdentity: () => ({ id: "admin-1" })
+    } as unknown as IdentityContext.Interface);
+
+    const expectedError = trigger === "throw" ? thrown : failure;
+    return { container, logger, expectedError };
+};
+
+const cases = [
+    {
+        name: "create",
+        register: (c: Container) => c.register(CreateFlpOnFolderCreatedHandler),
+        resolve: (c: Container) => c.resolve(FolderAfterCreateEventHandler)
+    },
+    {
+        name: "update",
+        register: (c: Container) => c.register(UpdateFlpOnFolderUpdatedHandler),
+        resolve: (c: Container) => c.resolve(FolderAfterUpdateEventHandler)
+    },
+    {
+        name: "delete",
+        register: (c: Container) => c.register(DeleteFlpOnFolderDeletedHandler),
+        resolve: (c: Container) => c.resolve(FolderAfterDeleteEventHandler)
+    }
+];
+
+describe("FLP task trigger failures", () => {
+    for (const { name, register, resolve } of cases) {
+        for (const trigger of ["fail", "throw"] as Trigger[]) {
+            it(`${name}: logs a ${trigger === "fail" ? "failed Result" : "thrown error"} with the folder id and does not throw`, async () => {
+                const { container, logger, expectedError } = setup(trigger);
+                register(container);
+                const handler = resolve(container);
+
+                await expect(
+                    handler.handle({ payload: { folder } } as any)
+                ).resolves.toBeUndefined();
+
+                expect(logger.error).toHaveBeenCalledTimes(1);
+                const [obj, msg] = logger.error.mock.calls[0];
+                expect(obj).toMatchObject({ folderId: folder.id, error: expectedError });
+                expect(msg).toContain(name);
+            });
+        }
+    }
+});
