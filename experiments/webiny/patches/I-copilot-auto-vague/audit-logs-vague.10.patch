+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/index.js";
+import { FeatureFlags } from "@webiny/api-core/features/featureFlags/abstractions.js";
+import { Container } from "@webiny/di";
+import { GraphQLContextualSchema } from "@webiny/api-graphql";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterCreateEventHandler } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/index.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { RoleAfterUpdateEvent } from "@webiny/api-core/features/security/roles/UpdateRole/index.js";
+import { AuditLogsFeature } from "~/AuditLogsFeature.js";
+import { AuditLogsContext, AuditLogsStorage } from "~/abstractions.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe.skipIf(process.env.WEBINY_STORAGE?.includes("sql"))("audit event subscriptions", () => {
+    it("records content, file and role events and exposes them through GraphQL", async () => {
+        const { handler, invoke } = useHandler();
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+
+        const entry = { id: "entry#0001", entryId: "entry" };
+        const model = { isPrivate: false };
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                entry,
+                model,
+                input: {}
+            } as EntryAfterCreateEvent["payload"])
+        );
+        await publisher.publish(
+            new EntryAfterUpdateEvent({
+                entry,
+                original: entry,
+                model,
+                input: {}
+            } as EntryAfterUpdateEvent["payload"])
+        );
+        await publisher.publish(
+            new FileAfterCreateEvent({
+                file: { id: "file" }
+            } as FileAfterCreateEvent["payload"])
+        );
+        await publisher.publish(
+            new RoleAfterUpdateEvent({
+                original: { id: "role" },
+                updated: { id: "role" },
+                input: {}
+            } as RoleAfterUpdateEvent["payload"])
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs {
+                            data { id message entityId createdBy { id } }
+                            error { message }
+                        }
+                    }
+                }`
+            }
+        });
+        expect(response.errors).toBeUndefined();
+        const result = response.data.auditLogs.listAuditLogs;
+        expect(result.error).toBeNull();
+        expect(result.data).toHaveLength(4);
+        expect(result.data).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({ message: "Entry created", entityId: "entry" }),
+                expect.objectContaining({
+                    message: "Entry revision updated",
+                    entityId: "entry#0001"
+                }),
+                expect.objectContaining({ message: "File created", entityId: "file" }),
+                expect.objectContaining({ message: "Role updated", entityId: "role" })
+            ])
+        );
+        const identityId = context.container.resolve(IdentityContext).getIdentity().id;
+        expect(
+            result.data.every(
+                (log: { createdBy: { id: string } }) => log.createdBy.id === identityId
+            )
+        ).toBe(true);
+
+        const [getResponse] = await invoke({
+            body: {
+                query: `query GetAuditLog($id: ID!) {
+                    auditLogs { getAuditLog(id: $id) { data { id } error { message } } }
+                }`,
+                variables: { id: result.data[0].id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toEqual({
+            data: { id: result.data[0].id },
+            error: null
+        });
+    });
+
+    it("initializes each context without registering duplicate handlers", async () => {
+        const existing = await useHandler().handler();
+        const container = new Container();
+        container.registerInstance(FeatureFlags, existing.container.resolve(FeatureFlags));
+        container.registerInstance(AuditLogsStorage, existing.container.resolve(AuditLogsStorage));
+        container.registerInstance(EventPublisher, existing.container.resolve(EventPublisher));
+        AuditLogsFeature.register(container);
+
+        const [schema] = container.resolveAll(GraphQLContextualSchema);
+        const first = { container };
+        const second = { container };
+        await schema.build(first);
+        expect(container.resolve(AuditLogsContext)).toBe(first);
+        expect(container.resolveAll(EntryAfterCreateEventHandler)).toHaveLength(1);
+
+        await schema.build(second);
+        expect(container.resolve(AuditLogsContext)).toBe(second);
+        expect(second).toHaveProperty("auditLogs");
+        expect(container.resolveAll(EntryAfterCreateEventHandler)).toHaveLength(1);
+    });
+});
