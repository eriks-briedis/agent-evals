@@ -0,0 +1,103 @@
+import { describe, expect, it, vi } from "vitest";
+import { Container } from "@webiny/di";
+import { Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { CreateFlpOnFolderCreatedHandler } from "~/features/flp/CreateFlpOnFolderCreated/CreateFlpOnFolderCreatedHandler.js";
+import { UpdateFlpOnFolderUpdatedHandler } from "~/features/flp/UpdateFlpOnFolderUpdated/UpdateFlpOnFolderUpdatedHandler.js";
+import { DeleteFlpOnFolderDeletedHandler } from "~/features/flp/DeleteFlpOnFolderDeleted/DeleteFlpOnFolderDeletedHandler.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { NotifyFolderChangeUseCase } from "~/features/folder/NotifyFolderChange/index.js";
+import { CreateFlpTask } from "~/flp/tasks/createFlp.task.js";
+import { UpdateFlpTask } from "~/flp/tasks/updateFlp.task.js";
+import { DeleteFlpTask } from "~/flp/tasks/deleteFlp.task.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+const folder = { id: "folder-1", type: "cms:article" };
+const error = new Error("storage unavailable");
+const operations = [
+    { eventHandler: CreateFlpOnFolderCreatedHandler, task: CreateFlpTask, id: CREATE_FLP_TASK_ID },
+    { eventHandler: UpdateFlpOnFolderUpdatedHandler, task: UpdateFlpTask, id: UPDATE_FLP_TASK_ID },
+    { eventHandler: DeleteFlpOnFolderDeletedHandler, task: DeleteFlpTask, id: DELETE_FLP_TASK_ID }
+];
+
+describe.each(operations)("FLP task logging: $id", ({ eventHandler, task, id }) => {
+    it.each(["result", "throw"])("logs a %s trigger failure without rejecting", async failure => {
+        const container = new Container();
+        const log = vi.fn();
+        const trigger = vi.fn();
+        if (failure === "result") {
+            trigger.mockResolvedValue(Result.fail(error));
+        } else {
+            trigger.mockRejectedValue(error);
+        }
+        container.registerInstance(Logger, { error: log } as never);
+        container.registerInstance(TaskService, { trigger } as never);
+        container.registerInstance(IdentityContext, { getIdentity: () => null } as never);
+
+        const handler = container.resolveImplementation(eventHandler);
+        await expect(handler.handle({ payload: { folder } } as never)).resolves.toBeUndefined();
+        expect(trigger).toHaveBeenCalledWith(expect.objectContaining({ definition: id }));
+        expect(log).toHaveBeenCalledOnce();
+        expect(log).toHaveBeenCalledWith(
+            expect.objectContaining({
+                err: error,
+                folderId: folder.id,
+                folderType: folder.type,
+                taskDefinitionId: id
+            }),
+            expect.stringContaining("trigger")
+        );
+    });
+
+    it("does not log a successful trigger", async () => {
+        const container = new Container();
+        const log = vi.fn();
+        container.registerInstance(Logger, { error: log } as never);
+        container.registerInstance(TaskService, { trigger: async () => Result.ok({}) } as never);
+        container.registerInstance(IdentityContext, { getIdentity: () => null } as never);
+
+        const handler = container.resolveImplementation(eventHandler);
+        await handler.handle({ payload: { folder } } as never);
+        expect(log).not.toHaveBeenCalled();
+    });
+
+    it("logs task execution failures and preserves the error response", async () => {
+        const container = new Container();
+        const log = vi.fn();
+        const execute = vi.fn().mockRejectedValue(error);
+        container.registerInstance(Logger, { error: log } as never);
+        container.registerInstance(CreateFlpUseCase, { execute });
+        container.registerInstance(UpdateFlpUseCase, { execute });
+        container.registerInstance(DeleteFlpUseCase, { execute });
+        container.registerInstance(NotifyFolderChangeUseCase, { execute: vi.fn() });
+        container.register(task);
+
+        const definition = container.resolveAll(TaskDefinition)[0];
+        const handler = container.resolveImplementation(definition.handler);
+        const result = await handler.run({
+            input: { folder },
+            definition,
+            controller: {
+                runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                response: { error: (error: unknown) => ({ status: "error", error }) }
+            }
+        } as never);
+
+        expect(result).toEqual({ status: "error", error });
+        expect(log).toHaveBeenCalledOnce();
+        expect(log).toHaveBeenCalledWith(
+            expect.objectContaining({
+                err: error,
+                folderId: folder.id,
+                folderType: folder.type,
+                taskDefinitionId: id
+            }),
+            expect.stringContaining("task failed")
+        );
+    });
+});
