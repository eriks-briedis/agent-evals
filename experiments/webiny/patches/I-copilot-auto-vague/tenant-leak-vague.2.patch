+            await barrier;
+            return tenantContext.getTenant().id;
+        });
+        await started;
+        const each = tenantContext.withEachTenant(
+            [createTenant("a", "root"), createTenant("b", "root")],
+            async () => {
+                await barrier;
+                return tenantContext.getTenant().id;
+            }
+        );
+        const callerTenant = tenantContext.getTenant().id;
+        release();
+        expect(await root).toBe("root");
+        expect(await each).toEqual(["a", "b"]);
+        expect(callerTenant).toBe("child");
+        expect(tenantContext.getTenant().id).toBe("child");
+    });
+
+    it("rejects disabled tenants without changing the current tenant", async () => {
+        const disabled = { ...createTenant("disabled", "root"), status: "disabled" as const };
+        await expect(tenantContext.withTenant(disabled, async () => undefined)).rejects.toThrow();
+        expect(tenantContext.getTenant().id).toBe("root");
+    });
