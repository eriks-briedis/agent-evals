diff --git a/packages/api-headless-cms-sql/__tests__/tableManagerRegistration.test.ts b/packages/api-headless-cms-sql/__tests__/tableManagerRegistration.test.ts
new file mode 100644
index 00000000..7e5cb60c
--- /dev/null
+++ b/packages/api-headless-cms-sql/__tests__/tableManagerRegistration.test.ts
@@ -0,0 +1,94 @@
+import { afterEach, expect, it, vi } from "vitest";
+import knexLib from "knex";
+import { Container } from "@webiny/feature/api";
+import { KnexClient } from "@webiny/api-core-sql";
+import { TableManager } from "@webiny/api-core-sql/TableManager.js";
+import { TableNameResolverConfig } from "../src/features/tableNameResolver/abstractions.js";
+import { TableNameResolverFeature } from "../src/features/tableNameResolver/feature.js";
+import { EntryTableManager } from "../src/features/entryTableManager/abstractions.js";
+import { EntryTableManagerFeature } from "../src/features/entryTableManager/feature.js";
+import { GroupSchemaManager } from "../src/features/groupSchemaManager/abstractions.js";
+import { GroupSchemaManagerFeature } from "../src/features/groupSchemaManager/feature.js";
+import { ModelSchemaManager } from "../src/features/modelSchemaManager/abstractions.js";
+import { ModelSchemaManagerFeature } from "../src/features/modelSchemaManager/feature.js";
+
+afterEach(() => {
+    vi.unstubAllGlobals();
+});
+
+it("only registers SQL managers when the test registry is enabled", async () => {
+    const knex = knexLib({ client: "better-sqlite3", connection: { filename: ":memory:" } });
+    const createManagers = () => {
+        const container = new Container();
+        container.registerInstance(KnexClient, { client: knex });
+        container.registerInstance(TableNameResolverConfig, { sharedTables: false });
+        TableNameResolverFeature.register(container);
+        EntryTableManagerFeature.register(container);
+        GroupSchemaManagerFeature.register(container);
+        ModelSchemaManagerFeature.register(container);
+        return [
+            container.resolve(EntryTableManager),
+            container.resolve(GroupSchemaManager),
+            container.resolve(ModelSchemaManager)
+        ] as const;
+    };
+
+    try {
+        vi.stubGlobal("__sqlTableManagers", undefined);
+        for (let i = 0; i < 10; i++) {
+            createManagers();
+        }
+        expect(globalThis).toHaveProperty("__sqlTableManagers", undefined);
+
+        const refs: WeakRef<{ reset(): void }>[] = [];
+        vi.stubGlobal("__sqlTableManagers", refs);
+        const managers = createManagers();
+        expect(refs.map(ref => ref.deref())).toEqual(managers);
+
+        const [entries, groups, models] = managers;
+        const ensureTables = async () => {
+            await entries.ensureTable();
+            await groups.ensure("groups");
+            await models.ensure("models");
+        };
+        await ensureTables();
+        for (const name of [entries.getTableName(), "groups", "models"]) {
+            await knex.schema.dropTable(name);
+        }
+        for (const ref of refs) {
+            ref.deref()?.reset();
+        }
+        await ensureTables();
+        for (const name of [entries.getTableName(), "groups", "models"]) {
+            expect(await knex.schema.hasTable(name)).toBe(true);
+        }
+    } finally {
+        await knex.destroy();
+    }
+});
+
+it("only registers core table managers for test resets", async () => {
+    const knex = knexLib({ client: "better-sqlite3", connection: { filename: ":memory:" } });
+    try {
+        vi.stubGlobal("__sqlTableManagers", undefined);
+        for (let i = 0; i < 10; i++) {
+            new TableManager(knex);
+        }
+        expect(globalThis).toHaveProperty("__sqlTableManagers", undefined);
+
+        const refs: WeakRef<TableManager>[] = [];
+        vi.stubGlobal("__sqlTableManagers", refs);
+        const manager = new TableManager(knex);
+        expect(refs).toHaveLength(1);
+        expect(refs[0].deref()).toBe(manager);
+
+        const create = (table: import("knex").Knex.CreateTableBuilder) => table.text("id");
+        await manager.ensure("test_table", create);
+        await knex.schema.dropTable("test_table");
+        refs[0].deref()?.reset();
+        await manager.ensure("test_table", create);
+        expect(await knex.schema.hasTable("test_table")).toBe(true);
+    } finally {
+        await knex.destroy();
+    }
+});
