diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..30e0df8b
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import {
+    RoleAfterCreateEvent,
+    type RoleAfterCreatePayload
+} from "@webiny/api-core/features/security/roles/CreateRole/index.js";
+import {
+    FileAfterCreateEvent,
+    type FileAfterCreatePayload
+} from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import {
+    EntryAfterCreateEvent,
+    type EntryAfterCreateEventPayload
+} from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import {
+    EntryAfterUpdateEvent,
+    type EntryAfterUpdateEventPayload
+} from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log subscriptions", () => {
+    it("records domain events and exposes them through GraphQL", async () => {
+        const { handler, invoke } = useHandler();
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+
+        const entry = { id: "entry#0001", entryId: "entry", values: { title: "Original" } };
+        const updatedEntry = { ...entry, values: { title: "Updated" } };
+        const model = { modelId: "article", isPrivate: false };
+
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                entry,
+                model,
+                input: {}
+            } as EntryAfterCreateEventPayload)
+        );
+        await publisher.publish(
+            new EntryAfterUpdateEvent({
+                entry: updatedEntry,
+                original: entry,
+                model,
+                input: {}
+            } as EntryAfterUpdateEventPayload)
+        );
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                entry,
+                model: { ...model, isPrivate: true },
+                input: {}
+            } as EntryAfterCreateEventPayload)
+        );
+        await publisher.publish(
+            new FileAfterCreateEvent({
+                file: { id: "file-1", name: "test.jpg" }
+            } as FileAfterCreatePayload)
+        );
+        await publisher.publish(
+            new RoleAfterCreateEvent({
+                role: { id: "role-1", name: "Editor" },
+                input: {}
+            } as RoleAfterCreatePayload)
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs(where: {}) {
+                            data { id app entity action entityId content }
+                            error { message }
+                        }
+                    }
+                }`
+            }
+        });
+
+        expect(response.errors).toBeUndefined();
+        expect(response.data.auditLogs.listAuditLogs.error).toBeNull();
+        const logs = response.data.auditLogs.listAuditLogs.data;
+        expect(logs).toHaveLength(4);
+        expect(logs).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY",
+                    action: "CREATE",
+                    entityId: "entry"
+                }),
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY_REVISION",
+                    action: "UPDATE",
+                    entityId: "entry#0001",
+                    content: JSON.stringify({ before: entry, after: updatedEntry })
+                }),
+                expect.objectContaining({
+                    app: "FILE_MANAGER",
+                    entity: "FILE",
+                    action: "CREATE",
+                    entityId: "file-1"
+                }),
+                expect.objectContaining({
+                    app: "SECURITY",
+                    entity: "ROLE",
+                    action: "CREATE",
+                    entityId: "role-1"
+                })
+            ])
+        );
+
+        const [getResponse] = await invoke({
+            body: {
+                query: `query($id: ID!) {
+                    auditLogs { getAuditLog(id: $id) { data { id } error { message } } }
+                }`,
+                variables: { id: logs[0].id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toEqual({
+            data: { id: logs[0].id },
+            error: null
+        });
+    });
+});
