+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,222 @@
+import { describe, expect, it, vi } from "vitest";
+import { Container } from "@webiny/di";
+import { BaseError, Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import {
+    AnonymousIdentity,
+    IdentityContext
+} from "@webiny/api-core/features/security/IdentityContext/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import type { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import type { Folder } from "~/folder/folder.types.js";
+import { FolderAfterCreateEvent } from "~/features/folder/CreateFolder/events.js";
+import { FolderAfterUpdateEvent } from "~/features/folder/UpdateFolder/events.js";
+import { FolderAfterDeleteEvent } from "~/features/folder/DeleteFolder/events.js";
+import { CreateFlpOnFolderCreatedHandler } from "~/features/flp/CreateFlpOnFolderCreated/CreateFlpOnFolderCreatedHandler.js";
+import { UpdateFlpOnFolderUpdatedHandler } from "~/features/flp/UpdateFlpOnFolderUpdated/UpdateFlpOnFolderUpdatedHandler.js";
+import { DeleteFlpOnFolderDeletedHandler } from "~/features/flp/DeleteFlpOnFolderDeleted/DeleteFlpOnFolderDeletedHandler.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { NotifyFolderChangeUseCase } from "~/features/folder/NotifyFolderChange/index.js";
+import { CreateFlpTask } from "~/flp/tasks/createFlp.task.js";
+import { UpdateFlpTask } from "~/flp/tasks/updateFlp.task.js";
+import { DeleteFlpTask } from "~/flp/tasks/deleteFlp.task.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+
+class TriggerError extends BaseError {
+    readonly code = "TRIGGER_FAILED";
+    constructor() {
+        super({ message: "Cannot queue task" });
+    }
+}
+
+const user = { id: "user", type: "admin", displayName: "User" };
+const folder: Folder = {
+    id: "folder",
+    type: "test",
+    title: "Folder",
+    slug: "folder",
+    path: "/folder",
+    parentId: null,
+    createdOn: "",
+    savedOn: "",
+    modifiedOn: null,
+    createdBy: user,
+    savedBy: user,
+    modifiedBy: null
+};
+
+const cases = [
+    {
+        handle: (container: Container) =>
+            container
+                .resolveImplementation(CreateFlpOnFolderCreatedHandler)
+                .handle(new FolderAfterCreateEvent({ folder })),
+        task: CREATE_FLP_TASK_ID
+    },
+    {
+        handle: (container: Container) =>
+            container
+                .resolveImplementation(UpdateFlpOnFolderUpdatedHandler)
+                .handle(new FolderAfterUpdateEvent({ folder, original: folder, input: {} })),
+        task: UPDATE_FLP_TASK_ID
+    },
+    {
+        handle: (container: Container) =>
+            container
+                .resolveImplementation(DeleteFlpOnFolderDeletedHandler)
+                .handle(new FolderAfterDeleteEvent({ folder })),
+        task: DELETE_FLP_TASK_ID
+    }
+];
+
+const createLogger = () => ({
+    trace: vi.fn(),
+    debug: vi.fn(),
+    info: vi.fn(),
+    warn: vi.fn(),
+    error: vi.fn(),
+    fatal: vi.fn(),
+    log: vi.fn()
+});
+
+describe("FLP failure logging", () => {
+    it.each(cases)(
+        "logs thrown and returned trigger failures for $task without failing the event",
+        async ({ handle, task }) => {
+            const container = new Container();
+            const logger = createLogger();
+            const trigger = vi.fn();
+            container.registerInstance(Logger, logger);
+            container.registerInstance(TaskService, {
+                trigger,
+                abort: vi.fn(),
+                fetchServiceInfo: vi.fn()
+            });
+            container.registerInstance(IdentityContext, {
+                getIdentity: () => new AnonymousIdentity(),
+                setIdentity: vi.fn(),
+                withIdentity: async (_identity, callback) => callback(),
+                getPermission: vi.fn().mockResolvedValue(null),
+                getPermissions: vi.fn().mockResolvedValue([]),
+                listPermissions: vi.fn().mockResolvedValue([]),
+                hasFullAccess: vi.fn().mockResolvedValue(false),
+                withoutAuthorization: async callback => callback(),
+                isAuthorizationEnabled: () => true
+            });
+
+            for (const failure of ["returned", "thrown"] as const) {
+                const error = new TriggerError();
+                if (failure === "returned") {
+                    trigger.mockResolvedValueOnce(Result.fail(error));
+                } else {
+                    trigger.mockRejectedValueOnce(error);
+                }
+                await expect(handle(container)).resolves.toBeUndefined();
+                expect(logger.error).toHaveBeenLastCalledWith(
+                    { err: error, folderId: folder.id, folderType: folder.type, task },
+                    expect.stringContaining("trigger")
+                );
+            }
+
+            logger.error.mockClear();
+            trigger.mockResolvedValueOnce(Result.ok({}));
+            await handle(container);
+            expect(logger.error).not.toHaveBeenCalled();
+        }
+    );
+
+    it.each([
+        {
+            definition: (container: Container): TaskDefinition.Interface =>
+                container.resolveImplementation(CreateFlpTask),
+            task: CREATE_FLP_TASK_ID
+        },
+        {
+            definition: (container: Container): TaskDefinition.Interface =>
+                container.resolveImplementation(UpdateFlpTask),
+            task: UPDATE_FLP_TASK_ID
+        },
+        {
+            definition: (container: Container): TaskDefinition.Interface =>
+                container.resolveImplementation(DeleteFlpTask),
+            task: DELETE_FLP_TASK_ID
+        }
+    ])(
+        "logs execution errors for $task and returns the original task error",
+        async ({ definition, task }) => {
+            const container = new Container();
+            const logger = createLogger();
+            const error = new Error("storage unavailable");
+            const execute = vi.fn().mockRejectedValue(error);
+            container.registerInstance(Logger, logger);
+            container.registerInstance(CreateFlpUseCase, { execute });
+            container.registerInstance(UpdateFlpUseCase, { execute });
+            container.registerInstance(DeleteFlpUseCase, { execute });
+            container.registerInstance(NotifyFolderChangeUseCase, { execute: vi.fn() });
+            const taskDefinition = definition(container);
+            const handler = container.resolveImplementation(taskDefinition.handler);
+            const responseError = vi.fn((err: unknown) => ({ status: "error", error: err }));
+
+            const result = await handler.run({
+                input: { folder },
+                definition: taskDefinition,
+                controller: {
+                    runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                    response: { error: responseError }
+                }
+            } as never);
+
+            expect(logger.error).toHaveBeenCalledWith(
+                { err: error, folderId: folder.id, folderType: folder.type, task },
+                expect.stringContaining("task failed")
+            );
+            expect(responseError).toHaveBeenCalledWith(error);
+            expect(result).toEqual({ status: "error", error });
+        }
+    );
+});
+
+describe("Folder changes when FLP task triggering fails", () => {
+    const { handler } = useHandler();
+
+    it("keeps create, update and delete successful", async () => {
+        const { container } = await handler();
+        const taskService = container.resolve(TaskService);
+        const trigger = vi.spyOn(taskService, "trigger");
+        const error = new TriggerError();
+        const create = container.resolve(CreateFolderUseCase);
+
+        trigger.mockResolvedValueOnce(Result.fail(error));
+        const createdWithoutFlp = await create.execute({
+            title: "No FLP",
+            type: "test",
+            slug: "no-flp",
+            parentId: null
+        });
+        expect(createdWithoutFlp.isOk()).toBe(true);
+
+        const created = await create.execute({
+            title: "Folder",
+            type: "test",
+            slug: "flp-logging",
+            parentId: null
+        });
+        expect(created.isOk()).toBe(true);
+
+        trigger.mockResolvedValueOnce(Result.fail(error));
+        const updated = await container.resolve(UpdateFolderUseCase).execute(created.value.id, {
+            title: "Updated"
+        });
+        expect(updated.isOk()).toBe(true);
+
+        trigger.mockResolvedValueOnce(Result.fail(error));
+        const deleted = await container.resolve(DeleteFolderUseCase).execute(created.value.id);
+        expect(deleted.isOk()).toBe(true);
+    });
+});
