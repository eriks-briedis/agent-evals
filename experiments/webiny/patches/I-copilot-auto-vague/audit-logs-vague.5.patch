+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,106 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { RoleAfterUpdateEvent } from "@webiny/api-core/features/security/roles/UpdateRole/events.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import type { CmsEntry, CmsModel } from "@webiny/api-headless-cms/types/index.js";
+import type { File } from "@webiny/api-file-manager/domain/file/types.js";
+import type { RoleAfterUpdatePayload } from "@webiny/api-core/features/security/roles/UpdateRole/abstractions.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log subscriptions", () => {
+    it("records domain events and exposes them through GraphQL", async () => {
+        const { handler, invoke } = useHandler();
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+        const model = { isPrivate: false } as CmsModel;
+        const entry = { id: "entry#1", entryId: "entry", values: { title: "Before" } } as CmsEntry;
+        const updated = { ...entry, values: { title: "After" } };
+        const file = { id: "file", name: "test.jpg" } as File;
+        const roles = {
+            original: { id: "role", name: "Before" },
+            updated: { id: "role", name: "After" }
+        } as RoleAfterUpdatePayload;
+
+        await publisher.publish(new EntryAfterCreateEvent({ model, entry, input: {} }));
+        await publisher.publish(
+            new EntryAfterUpdateEvent({ model, original: entry, entry: updated, input: {} })
+        );
+        await publisher.publish(new FileAfterCreateEvent({ file }));
+        await publisher.publish(new RoleAfterUpdateEvent(roles));
+        await publisher.publish(
+            new EntryAfterCreateEvent({ model: { ...model, isPrivate: true }, entry, input: {} })
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs {
+                            data { id app entity action entityId message createdBy { id } }
+                            error { message }
+                        }
+                    }
+                }`
+            }
+        });
+
+        expect(response.errors).toBeUndefined();
+        expect(response.data.auditLogs.listAuditLogs.error).toBeNull();
+        expect(response.data.auditLogs.listAuditLogs.data).toHaveLength(4);
+        expect(response.data.auditLogs.listAuditLogs.data).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY",
+                    action: "CREATE",
+                    entityId: "entry"
+                }),
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY_REVISION",
+                    action: "UPDATE",
+                    entityId: "entry#1"
+                }),
+                expect.objectContaining({
+                    app: "FILE_MANAGER",
+                    entity: "FILE",
+                    action: "CREATE",
+                    entityId: "file"
+                }),
+                expect.objectContaining({
+                    app: "SECURITY",
+                    entity: "ROLE",
+                    action: "UPDATE",
+                    entityId: "role"
+                })
+            ])
+        );
+        expect(response.data.auditLogs.listAuditLogs.data).toEqual(
+            expect.arrayContaining([expect.objectContaining({ createdBy: { id: "id-12345678" } })])
+        );
+
+        const log = response.data.auditLogs.listAuditLogs.data.find(
+            (item: { entityId: string }) => item.entityId === "file"
+        );
+        const [getResponse] = await invoke({
+            body: {
+                query: `query GetAuditLog($id: ID!) {
+                    auditLogs {
+                        getAuditLog(id: $id) {
+                            data { id entityId message }
+                            error { message }
+                        }
+                    }
+                }`,
+                variables: { id: log.id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toEqual({
+            data: { id: log.id, entityId: "file", message: "File created" },
+            error: null
+        });
+    });
+});
