diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..86ad0adf
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,157 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { RoleAfterUpdateEvent } from "@webiny/api-core/features/security/roles/UpdateRole/events.js";
+import type { Role } from "@webiny/api-core/types/security.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import type { File } from "@webiny/api-file-manager/domain/file/types.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import type { CmsEntry, CmsModel } from "@webiny/api-headless-cms/types/index.js";
+import { useHandler } from "~tests/helpers/useHandler.js";
+
+describe("audit log subscriptions", () => {
+    it("records domain events and exposes them through GraphQL", async () => {
+        const identity = { id: "editor", type: "admin", displayName: "Editor" };
+        const { handler, invoke } = useHandler({ identity });
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+        const model = { modelId: "article", isPrivate: false } as CmsModel;
+        const entry: CmsEntry = {
+            tenant: "root",
+            id: "entry#0001",
+            entryId: "entry",
+            modelId: "article",
+            version: 1,
+            locked: false,
+            status: "draft",
+            createdOn: "2026-01-01T00:00:00.000Z",
+            savedOn: "2026-01-01T00:00:00.000Z",
+            modifiedOn: null,
+            deletedOn: null,
+            restoredOn: null,
+            firstPublishedOn: null,
+            lastPublishedOn: null,
+            createdBy: identity,
+            savedBy: identity,
+            modifiedBy: null,
+            deletedBy: null,
+            restoredBy: null,
+            firstPublishedBy: null,
+            lastPublishedBy: null,
+            revisionCreatedOn: "2026-01-01T00:00:00.000Z",
+            revisionSavedOn: "2026-01-01T00:00:00.000Z",
+            revisionModifiedOn: null,
+            revisionDeletedOn: null,
+            revisionRestoredOn: null,
+            revisionFirstPublishedOn: null,
+            revisionLastPublishedOn: null,
+            revisionCreatedBy: identity,
+            revisionSavedBy: identity,
+            revisionModifiedBy: null,
+            revisionDeletedBy: null,
+            revisionRestoredBy: null,
+            revisionFirstPublishedBy: null,
+            revisionLastPublishedBy: null,
+            live: null,
+            revisionDescription: undefined,
+            expiresAt: null,
+            values: { title: "Before" }
+        };
+        const updatedEntry = { ...entry, values: { title: "After" } };
+        const file = { id: "file", name: "image.png" } as File;
+        const role = { id: "role", name: "Editor" } as Role;
+        const updatedRole = { ...role, name: "Senior editor" };
+
+        await publisher.publish(
+            new EntryAfterCreateEvent({ model, entry, input: { values: entry.values } })
+        );
+        await publisher.publish(
+            new EntryAfterUpdateEvent({
+                model,
+                original: entry,
+                entry: updatedEntry,
+                input: { values: updatedEntry.values }
+            })
+        );
+        await publisher.publish(new FileAfterCreateEvent({ file }));
+        await publisher.publish(
+            new RoleAfterUpdateEvent({
+                original: role,
+                updated: updatedRole,
+                input: { name: updatedRole.name }
+            })
+        );
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                model: { ...model, isPrivate: true },
+                entry,
+                input: { values: entry.values }
+            })
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs(where: {}) {
+                            data { id app entity action entityId message createdBy { id } }
+                            error { message }
+                        }
+                    }
+                }`
+            }
+        });
+
+        expect(response.errors).toBeUndefined();
+        expect(response.data.auditLogs.listAuditLogs.error).toBeNull();
+        expect(response.data.auditLogs.listAuditLogs.data).toHaveLength(4);
+        expect(response.data.auditLogs.listAuditLogs.data).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY",
+                    action: "CREATE",
+                    entityId: entry.entryId
+                }),
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY_REVISION",
+                    action: "UPDATE",
+                    entityId: entry.id
+                }),
+                expect.objectContaining({
+                    app: "FILE_MANAGER",
+                    entity: "FILE",
+                    action: "CREATE",
+                    entityId: file.id
+                }),
+                expect.objectContaining({
+                    app: "SECURITY",
+                    entity: "ROLE",
+                    action: "UPDATE",
+                    entityId: role.id
+                })
+            ])
+        );
+        for (const log of response.data.auditLogs.listAuditLogs.data) {
+            expect(log.createdBy.id).toBe(identity.id);
+        }
+
+        const id = response.data.auditLogs.listAuditLogs.data[0].id;
+        const [getResponse] = await invoke({
+            body: {
+                query: `query ($id: ID!) {
+                    auditLogs {
+                        getAuditLog(id: $id) {
+                            data { id }
+                            error { message }
+                        }
+                    }
+                }`,
+                variables: { id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toEqual({ data: { id }, error: null });
+    });
+});
