+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,122 @@
+import { describe, expect, it, vi } from "vitest";
+import { BaseError, Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+class TriggerError extends BaseError {
+    readonly code = "TRIGGER_FAILED";
+    constructor() {
+        super({ message: "Task service unavailable" });
+    }
+}
+
+describe("FLP failure logging", () => {
+    const { handler } = useHandler();
+
+    it.each(["create", "update", "delete"] as const)(
+        "logs both returned and thrown trigger failures without failing folder %s",
+        async operation => {
+            for (const failure of ["result", "throw"] as const) {
+                const { container } = await handler();
+                const createFolder = container.resolve(CreateFolderUseCase);
+                const existing = await createFolder.execute({
+                    type: "logging",
+                    title: "Existing",
+                    slug: `existing-${operation}-${failure}`,
+                    parentId: null
+                });
+                expect(existing.isOk()).toBe(true);
+
+                const logger = container.resolve(Logger);
+                container.registerInstance(Logger, logger);
+                const log = vi.spyOn(logger, "error").mockImplementation(() => {});
+                const error = new TriggerError();
+                const trigger = vi.spyOn(container.resolve(TaskService), "trigger");
+                if (failure === "result") {
+                    trigger.mockResolvedValue(Result.fail(error));
+                } else {
+                    trigger.mockRejectedValue(error);
+                }
+
+                const result =
+                    operation === "create"
+                        ? await createFolder.execute({
+                              type: "logging",
+                              title: "New",
+                              slug: `new-${failure}`,
+                              parentId: null
+                          })
+                        : operation === "update"
+                          ? await container
+                                .resolve(UpdateFolderUseCase)
+                                .execute(existing.value.id, {
+                                    title: "Changed"
+                                })
+                          : await container.resolve(DeleteFolderUseCase).execute(existing.value.id);
+
+                expect(result.isOk()).toBe(true);
+                expect(log).toHaveBeenCalledWith(
+                    {
+                        err: error,
+                        folderId: operation === "create" ? expect.any(String) : existing.value.id,
+                        folderType: "logging"
+                    },
+                    `Failed to trigger ${operation} FLP task.`
+                );
+            }
+        }
+    );
+
+    it.each([
+        ["create", CREATE_FLP_TASK_ID],
+        ["update", UPDATE_FLP_TASK_ID],
+        ["delete", DELETE_FLP_TASK_ID]
+    ] as const)("logs %s task failures and returns the original error", async (operation, id) => {
+        const { container } = await handler();
+        const created = await container.resolve(CreateFolderUseCase).execute({
+            type: "logging",
+            title: "Task folder",
+            slug: `task-${operation}`,
+            parentId: null
+        });
+        const folder = created.value;
+        const logger = container.resolve(Logger);
+        container.registerInstance(Logger, logger);
+        const log = vi.spyOn(logger, "error").mockImplementation(() => {});
+        const error = new Error("FLP storage failed");
+        const failingUseCase = {
+            execute: async () => {
+                throw error;
+            }
+        };
+        container.registerInstance(CreateFlpUseCase, failingUseCase);
+        container.registerInstance(UpdateFlpUseCase, failingUseCase);
+        container.registerInstance(DeleteFlpUseCase, failingUseCase);
+
+        const definition = container.resolveAll(TaskDefinition).find(task => task.id === id)!;
+        const task = container.resolveImplementation(definition.handler);
+        const result = await task.run({
+            input: { folder },
+            definition,
+            controller: {
+                runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                response: { error: (error: unknown) => ({ status: "error", error }) }
+            }
+        } as never);
+
+        expect(result).toEqual({ status: "error", error });
+        expect(log).toHaveBeenCalledWith(
+            { err: error, folderId: folder.id, folderType: folder.type },
+            `${operation[0].toUpperCase()}${operation.slice(1)} FLP task failed.`
+        );
+    });
+});
