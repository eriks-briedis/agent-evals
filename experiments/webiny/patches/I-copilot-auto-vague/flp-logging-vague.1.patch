+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,122 @@
+import { describe, expect, it, vi } from "vitest";
+import { Container } from "@webiny/di";
+import { Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { CreateFlpOnFolderCreatedHandler } from "~/features/flp/CreateFlpOnFolderCreated/CreateFlpOnFolderCreatedHandler.js";
+import { UpdateFlpOnFolderUpdatedHandler } from "~/features/flp/UpdateFlpOnFolderUpdated/UpdateFlpOnFolderUpdatedHandler.js";
+import { DeleteFlpOnFolderDeletedHandler } from "~/features/flp/DeleteFlpOnFolderDeleted/DeleteFlpOnFolderDeletedHandler.js";
+import { FolderAfterCreateEvent } from "~/features/folder/CreateFolder/events.js";
+import { FolderAfterUpdateEvent } from "~/features/folder/UpdateFolder/events.js";
+import { FolderAfterDeleteEvent } from "~/features/folder/DeleteFolder/events.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { NotifyFolderChangeUseCase } from "~/features/folder/NotifyFolderChange/index.js";
+import { CreateFlpTask } from "~/flp/tasks/createFlp.task.js";
+import { UpdateFlpTask } from "~/flp/tasks/updateFlp.task.js";
+import { DeleteFlpTask } from "~/flp/tasks/deleteFlp.task.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+import type { Folder } from "~/folder/folder.types.js";
+
+const folder = { id: "folder-1", type: "test" } as Folder;
+const cases = [
+    {
+        id: CREATE_FLP_TASK_ID,
+        eventHandler: CreateFlpOnFolderCreatedHandler,
+        event: new FolderAfterCreateEvent({ folder }),
+        task: CreateFlpTask,
+        useCase: CreateFlpUseCase
+    },
+    {
+        id: UPDATE_FLP_TASK_ID,
+        eventHandler: UpdateFlpOnFolderUpdatedHandler,
+        event: new FolderAfterUpdateEvent({ folder, original: folder, input: {} }),
+        task: UpdateFlpTask,
+        useCase: UpdateFlpUseCase
+    },
+    {
+        id: DELETE_FLP_TASK_ID,
+        eventHandler: DeleteFlpOnFolderDeletedHandler,
+        event: new FolderAfterDeleteEvent({ folder }),
+        task: DeleteFlpTask,
+        useCase: DeleteFlpUseCase
+    }
+];
+
+describe.each(cases)("FLP diagnostics for $id", ({ id, eventHandler, event, task, useCase }) => {
+    it.each(["rejection", "failed result"])(
+        "logs a scheduling %s without failing the folder event",
+        async failure => {
+            const container = new Container();
+            const error = new Error("scheduling failed");
+            const trigger = vi.fn();
+            if (failure === "rejection") {
+                trigger.mockRejectedValue(error);
+            } else {
+                trigger.mockResolvedValue(Result.fail(error));
+            }
+            const logError = vi.fn();
+            container.registerInstance(Logger, { error: logError } as never);
+            container.registerInstance(TaskService, { trigger } as never);
+            container.registerInstance(IdentityContext, { getIdentity: () => null } as never);
+
+            const handler = container.resolveImplementation(eventHandler);
+            await expect(handler.handle(event as never)).resolves.toBeUndefined();
+            expect(trigger).toHaveBeenCalledWith(
+                expect.objectContaining({
+                    definition: id,
+                    input: expect.objectContaining({ folder })
+                })
+            );
+            expect(logError).toHaveBeenCalledOnce();
+            expect(logError).toHaveBeenCalledWith(
+                { err: error, folderId: folder.id, folderType: folder.type, taskDefinitionId: id },
+                expect.stringContaining("Failed to schedule")
+            );
+        }
+    );
+
+    it("logs task failures and returns the original error response", async () => {
+        const container = new Container();
+        const error = new Error("storage failed");
+        const logError = vi.fn();
+        container.registerInstance(Logger, { error: logError } as never);
+        container.registerInstance(useCase, { execute: vi.fn().mockRejectedValue(error) } as never);
+        container.registerInstance(NotifyFolderChangeUseCase, { execute: vi.fn() } as never);
+        const definition = container.resolveImplementation(task);
+        const handler = container.resolveImplementation(definition.handler);
+        const responseError = vi.fn((err: unknown) => ({ status: "error", error: err }));
+
+        const result = await handler.run({
+            input: { folder },
+            definition,
+            controller: {
+                runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                response: { error: responseError }
+            }
+        } as never);
+
+        expect(result).toEqual({ status: "error", error });
+        expect(responseError).toHaveBeenCalledWith(error);
+        expect(logError).toHaveBeenCalledOnce();
+        expect(logError).toHaveBeenCalledWith(
+            { err: error, folderId: folder.id, folderType: folder.type, taskDefinitionId: id },
+            expect.stringContaining("task failed")
+        );
+    });
+
+    it("does not log when scheduling succeeds", async () => {
+        const container = new Container();
+        const logError = vi.fn();
+        container.registerInstance(Logger, { error: logError } as never);
+        container.registerInstance(TaskService, {
+            trigger: vi.fn().mockResolvedValue(Result.ok({}))
+        } as never);
+        container.registerInstance(IdentityContext, { getIdentity: () => null } as never);
+
+        await container.resolveImplementation(eventHandler).handle(event as never);
+        expect(logError).not.toHaveBeenCalled();
+    });
+});
