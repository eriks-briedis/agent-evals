diff --git a/packages/api-audit-logs/__tests__/subscriptions.test.ts b/packages/api-audit-logs/__tests__/subscriptions.test.ts
new file mode 100644
index 00000000..93a7d1ad
--- /dev/null
+++ b/packages/api-audit-logs/__tests__/subscriptions.test.ts
@@ -0,0 +1,155 @@
+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { IdentityContext } from "@webiny/api-core/features/security/IdentityContext/abstractions.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import { RoleAfterCreateEvent } from "@webiny/api-core/features/security/roles/CreateRole/events.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log subscriptions", () => {
+    it("records content, file and role events and exposes them through GraphQL", async () => {
+        const { handler, invoke } = useHandler();
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+
+        const identity = { id: "editor", type: "admin", displayName: "Editor" };
+        const entry: EntryAfterCreateEvent["payload"]["entry"] = {
+            id: "entry#0001",
+            entryId: "entry",
+            tenant: "root",
+            modelId: "article",
+            version: 1,
+            locked: false,
+            status: "draft",
+            values: { title: "After" },
+            revisionCreatedOn: "2026-01-01T00:00:00.000Z",
+            revisionSavedOn: "2026-01-01T00:00:00.000Z",
+            revisionModifiedOn: null,
+            revisionDeletedOn: null,
+            revisionRestoredOn: null,
+            revisionFirstPublishedOn: null,
+            revisionLastPublishedOn: null,
+            revisionCreatedBy: identity,
+            revisionSavedBy: identity,
+            revisionModifiedBy: null,
+            revisionDeletedBy: null,
+            revisionRestoredBy: null,
+            revisionFirstPublishedBy: null,
+            revisionLastPublishedBy: null,
+            createdOn: "2026-01-01T00:00:00.000Z",
+            savedOn: "2026-01-01T00:00:00.000Z",
+            modifiedOn: null,
+            deletedOn: null,
+            restoredOn: null,
+            firstPublishedOn: null,
+            lastPublishedOn: null,
+            createdBy: identity,
+            savedBy: identity,
+            modifiedBy: null,
+            deletedBy: null,
+            restoredBy: null,
+            firstPublishedBy: null,
+            lastPublishedBy: null,
+            live: null,
+            revisionDescription: undefined,
+            expiresAt: null
+        };
+        const original = { ...entry, values: { title: "Before" } };
+        const model = { isPrivate: false } as EntryAfterCreateEvent["payload"]["model"];
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                entry,
+                model,
+                input: { values: entry.values }
+            })
+        );
+        await publisher.publish(
+            new EntryAfterUpdateEvent({
+                entry,
+                original,
+                model,
+                input: { values: entry.values }
+            })
+        );
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                entry: { ...entry, entryId: "private" },
+                model: { ...model, isPrivate: true },
+                input: { values: entry.values }
+            })
+        );
+        await publisher.publish(
+            new FileAfterCreateEvent({
+                file: { id: "file", name: "test.txt" }
+            } as FileAfterCreateEvent["payload"])
+        );
+        await publisher.publish(
+            new RoleAfterCreateEvent({
+                role: { id: "role", name: "Editor" },
+                input: { name: "Editor" }
+            } as RoleAfterCreateEvent["payload"])
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs(where: {}) { data { id app entity action entityId content createdBy { id } } error { message } }
+                    }
+                }`
+            }
+        });
+        expect(response.errors).toBeUndefined();
+        expect(response.data.auditLogs.listAuditLogs.error).toBeNull();
+        const logs = response.data.auditLogs.listAuditLogs.data;
+        expect(logs).toHaveLength(4);
+        expect(logs).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY",
+                    action: "CREATE",
+                    entityId: "entry"
+                }),
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY_REVISION",
+                    action: "UPDATE",
+                    entityId: "entry#0001",
+                    content: JSON.stringify({ before: original, after: entry })
+                }),
+                expect.objectContaining({
+                    app: "FILE_MANAGER",
+                    entity: "FILE",
+                    action: "CREATE",
+                    entityId: "file"
+                }),
+                expect.objectContaining({
+                    app: "SECURITY",
+                    entity: "ROLE",
+                    action: "CREATE",
+                    entityId: "role"
+                })
+            ])
+        );
+        const identityId = context.container.resolve(IdentityContext).getIdentity().id;
+        expect(
+            logs.every((log: { createdBy: { id: string } }) => log.createdBy.id === identityId)
+        ).toBe(true);
+
+        const [getResponse] = await invoke({
+            body: {
+                query: `query GetAuditLog($id: ID!) {
+                    auditLogs { getAuditLog(id: $id) { data { id } error { message } } }
+                }`,
+                variables: { id: logs[0].id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toEqual({
+            data: { id: logs[0].id },
+            error: null
+        });
+    });
+});
