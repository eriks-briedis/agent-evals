@@ -0,0 +1,138 @@
+import { describe, expect, it, vi } from "vitest";
+import { BaseError, Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+
+class TriggerError extends BaseError {
+    readonly code = "TRIGGER_FAILED";
+    constructor() {
+        super({ message: "Trigger failed" });
+    }
+}
+
+const createLogger = (): Logger.Interface => ({
+    trace: vi.fn(),
+    debug: vi.fn(),
+    info: vi.fn(),
+    warn: vi.fn(),
+    error: vi.fn(),
+    fatal: vi.fn(),
+    log: vi.fn()
+});
+
+describe("FLP failure logging", () => {
+    const { handler } = useHandler();
+    const operations = [
+        { operation: "create", task: CREATE_FLP_TASK_ID },
+        { operation: "update", task: UPDATE_FLP_TASK_ID },
+        { operation: "delete", task: DELETE_FLP_TASK_ID }
+    ] as const;
+
+    it.each(operations.flatMap(item => [false, true].map(throws => ({ ...item, throws }))))(
+        "logs a $operation trigger failure (throws: $throws) without failing the folder change",
+        async ({ operation, task, throws }) => {
+            const context = await handler();
+            const createFolder = context.container.resolve(CreateFolderUseCase);
+            const original = (
+                await createFolder.execute({
+                    title: "Original",
+                    slug: "original",
+                    type: "logging",
+                    parentId: null
+                })
+            ).value;
+            const logger = createLogger();
+            context.container.registerInstance(Logger, logger);
+            const error = new TriggerError();
+            const trigger = vi.spyOn(context.container.resolve(TaskService), "trigger");
+            if (throws) {
+                trigger.mockRejectedValue(error);
+            } else {
+                trigger.mockResolvedValue(Result.fail(error));
+            }
+
+            try {
+                let folderId = original.id;
+                if (operation === "create") {
+                    const result = await createFolder.execute({
+                        title: "New",
+                        slug: "new",
+                        type: "logging",
+                        parentId: null
+                    });
+                    expect(result.isOk()).toBe(true);
+                    folderId = result.value.id;
+                } else if (operation === "update") {
+                    const result = await context.container
+                        .resolve(UpdateFolderUseCase)
+                        .execute(original.id, { title: "Changed" });
+                    expect(result.isOk()).toBe(true);
+                } else {
+                    const result = await context.container
+                        .resolve(DeleteFolderUseCase)
+                        .execute(original.id);
+                    expect(result.isOk()).toBe(true);
+                }
+                expect(logger.error).toHaveBeenCalledWith(
+                    { err: error, folderId, folderType: "logging", task },
+                    expect.stringContaining("Failed to trigger folder permission")
+                );
+            } finally {
+                trigger.mockRestore();
+            }
+        }
+    );
+
+    it.each(operations)(
+        "logs errors from the $operation permission task",
+        async ({ operation, task }) => {
+            const context = await handler();
+            const folder = (
+                await context.container.resolve(CreateFolderUseCase).execute({
+                    title: "Folder",
+                    slug: "folder",
+                    type: "logging",
+                    parentId: null
+                })
+            ).value;
+            const error = new Error("Storage failed");
+            const execute = vi.fn().mockRejectedValue(error);
+            if (operation === "create") {
+                context.container.registerInstance(CreateFlpUseCase, { execute });
+            } else if (operation === "update") {
+                context.container.registerInstance(UpdateFlpUseCase, { execute });
+            } else {
+                context.container.registerInstance(DeleteFlpUseCase, { execute });
+            }
+            const logger = createLogger();
+            context.container.registerInstance(Logger, logger);
+            const definition = context.container
+                .resolveAll(TaskDefinition)
+                .find(candidate => candidate.id === task)!;
+            const taskHandler = context.container.resolveImplementation(definition.handler);
+            const result = await taskHandler.run({
+                input: { folder },
+                definition,
+                controller: {
+                    runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                    response: { error: (error: unknown) => ({ status: "error", error }) }
+                }
+            } as never);
+
+            expect(result).toEqual({ status: "error", error });
+            expect(logger.error).toHaveBeenCalledWith(
+                { err: error, folderId: folder.id, folderType: folder.type, task },
+                expect.stringContaining("task failed")
+            );
+        }
+    );
+});
