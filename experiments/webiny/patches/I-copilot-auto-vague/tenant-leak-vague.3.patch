+                    const tenant = tenantContext.getTenant().id;
+                    release();
+                    return tenant;
+                }
+            }
+        });
+
+        expect(result.errors).toBeUndefined();
+        expect(result.data).toEqual({ profile: "root", data: "child" });
+        expect(tenantContext.getTenant().id).toBe("child");
+    });
+
+    it("isolates nested scopes and scoped setTenant calls", async () => {
+        const result = await tenantContext.withTenant(createTenant("outer", "root"), async () => {
+            await tenantContext.withTenant(createTenant("inner", "root"), async () => {
+                tenantContext.setTenant(createTenant("changed", "root"));
+                await Promise.resolve();
+                expect(tenantContext.getTenant().id).toBe("changed");
+            });
+            expect(tenantContext.getTenant().id).toBe("outer");
+            tenantContext.setTenant(createTenant("outer-changed", "root"));
+            return tenantContext.getTenant().id;
+        });
+
+        expect(result).toBe("outer-changed");
+        expect(tenantContext.getTenant().id).toBe("root");
+    });
+
+    it("keeps each tenant scoped when iterations overlap other work", async () => {
+        const seen: string[] = [];
+        const tenants = [createTenant("a", "root"), createTenant("b", "root")];
+        let started!: () => void;
+        const scopeStarted = new Promise<void>(resolve => (started = resolve));
+        let release!: () => void;
+        const gate = new Promise<void>(resolve => (release = resolve));
+        const work = tenantContext.withEachTenant(tenants, async tenant => {
+            if (tenant.id === "a") {
+                started();
+                await gate;
+            }
+            seen.push(tenantContext.getTenant().id);
+            return tenant.id;
+        });
+        await scopeStarted;
+        const outside = tenantContext.getTenant().id;
+        release();
+
+        expect(await work).toEqual(["a", "b"]);
+        expect(seen).toEqual(["a", "b"]);
+        expect(outside).toBe("root");
+        expect(tenantContext.getTenant().id).toBe("root");
+    });
+
+    it("rejects disabled tenants without affecting the current scope", async () => {
+        const disabled = { ...createTenant("disabled", "root"), status: "disabled" as const };
+        await expect(tenantContext.withTenant(disabled, async () => {})).rejects.toThrow();
+        expect(tenantContext.getTenant().id).toBe("root");
+    });
+
+    it("restores nested scopes when a callback rejects", async () => {
+        await tenantContext.withTenant(createTenant("outer", "root"), async () => {
+            await expect(
+                tenantContext.withEachTenant([createTenant("inner", "root")], async () => {
+                    throw new Error("Boom!");
+                })
+            ).rejects.toThrow("Boom!");
+            expect(tenantContext.getTenant().id).toBe("outer");
+        });
+        expect(tenantContext.getTenant().id).toBe("root");
+    });
 });
 
