@@ -0,0 +1,134 @@
+import { describe, expect, it, vi } from "vitest";
+import { BaseError, Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+class TriggerError extends BaseError {
+    readonly code = "TRIGGER_FAILED";
+    constructor() {
+        super({ message: "Task could not be queued" });
+    }
+}
+
+describe("FLP failure logging", () => {
+    const { handler } = useHandler();
+    const operations = [
+        { operation: "create", task: CREATE_FLP_TASK_ID },
+        { operation: "update", task: UPDATE_FLP_TASK_ID },
+        { operation: "delete", task: DELETE_FLP_TASK_ID }
+    ] as const;
+
+    it.each(
+        operations.flatMap(
+            item =>
+                [
+                    { ...item, failure: "throw" },
+                    { ...item, failure: "result" }
+                ] as const
+        )
+    )(
+        "logs a $failure queue failure after folder $operation without failing the folder change",
+        async ({ operation, task, failure }) => {
+            const { container } = await handler();
+            const logger = container.resolve(Logger);
+            const log = vi.spyOn(logger, "error").mockImplementation(() => {});
+            container.registerInstance(Logger, logger);
+            const createFolder = container.resolve(CreateFolderUseCase);
+            const existing = await createFolder.execute({
+                title: "Existing",
+                slug: "existing",
+                type: "logging",
+                parentId: null
+            });
+            expect(existing.isOk()).toBe(true);
+            expect(log).not.toHaveBeenCalled();
+
+            const error = new TriggerError();
+            const trigger = vi.spyOn(container.resolve(TaskService), "trigger");
+            if (failure === "throw") {
+                trigger.mockRejectedValueOnce(error);
+            } else {
+                trigger.mockResolvedValueOnce(Result.fail(error));
+            }
+            let folderId = existing.value.id;
+            if (operation === "create") {
+                const result = await createFolder.execute({
+                    title: "New",
+                    slug: "new",
+                    type: "logging",
+                    parentId: null
+                });
+                expect(result.isOk()).toBe(true);
+                folderId = result.value.id;
+            } else if (operation === "update") {
+                const result = await container.resolve(UpdateFolderUseCase).execute(folderId, {
+                    title: "Changed"
+                });
+                expect(result.isOk()).toBe(true);
+            } else {
+                const result = await container.resolve(DeleteFolderUseCase).execute(folderId);
+                expect(result.isOk()).toBe(true);
+            }
+
+            expect(log).toHaveBeenCalledOnce();
+            expect(log).toHaveBeenCalledWith(
+                { err: error, folderId, folderType: "logging", taskDefinition: task },
+                expect.stringContaining("Failed to trigger FLP")
+            );
+        }
+    );
+
+    it.each(operations)(
+        "logs a failed FLP $operation task and returns its error",
+        async ({ operation, task }) => {
+            const { container } = await handler();
+            const created = await container.resolve(CreateFolderUseCase).execute({
+                title: "Folder",
+                slug: "folder",
+                type: "logging",
+                parentId: null
+            });
+            const folder = created.value;
+            const error = new Error("Permission storage failed");
+            const logger = container.resolve(Logger);
+            const log = vi.spyOn(logger, "error").mockImplementation(() => {});
+            container.registerInstance(Logger, logger);
+            const execute = vi.fn().mockRejectedValueOnce(error);
+
+            if (operation === "create") {
+                container.registerInstance(CreateFlpUseCase, { execute });
+            } else if (operation === "update") {
+                container.registerInstance(UpdateFlpUseCase, { execute });
+            } else {
+                container.registerInstance(DeleteFlpUseCase, { execute });
+            }
+
+            const definition = container.resolveAll(TaskDefinition).find(item => item.id === task)!;
+            const taskHandler = container.resolveImplementation(definition.handler);
+            const result = await taskHandler.run({
+                input: { folder },
+                definition,
+                controller: {
+                    runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                    response: { error: (error: unknown) => ({ status: "error", error }) }
+                }
+            } as never);
+
+            expect(result).toEqual({ status: "error", error });
+            expect(log).toHaveBeenCalledOnce();
+            expect(log).toHaveBeenCalledWith(
+                { err: error, folderId: folder.id, folderType: folder.type, taskDefinition: task },
+                expect.stringContaining("task failed")
+            );
+        }
+    );
+});
