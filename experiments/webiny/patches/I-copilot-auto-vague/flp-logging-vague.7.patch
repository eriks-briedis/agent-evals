new file mode 100644
index 00000000..4403bd50
--- /dev/null
+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,151 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { BaseError, Result } from "@webiny/feature/api";
+import { LoggerImpl } from "@webiny/api-core/features/logger/LoggerService.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/CreateFlpUseCase.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/UpdateFlpUseCase.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/DeleteFlpUseCase.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+
+class TriggerError extends BaseError {
+    readonly code = "TRIGGER_FAILED";
+    constructor() {
+        super({ message: "Task service unavailable" });
+    }
+}
+
+describe("Folder permission failure logging", () => {
+    const { handler } = useHandler();
+    afterEach(() => vi.restoreAllMocks());
+
+    it("does not log errors when folder permission tasks succeed", async () => {
+        const context = await handler();
+        const logger = vi.spyOn(LoggerImpl.prototype, "error").mockImplementation(() => {});
+        const created = await context.container.resolve(CreateFolderUseCase).execute({
+            title: "Folder",
+            slug: "successful-tasks",
+            type: "logging",
+            parentId: null
+        });
+        expect(created.isOk()).toBe(true);
+        const updated = await context.container
+            .resolve(UpdateFolderUseCase)
+            .execute(created.value.id, { title: "Changed" });
+        expect(updated.isOk()).toBe(true);
+        const deleted = await context.container
+            .resolve(DeleteFolderUseCase)
+            .execute(created.value.id);
+        expect(deleted.isOk()).toBe(true);
+        expect(logger).not.toHaveBeenCalled();
+    });
+
+    it.each([
+        ["create", CREATE_FLP_TASK_ID],
+        ["update", UPDATE_FLP_TASK_ID],
+        ["delete", DELETE_FLP_TASK_ID]
+    ] as const)(
+        "logs rejected and thrown %s task triggers without failing the folder change",
+        async (operation, taskDefinition) => {
+            for (const failure of ["result", "throw"] as const) {
+                const context = await handler();
+                const create = context.container.resolve(CreateFolderUseCase);
+                const existing = await create.execute({
+                    title: "Existing",
+                    slug: `existing-${operation}-${failure}`,
+                    type: "logging",
+                    parentId: null
+                });
+                expect(existing.isOk()).toBe(true);
+
+                const error = new TriggerError();
+                const logger = vi.spyOn(LoggerImpl.prototype, "error").mockImplementation(() => {});
+                const trigger = vi.spyOn(context.container.resolve(TaskService), "trigger");
+                if (failure === "result") {
+                    trigger.mockImplementation(async () => Result.fail(error));
+                } else {
+                    trigger.mockRejectedValue(error);
+                }
+
+                const result =
+                    operation === "create"
+                        ? await create.execute({
+                              title: "New",
+                              slug: `new-${failure}`,
+                              type: "logging",
+                              parentId: null
+                          })
+                        : operation === "update"
+                          ? await context.container
+                                .resolve(UpdateFolderUseCase)
+                                .execute(existing.value.id, {
+                                    title: "Changed"
+                                })
+                          : await context.container
+                                .resolve(DeleteFolderUseCase)
+                                .execute(existing.value.id);
+
+                expect(result.isOk()).toBe(true);
+                expect(logger).toHaveBeenCalledWith(
+                    expect.objectContaining({
+                        err: error,
+                        folderId: operation === "create" ? expect.any(String) : existing.value.id,
+                        folderType: "logging",
+                        taskDefinition
+                    }),
+                    expect.stringContaining("Failed to trigger")
+                );
+                vi.restoreAllMocks();
+            }
+        }
+    );
+
+    it.each([
+        [CREATE_FLP_TASK_ID, CreateFlpUseCase],
+        [UPDATE_FLP_TASK_ID, UpdateFlpUseCase],
+        [DELETE_FLP_TASK_ID, DeleteFlpUseCase]
+    ] as const)(
+        "logs %s execution failures and retains the error response",
+        async (taskDefinition, useCase) => {
+            const context = await handler();
+            const created = await context.container.resolve(CreateFolderUseCase).execute({
+                title: "Folder",
+                slug: `task-${taskDefinition.toLowerCase()}`,
+                type: "logging",
+                parentId: null
+            });
+            const folder = created.value;
+            const error = new Error("Storage unavailable");
+            vi.spyOn(useCase.prototype, "execute").mockRejectedValue(error);
+            const logger = vi.spyOn(LoggerImpl.prototype, "error").mockImplementation(() => {});
+
+            const definition = context.container
+                .resolveAll(TaskDefinition)
+                .find(candidate => candidate.id === taskDefinition)!;
+            const task = context.container.resolveImplementation(definition.handler);
+            const result = await task.run({
+                input: { folder },
+                definition,
+                controller: {
+                    runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                    response: { error: (error: unknown) => ({ status: "error", error }) }
+                }
+            } as never);
+
+            expect(result).toEqual({ status: "error", error });
+            expect(logger).toHaveBeenCalledWith(
+                expect.objectContaining({
+                    err: error,
+                    folderId: folder.id,
+                    folderType: folder.type,
+                    taskDefinition
+                }),
+                expect.stringContaining("task failed")
+            );
+        }
+    );
+});
