+import { describe, expect, it } from "vitest";
+import { EventPublisher } from "@webiny/api-core/features/eventPublisher/index.js";
+import { RoleAfterUpdateEvent } from "@webiny/api-core/features/security/roles/UpdateRole/events.js";
+import type { Role } from "@webiny/api-core/types/security.js";
+import { FileAfterCreateEvent } from "@webiny/api-file-manager/features/file/CreateFile/events.js";
+import type { File } from "@webiny/api-file-manager/domain/file/types.js";
+import { EntryAfterCreateEvent } from "@webiny/api-headless-cms/features/contentEntry/CreateEntry/events.js";
+import { EntryAfterUpdateEvent } from "@webiny/api-headless-cms/features/contentEntry/UpdateEntry/events.js";
+import type { CmsEntry, CmsModel } from "@webiny/api-headless-cms/types/index.js";
+import { useHandler } from "./helpers/useHandler.js";
+
+describe("audit log event subscriptions", () => {
+    it("records content, file and role events and exposes them through GraphQL", async () => {
+        const { handler, invoke, identity } = useHandler({ permissions: [] });
+        const context = await handler();
+        const publisher = context.container.resolve(EventPublisher);
+
+        const model = { modelId: "article", isPrivate: false } as CmsModel;
+        const entry = {
+            id: "entry#0001",
+            entryId: "entry",
+            values: { title: "First" }
+        } as CmsEntry;
+        const updated = { ...entry, values: { title: "Updated" } };
+        await publisher.publish(
+            new EntryAfterCreateEvent({ model, entry, input: { values: entry.values } })
+        );
+        await publisher.publish(
+            new EntryAfterUpdateEvent({
+                model,
+                entry: updated,
+                original: entry,
+                input: { values: updated.values }
+            })
+        );
+        await publisher.publish(
+            new EntryAfterCreateEvent({
+                model: { ...model, isPrivate: true },
+                entry,
+                input: { values: entry.values }
+            })
+        );
+
+        const file: File = {
+            id: "file-1",
+            key: "file-1/image.png",
+            size: 10,
+            type: "image/png",
+            name: "image.png",
+            metadata: {},
+            location: { folderId: "root" },
+            tags: [],
+            description: "",
+            createdOn: "2026-01-01T00:00:00.000Z",
+            modifiedOn: undefined,
+            savedOn: "2026-01-01T00:00:00.000Z",
+            createdBy: { id: "user", displayName: "User", type: "admin" },
+            modifiedBy: undefined,
+            savedBy: { id: "user", displayName: "User", type: "admin" }
+        };
+        await publisher.publish(new FileAfterCreateEvent({ file }));
+
+        const original: Role = {
+            id: "role-1",
+            name: "Editor",
+            slug: "editor",
+            description: "",
+            system: false,
+            permissions: [],
+            createdOn: null,
+            createdBy: null
+        };
+        const role = { ...original, name: "Senior editor" };
+        await publisher.publish(
+            new RoleAfterUpdateEvent({ original, updated: role, input: { name: role.name } })
+        );
+
+        const [response] = await invoke({
+            body: {
+                query: `query {
+                    auditLogs {
+                        listAuditLogs(where: {}) {
+                            data { id app entity action entityId createdBy { id } }
+                            error { message }
+                        }
+                    }
+                }`
+            }
+        });
+        expect(response.errors).toBeUndefined();
+        const list = response.data.auditLogs.listAuditLogs;
+        expect(list.error).toBeNull();
+        expect(list.data).toHaveLength(4);
+        expect(list.data).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY",
+                    action: "CREATE",
+                    entityId: "entry",
+                    createdBy: { id: identity?.id }
+                }),
+                expect.objectContaining({
+                    app: "HEADLESS_CMS",
+                    entity: "ENTRY_REVISION",
+                    action: "UPDATE",
+                    entityId: "entry#0001"
+                }),
+                expect.objectContaining({
+                    app: "FILE_MANAGER",
+                    entity: "FILE",
+                    action: "CREATE",
+                    entityId: file.id
+                }),
+                expect.objectContaining({
+                    app: "SECURITY",
+                    entity: "ROLE",
+                    action: "UPDATE",
+                    entityId: role.id
+                })
+            ])
+        );
+
+        const [getResponse] = await useHandler().invoke({
+            body: {
+                query: `query ($id: ID!) {
+                    auditLogs { getAuditLog(id: $id) { data { id entityId } error { message } } }
+                }`,
+                variables: { id: list.data[0].id }
+            }
+        });
+        expect(getResponse.errors).toBeUndefined();
+        expect(getResponse.data.auditLogs.getAuditLog).toEqual({
+            data: { id: list.data[0].id, entityId: list.data[0].entityId },
+            error: null
+        });
+    });
+});
