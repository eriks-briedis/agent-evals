+++ b/packages/api-aco/__tests__/flp.logging.test.ts
@@ -0,0 +1,192 @@
+import { describe, expect, it, vi } from "vitest";
+import type { Container } from "@webiny/di";
+import { BaseError, Result } from "@webiny/feature/api";
+import { Logger } from "@webiny/api-core/features/logger/index.js";
+import { TaskDefinition } from "@webiny/api-core/features/task/TaskDefinition/index.js";
+import { TaskService } from "@webiny/api-core/features/task/TaskService/index.js";
+import { useHandler } from "~tests/utils/useHandler";
+import { CreateFolderUseCase } from "~/features/folder/CreateFolder/index.js";
+import { UpdateFolderUseCase } from "~/features/folder/UpdateFolder/index.js";
+import { DeleteFolderUseCase } from "~/features/folder/DeleteFolder/index.js";
+import { CreateFlpUseCase } from "~/features/flp/CreateFlp/index.js";
+import { UpdateFlpUseCase } from "~/features/flp/UpdateFlp/index.js";
+import { DeleteFlpUseCase } from "~/features/flp/DeleteFlp/index.js";
+import { CreateFlpOnFolderCreatedHandler } from "~/features/flp/CreateFlpOnFolderCreated/CreateFlpOnFolderCreatedHandler.js";
+import { UpdateFlpOnFolderUpdatedHandler } from "~/features/flp/UpdateFlpOnFolderUpdated/UpdateFlpOnFolderUpdatedHandler.js";
+import { DeleteFlpOnFolderDeletedHandler } from "~/features/flp/DeleteFlpOnFolderDeleted/DeleteFlpOnFolderDeletedHandler.js";
+import { FolderAfterCreateEvent } from "~/features/folder/CreateFolder/events.js";
+import { FolderAfterUpdateEvent } from "~/features/folder/UpdateFolder/events.js";
+import { FolderAfterDeleteEvent } from "~/features/folder/DeleteFolder/events.js";
+import { CREATE_FLP_TASK_ID, UPDATE_FLP_TASK_ID, DELETE_FLP_TASK_ID } from "~/flp/tasks/index.js";
+import type { Folder } from "~/folder/folder.types.js";
+
+class TriggerError extends BaseError {
+    readonly code = "TRIGGER_FAILED";
+    constructor() {
+        super({ message: "Task service failed" });
+    }
+}
+
+describe("FLP failure logging", () => {
+    const { handler } = useHandler();
+
+    const scenarios = [
+        {
+            id: CREATE_FLP_TASK_ID,
+            handle: (container: Container, folder: Folder) =>
+                container
+                    .resolveImplementation(CreateFlpOnFolderCreatedHandler)
+                    .handle(new FolderAfterCreateEvent({ folder })),
+            failUseCase: (container: Container, error: Error) =>
+                container.registerInstance(CreateFlpUseCase, {
+                    execute: vi.fn().mockRejectedValue(error)
+                })
+        },
+        {
+            id: UPDATE_FLP_TASK_ID,
+            handle: (container: Container, folder: Folder) =>
+                container
+                    .resolveImplementation(UpdateFlpOnFolderUpdatedHandler)
+                    .handle(new FolderAfterUpdateEvent({ folder, original: folder, input: {} })),
+            failUseCase: (container: Container, error: Error) =>
+                container.registerInstance(UpdateFlpUseCase, {
+                    execute: vi.fn().mockRejectedValue(error)
+                })
+        },
+        {
+            id: DELETE_FLP_TASK_ID,
+            handle: (container: Container, folder: Folder) =>
+                container
+                    .resolveImplementation(DeleteFlpOnFolderDeletedHandler)
+                    .handle(new FolderAfterDeleteEvent({ folder })),
+            failUseCase: (container: Container, error: Error) =>
+                container.registerInstance(DeleteFlpUseCase, {
+                    execute: vi.fn().mockRejectedValue(error)
+                })
+        }
+    ];
+
+    for (const scenario of scenarios) {
+        for (const failure of ["result", "throw"] as const) {
+            it(`logs a ${failure} failure triggering ${scenario.id} without throwing`, async () => {
+                const context = await handler();
+                const created = await context.container.resolve(CreateFolderUseCase).execute({
+                    title: "Test",
+                    slug: `trigger-${scenario.id.toLowerCase()}-${failure}`,
+                    type: "test",
+                    parentId: null
+                });
+                const folder = created.value;
+                const error = new TriggerError();
+                const tasks = context.container.resolve(TaskService);
+                vi.spyOn(tasks, "trigger").mockImplementation(async () => {
+                    if (failure === "throw") {
+                        throw error;
+                    }
+                    return Result.fail(error);
+                });
+                const logger = context.container.resolve(Logger);
+                const log = vi.spyOn(logger, "error").mockImplementation(() => {});
+                context.container.registerInstance(Logger, logger);
+                await expect(scenario.handle(context.container, folder)).resolves.toBeUndefined();
+                expect(log).toHaveBeenCalledOnce();
+                expect(log).toHaveBeenCalledWith(
+                    {
+                        err: error,
+                        folderId: folder.id,
+                        folderType: folder.type,
+                        taskId: scenario.id
+                    },
+                    expect.any(String)
+                );
+            });
+        }
+
+        it(`logs failures in ${scenario.id} and returns the original task error`, async () => {
+            const context = await handler();
+            const created = await context.container.resolve(CreateFolderUseCase).execute({
+                title: "Test",
+                slug: `task-${scenario.id.toLowerCase()}`,
+                type: "test",
+                parentId: null
+            });
+            const folder = created.value;
+            const error = new Error("FLP write failed");
+            scenario.failUseCase(context.container, error);
+            const logger = context.container.resolve(Logger);
+            const log = vi.spyOn(logger, "error").mockImplementation(() => {});
+            context.container.registerInstance(Logger, logger);
+            const definition = context.container
+                .resolveAll(TaskDefinition)
+                .find(d => d.id === scenario.id)!;
+            const task = context.container.resolveImplementation(definition.handler);
+            const result = await task.run({
+                input: { folder },
+                definition,
+                controller: {
+                    runtime: { isAborted: () => false, isCloseToTimeout: () => false },
+                    response: { error: (error: unknown) => ({ status: "error", error }) }
+                }
+            } as never);
+
+            expect(result).toEqual({ status: "error", error });
+            expect(log).toHaveBeenCalledWith(
+                { err: error, folderId: folder.id, folderType: folder.type, taskId: scenario.id },
+                expect.any(String)
+            );
+        });
+    }
+
+    it("keeps folder changes successful when permission tasks cannot be queued", async () => {
+        const context = await handler();
+        const create = context.container.resolve(CreateFolderUseCase);
+        const existing = await create.execute({
+            title: "Existing",
+            slug: "logging-existing",
+            type: "test",
+            parentId: null
+        });
+        const tasks = context.container.resolve(TaskService);
+        const error = new TriggerError();
+        vi.spyOn(tasks, "trigger").mockResolvedValue(Result.fail(error));
+        const logger = context.container.resolve(Logger);
+        const log = vi.spyOn(logger, "error").mockImplementation(() => {});
+        context.container.registerInstance(Logger, logger);
+
+        const created = await create.execute({
+            title: "New",
+            slug: "logging-new",
+            type: "test",
+            parentId: null
+        });
+        const updated = await context.container
+            .resolve(UpdateFolderUseCase)
+            .execute(existing.value.id, {
+                title: "Updated"
+            });
+        const deleted = await context.container
+            .resolve(DeleteFolderUseCase)
+            .execute(existing.value.id);
+
+        expect(created.isOk()).toBe(true);
+        expect(updated.isOk()).toBe(true);
+        expect(deleted.isOk()).toBe(true);
+        expect(log.mock.calls.map(([details]) => details)).toEqual([
+            expect.objectContaining({
+                err: error,
+                folderId: created.value.id,
+                taskId: CREATE_FLP_TASK_ID
+            }),
+            expect.objectContaining({
+                err: error,
+                folderId: existing.value.id,
+                taskId: UPDATE_FLP_TASK_ID
+            }),
+            expect.objectContaining({
+                err: error,
+                folderId: existing.value.id,
+                taskId: DELETE_FLP_TASK_ID
+            })
+        ]);
+    });
+});
