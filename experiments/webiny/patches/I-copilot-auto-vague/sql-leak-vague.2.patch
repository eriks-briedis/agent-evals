+interface ResettableTableManager {
+    reset(): void;
+}
+
+export const registerSqlTableManager = (manager: ResettableTableManager): void => {
+    const globals = globalThis as { __sqlTableManagers?: ResettableTableManager[] };
+    // Test harnesses opt in so they can reset caches after dropping tables.
+    globals.__sqlTableManagers?.push(manager);
+};
