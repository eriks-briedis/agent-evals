@@ -0,0 +1,72 @@
+import { describe, expect, it } from "vitest";
+import knexLib from "knex";
+import { Container } from "@webiny/feature/api";
+import { KnexClient } from "@webiny/api-core-sql";
+import { EntryTableManager } from "../src/features/entryTableManager/abstractions.js";
+import { EntryTableManagerFeature } from "../src/features/entryTableManager/feature.js";
+import { GroupSchemaManager } from "../src/features/groupSchemaManager/abstractions.js";
+import { GroupSchemaManagerFeature } from "../src/features/groupSchemaManager/feature.js";
+import { ModelSchemaManager } from "../src/features/modelSchemaManager/abstractions.js";
+import { ModelSchemaManagerFeature } from "../src/features/modelSchemaManager/feature.js";
+import { TableNameResolverConfig } from "../src/features/tableNameResolver/abstractions.js";
+import { TableNameResolverFeature } from "../src/features/tableNameResolver/feature.js";
+
+type TestGlobals = typeof globalThis & {
+    __sqlTableManagers?: { reset(): void }[];
+};
+
+describe("CMS SQL table manager registration", () => {
+    it("does not retain request managers globally and supports test resets", async () => {
+        const globals = globalThis as TestGlobals;
+        const previous = globals.__sqlTableManagers;
+        delete globals.__sqlTableManagers;
+        const knex = knexLib({
+            client: "better-sqlite3",
+            connection: { filename: ":memory:" },
+            useNullAsDefault: true
+        });
+        const createManagers = () => {
+            const container = new Container();
+            container.registerInstance(KnexClient, { client: knex });
+            container.registerInstance(TableNameResolverConfig, { sharedTables: false });
+            TableNameResolverFeature.register(container);
+            EntryTableManagerFeature.register(container);
+            GroupSchemaManagerFeature.register(container);
+            ModelSchemaManagerFeature.register(container);
+            return {
+                entry: container.resolve(EntryTableManager),
+                group: container.resolve(GroupSchemaManager),
+                model: container.resolve(ModelSchemaManager)
+            };
+        };
+
+        try {
+            for (let i = 0; i < 50; i++) {
+                createManagers();
+            }
+            expect(globals.__sqlTableManagers).toBeUndefined();
+
+            const registry: { reset(): void }[] = [];
+            globals.__sqlTableManagers = registry;
+            const { entry, group, model } = createManagers();
+            const ensureTables = async () => {
+                await entry.ensureTable();
+                await group.ensure("test_groups");
+                await model.ensure("test_models");
+            };
+            await ensureTables();
+            await knex.schema.dropTable(entry.getTableName());
+            await knex.schema.dropTable("test_groups");
+            await knex.schema.dropTable("test_models");
+            expect(registry).toEqual([entry, group, model]);
+            registry.forEach(manager => manager.reset());
+            await ensureTables();
+            expect(await knex.schema.hasTable(entry.getTableName())).toBe(true);
+            expect(await knex.schema.hasTable("test_groups")).toBe(true);
+            expect(await knex.schema.hasTable("test_models")).toBe(true);
+        } finally {
+            globals.__sqlTableManagers = previous;
+            await knex.destroy();
+        }
+    });
+});
