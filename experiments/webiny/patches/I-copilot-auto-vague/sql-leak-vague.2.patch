@@ -0,0 +1,43 @@
+import { describe, expect, it } from "vitest";
+import knexLib from "knex";
+import { TableManager } from "@webiny/api-core-sql/TableManager.js";
+
+type TestGlobals = typeof globalThis & {
+    __sqlTableManagers?: { reset(): void }[];
+};
+
+describe("SQL table manager registration", () => {
+    it("does not retain managers globally unless a test registry is installed", async () => {
+        const globals = globalThis as TestGlobals;
+        const previous = globals.__sqlTableManagers;
+        delete globals.__sqlTableManagers;
+        const knex = knexLib({
+            client: "better-sqlite3",
+            connection: { filename: ":memory:" },
+            useNullAsDefault: true
+        });
+
+        try {
+            for (let i = 0; i < 50; i++) {
+                new TableManager(knex);
+            }
+            expect(globals.__sqlTableManagers).toBeUndefined();
+
+            const managers: { reset(): void }[] = [];
+            globals.__sqlTableManagers = managers;
+            const manager = new TableManager(knex);
+            const createTable = (table: import("knex").Knex.CreateTableBuilder) => {
+                table.text("id");
+            };
+            await manager.ensure("test_table", createTable);
+            await knex.schema.dropTable("test_table");
+            expect(managers).toEqual([manager]);
+            managers.forEach(item => item.reset());
+            await manager.ensure("test_table", createTable);
+            expect(await knex.schema.hasTable("test_table")).toBe(true);
+        } finally {
+            globals.__sqlTableManagers = previous;
+            await knex.destroy();
+        }
+    });
+});
diff --git a/packages/api-headless-cms-sql/__tests__/tableManagers.test.ts b/packages/api-headless-cms-sql/__tests__/tableManagers.test.ts
